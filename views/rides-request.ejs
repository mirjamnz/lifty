<%- include('partials/header1') %>
<%- include('partials/navbar1') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-lg border-primary">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0"><i class="fas fa-hand-paper me-2"></i>Request a Pickup</h4>
        </div>
        <div class="card-body">
          <form action="/requests/request-ride" method="POST">
            <div class="mb-3">
              <label for="pickup_location" class="form-label">Pickup Location <span class="text-danger">*</span></label>
              <input name="pickup_location" id="pickup_location" type="text" class="form-control autocomplete" data-type="organization" placeholder="e.g. Home, Club, Event" required autocomplete="off">
              <div class="form-text">Where should the driver pick up your child?</div>
            </div>
            <div class="mb-3">
              <label for="dropoff_location" class="form-label">Dropoff Location <span class="text-danger">*</span></label>
              <input name="dropoff_location" id="dropoff_location" type="text" class="form-control autocomplete" data-type="organization" placeholder="e.g. School, Event" required autocomplete="off">
              <div class="form-text">Where should the driver drop off your child?</div>
            </div>
            <div class="mb-3">
              <label for="pickup_time" class="form-label">Pickup Time <span class="text-danger">*</span></label>
              <input type="text" name="pickup_time" id="pickup_time" class="form-control flatpickr-input" placeholder="Select date & time" required autocomplete="off">
              <div class="form-text">When should the driver pick up your child?</div>
            </div>
            <div class="mb-3">
              <label for="child_id" class="form-label">Select Child <span class="text-danger">*</span></label>
              <select name="child_id" id="child_id" class="form-select" required>
                <option disabled selected value="">Select your child</option>
                <% if (children && children.length > 0) { %>
                  <% children.forEach(child => { %>
                    <option value="<%= child.id %>"><%= child.name %> – <%= child.school %></option>
                  <% }) %>
                <% } %>
              </select>
              <div class="form-text">Choose which child needs a ride.</div>
            </div>
            <div class="mb-3">
              <label for="note" class="form-label">Notes (optional)</label>
              <textarea name="note" id="note" class="form-control" placeholder="Any special instructions or requirements?"></textarea>
            </div>
            <div class="mb-3">
              <label for="requirements" class="form-label">Special Requirements (optional)</label>
              <input type="text" name="requirements" id="requirements" class="form-control" placeholder="e.g. Booster seat, allergy info">
            </div>
            <div class="d-grid">
              <button class="btn btn-primary btn-lg" type="submit">Request Pickup</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tarekraafat/autocomplete.js@10.2.7/dist/css/autoComplete.min.css">
<script src="https://cdn.jsdelivr.net/npm/@tarekraafat/autocomplete.js@10.2.7/dist/autoComplete.min.js"></script>
<style>
.autoComplete_highlighted {
  background-color: #e3f0ff !important;
  color: #222 !important;
}
input.form-control.autocomplete:focus, input.form-control.autocomplete:active, input.form-control.autocomplete.filled {
  background-color: #e3f0ff !important;
  color: #222 !important;
}
</style>
<script>
document.addEventListener('DOMContentLoaded', function() {
  flatpickr("#pickup_time", {
    enableTime: true,
    dateFormat: "Y-m-d H:i",
    minDate: "today"
  });

  document.querySelectorAll('.autocomplete').forEach(input => {
    const type = input.dataset.type || 'organization';
    const userHome = "<%= user && user.home_address ? user.home_address.replace(/\"/g, '&quot;') : '' %>";
    new autoComplete({
      selector: () => input,
      threshold: 1,
      debounce: 200,
      searchEngine: "loose",
      data: {
        src: async (query) => {
          let results = [];
          if (query.trim().toLowerCase() === 'home' && userHome) {
            results.push({ label: `🏠 Home Address (${userHome})`, value: userHome });
          }
          try {
            const res = await fetch(`/organizations/autocomplete?term=${encodeURIComponent(query)}&type=${encodeURIComponent(type)}`);
            const orgs = await res.json();
            results = results.concat(orgs);
          } catch (err) {
            console.error("Autocomplete fetch error", err);
          }
          return results;
        },
        keys: ["label"]
      },
      resultsList: {
        noResults: true,
        maxResults: 10,
        render: true
      },
      resultItem: {
        highlight: true,
        content: (data) => data.label
      },
      onSelection: (feedback) => {
        const selected = feedback.selection.value;
        input.value = selected.value || selected.label || "";
        input.classList.add('filled');
        input.dispatchEvent(new Event('input', { bubbles: true }));
      },
      events: {
        input: {
          selection: (event) => {
            const feedback = event.detail;
            const selected = feedback.selection.value;
            event.target.value = selected.value || selected.label || "";
            event.target.classList.add('filled');
            event.target.dispatchEvent(new Event('input', { bubbles: true }));
          }
        }
      }
    });
  });
});
</script>
<%- include('partials/footer1') %> 