<!--views/messages-inbox.ejs -->
<%- include('partials/header1') %>
<%- include('partials/navbar1') %>

<div class="container py-5">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📬 Messages</h2>
        <a href="/rides" class="btn btn-outline-primary">
          <i class="fas fa-arrow-left me-2"></i>Back to Rides
        </a>
      </div>

      <!-- Group Invitations Section -->
      <% if (groupInvitations && groupInvitations.length > 0) { %>
        <div class="card mb-4 border-warning">
          <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
              <i class="fas fa-envelope me-2"></i>
              Group Invitations (<%= groupInvitations.length %>)
            </h5>
          </div>
          <div class="card-body">
            <% groupInvitations.forEach(invitation => { %>
              <div class="card mb-3 border-warning">
                <div class="card-body">
                  <h6 class="card-title">
                    <i class="fas fa-users me-2"></i>
                    <%= invitation.event_name %>
                  </h6>
                  <p class="card-text">
                    <small class="text-muted">
                      <i class="fas fa-calendar me-1"></i>
                      <%= invitation.day_of_week %>s, <%= invitation.start_time %> - <%= invitation.end_time %>
                    </small>
                    <br>
                    <small class="text-muted">
                      <i class="fas fa-map-marker-alt me-1"></i>
                      <%= invitation.location %>
                    </small>
                    <br>
                    <small class="text-muted">
                      <i class="fas fa-user me-1"></i>
                      Invited by <%= invitation.inviter_name %>
                    </small>
                    <br>
                    <small class="text-muted">
                      <i class="fas fa-clock me-1"></i>
                      Invited <%= new Date(invitation.invited_at).toLocaleDateString() %>
                    </small>
                  </p>
                  <div class="d-flex gap-2">
                    <form method="POST" action="/recurring-events/<%= invitation.event_id %>/join" style="display: inline;">
                      <button type="submit" class="btn btn-success btn-sm">
                        <i class="fas fa-check me-1"></i>Accept Invitation
                      </button>
                    </form>
                    <form method="POST" action="/recurring-events/<%= invitation.event_id %>/decline-invitation" style="display: inline;">
                      <input type="hidden" name="invitation_id" value="<%= invitation.id %>">
                      <button type="submit" class="btn btn-outline-danger btn-sm" 
                              onclick="return confirm('Are you sure you want to decline this invitation?')">
                        <i class="fas fa-times me-1"></i>Decline
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (!messages || messages.length === 0) { %>
        <div class="alert alert-info text-center" role="alert">
          <i class="fas fa-inbox fa-2x mb-3"></i>
          <h5>No messages yet</h5>
          <p class="mb-0">When you receive messages about ride requests or offers, they'll appear here.</p>
        </div>
      <% } else { %>
        <div class="card">
          <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
              <i class="fas fa-envelope me-2"></i>
              Inbox (<%= messages.length %> message<%= messages.length !== 1 ? 's' : '' %>)
            </h5>
          </div>
          <div class="list-group list-group-flush">
            <% messages.forEach(message => { %>
              <div class="list-group-item message-item <%= !message.read_at ? 'unread' : '' %>" 
                   data-message-id="<%= message.id %>">
                <div class="row align-items-center">
                  <div class="col-md-8">
                    <div class="d-flex align-items-center mb-2">
                      <% if (!message.read_at) { %>
                        <span class="badge bg-danger me-2">New</span>
                      <% } %>
                      <h6 class="mb-0">
                        <i class="fas fa-user me-2 text-primary"></i>
                        <% if (message.sender_id !== session.userId) { %>
                          <a href="/messages/thread/<%= message.sender_id %>" class="text-decoration-none text-primary fw-bold">
                            <%= message.sender_name %>
                          </a>
                        <% } else { %>
                          <%= message.sender_name %>
                        <% } %>
                        <% if (message.recipient_id && message.recipient_id !== session.userId) { %>
                          <span class="ms-2">&rarr; 
                            <a href="/messages/thread/<%= message.recipient_id %>" class="text-decoration-none text-primary fw-bold">
                              <%= message.recipient_name || 'Recipient' %>
                            </a>
                          </span>
                        <% } %>
                      </h6>
                    </div>
                    <p class="mb-1 text-muted">
                      <i class="fas fa-clock me-1"></i>
                      <%= new Date(message.sent_at).toLocaleString() %>
                    </p>
                    <p class="mb-0 message-content">
                      <%= message.content %>
                    </p>
                    <% if (message.related_type && message.related_id) { %>
                      <small class="text-info">
                        <i class="fas fa-link me-1"></i>
                        Related to: <%= message.related_type === 'request' ? 'Ride Request' : 
                                       message.related_type === 'group_invitation' ? 'Group Invitation' :
                                       message.related_type === 'group_invitation_accepted' ? 'Group Invitation Accepted' :
                                       message.related_type === 'group_invitation_declined' ? 'Group Invitation Declined' :
                                       'Ride Offer' %> #<%= message.related_id %>
                      </small>
                    <% } %>
                  </div>
                  <div class="col-md-4 text-end">
                    <% if (!message.read_at) { %>
                      <button class="btn btn-sm btn-outline-success mark-read-btn" 
                              data-message-id="<%= message.id %>"
                              onclick="markAsRead(this.dataset.messageId)">
                        <i class="fas fa-check me-1"></i>Mark as Read
                      </button>
                    <% } else { %>
                      <span class="text-muted">
                        <i class="fas fa-check-circle me-1"></i>Read
                      </span>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<style>
.message-item {
  transition: background-color 0.2s ease;
}

.message-item:hover {
  background-color: #f8f9fa;
}

.message-item.unread {
  background-color: #e3f2fd;
  border-left: 4px solid #2196f3;
}

.message-content {
  white-space: pre-wrap;
  word-wrap: break-word;
}

.mark-read-btn {
  transition: all 0.2s ease;
}

.mark-read-btn:hover {
  transform: scale(1.05);
}
</style>

<script>
function markAsRead(messageId) {
  fetch(`/messages/read/${messageId}`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    }
  })
  .then(response => {
    if (response.ok) {
      // Update UI to show message as read
      const messageItem = document.querySelector(`[data-message-id="${messageId}"]`);
      if (messageItem) {
        messageItem.classList.remove('unread');
        const markReadBtn = messageItem.querySelector('.mark-read-btn');
        if (markReadBtn) {
          markReadBtn.innerHTML = '<i class="fas fa-check-circle me-1"></i>Read';
          markReadBtn.classList.remove('btn-outline-success');
          markReadBtn.classList.add('text-muted');
          markReadBtn.disabled = true;
        }
        
        // Remove the "New" badge
        const newBadge = messageItem.querySelector('.badge');
        if (newBadge) {
          newBadge.remove();
        }
      }
    } else {
      console.error('Failed to mark message as read');
    }
  })
  .catch(error => {
    console.error('Error marking message as read:', error);
  });
}

// Auto-refresh messages every 30 seconds for real-time updates
setInterval(() => {
  // You can add AJAX call here to fetch new messages
  // For now, we'll just log that we could refresh
  console.log('Could refresh messages here...');
}, 30000);
</script>

<%- include('partials/footer1') %> 