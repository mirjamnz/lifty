<!--views/rides.ejs -->
<%- include('partials/header1') %>
<%- include('partials/navbar1') %>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">🚗 My Rides, <%= session.userName %>!</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRideModal">
      <i class="fas fa-plus me-2"></i>Quick Create
    </button>
  </div>

  <!-- Success Messages -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <% if (success === 'booking_created') { %>
        <i class="fas fa-check-circle me-2"></i>Ride booking created successfully!
      <% } else if (success === 'booking_cancelled') { %>
        <i class="fas fa-times-circle me-2"></i>Ride booking cancelled successfully!
      <% } else if (success === 'booking_accepted') { %>
        <i class="fas fa-check-circle me-2"></i>Ride booking accepted!
      <% } else if (success === 'booking_rejected') { %>
        <i class="fas fa-times-circle me-2"></i>Ride booking rejected!
      <% } else if (success === 'ride_assigned') { %>
        <i class="fas fa-check-circle me-2"></i>You've successfully helped with this ride! A notification has been sent to the parent.
      <% } %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- My Bookings Section - Moved to top for importance -->
  <% const drivingBookings = myBookings.filter(b => b.booking_type === 'driver'); %>
  <% const childBookings = myBookings.filter(b => b.booking_type === 'passenger'); %>

  <% if (drivingBookings.length > 0 || childBookings.length > 0) { %>
    <div class="card mb-4 border-success">
      <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="fas fa-calendar-check me-2"></i>📋 My Bookings</h5>
      </div>
      <div class="card-body">
        <% if (drivingBookings.length > 0) { %>
          <h6 class="mb-3 text-success"><i class="fas fa-car me-2"></i>🚗 I'm Driving</h6>
          <div class="table-responsive mb-4">
            <table class="table table-hover table-bordered align-middle">
              <thead class="table-light">
                <tr>
                  <th>Child(ren)</th>
                  <th>Route</th>
                  <th>Driver</th>
                  <th>Pickup Time</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% drivingBookings.forEach(booking => { %>
                  <tr class="table-success">
                    <td>
                      <strong><%= booking.child_names %></strong>
                      <% if (booking.child_count > 1) { %>
                        <br><small class="text-muted"><%= booking.child_count %> children</small>
                      <% } %>
                      <br><small class="text-muted">I'm driving</small>
                    </td>
                    <td>
                      <div class="d-flex align-items-center">
                        <i class="fas fa-map-marker-alt text-danger me-1"></i>
                        <% if (booking.ride_type === 'request') { %>
                          <small><%= booking.pickup_location || 'Pickup' %></small>
                        <% } else { %>
                          <small>Home</small>
                        <% } %>
                        <i class="fas fa-arrow-right mx-2 text-muted"></i>
                        <i class="fas fa-flag-checkered text-success me-1"></i>
                        <small><%= booking.school %></small>
                      </div>
                    </td>
                    <td>
                      <strong><%= booking.driver_name %></strong>
                      <br><small class="text-success">(You)</small>
                    </td>
                    <td><span data-time="<%= booking.pickup_time %>"><%= new Date(booking.pickup_time).toLocaleString() %></span></td>
                    <td>
                      <span class="badge bg-success">Confirmed</span>
                      <br><small class="text-muted">Driver</small>
                    </td>
                    <td>
                      <% if (booking.ride_type === 'request') { %>
                        <a href="/messages/group/ride/<%= booking.id %>" class="btn btn-sm btn-outline-info">
                          <i class="fas fa-comments me-1"></i>Chat
                        </a>
                      <% } else { %>
                        <span class="text-muted">Driver commitment</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
        <% if (childBookings.length > 0) { %>
          <h6 class="mb-3 text-primary"><i class="fas fa-child me-2"></i>🧒 My Kids' Rides</h6>
          <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
              <thead class="table-light">
                <tr>
                  <th>Child(ren)</th>
                  <th>Route</th>
                  <th>Driver</th>
                  <th>Pickup Time</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% childBookings.forEach(booking => { %>
                  <tr class="table-primary">
                    <td>
                      <strong><%= booking.child_names %></strong>
                      <% if (booking.child_count > 1) { %>
                        <br><small class="text-muted"><%= booking.child_count %> children</small>
                      <% } %>
                      <br><small class="text-muted">My children</small>
                    </td>
                    <td>
                      <div class="d-flex align-items-center">
                        <i class="fas fa-map-marker-alt text-danger me-1"></i>
                        <% if (booking.ride_type === 'request') { %>
                          <small><%= booking.pickup_location || 'Pickup' %></small>
                        <% } else { %>
                          <small>Home</small>
                        <% } %>
                        <i class="fas fa-arrow-right mx-2 text-muted"></i>
                        <i class="fas fa-flag-checkered text-success me-1"></i>
                        <small><%= booking.school %></small>
                      </div>
                    </td>
                    <td>
                      <strong><%= booking.driver_name %></strong>
                    </td>
                    <td><span data-time="<%= booking.pickup_time %>"><%= new Date(booking.pickup_time).toLocaleString() %></span></td>
                    <td>
                      <span class="badge bg-success">Confirmed</span>
                    </td>
                    <td>
                      <% if (booking.ride_type === 'offer') { %>
                        <form action="/rides/cancel-booking/<%= booking.id %>" method="POST" onsubmit="return confirm('Are you sure you want to cancel this booking?')" style="display: inline;">
                          <button class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                      <% } else if (booking.ride_type === 'request') { %>
                        <% if (booking.status !== 'completed') { %>
                          <form action="/rides/cancel-booking/<%= booking.id %>" method="POST" onsubmit="return confirm('Are you sure you want to cancel this booking?')" style="display: inline;">
                            <button class="btn btn-sm btn-outline-danger">Cancel</button>
                          </form>
                        <% } %>
                        <a href="/messages/group/ride/<%= booking.id %>" class="btn btn-sm btn-outline-info">
                          <i class="fas fa-comments me-1"></i>Chat
                        </a>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (myKidsGroupAssignments && myKidsGroupAssignments.length > 0) { %>
    <div class="card mb-4 border-primary">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-users me-2"></i>🧒 My Kids' Group Rides</h5>
        <form method="get" action="/rides" class="d-flex align-items-center gap-2 mb-0">
          <label for="range" class="form-label mb-0 me-2">Show:</label>
          <select name="range" id="range" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="7" <%= range == '7' ? 'selected' : '' %>>Next 7 days</option>
            <option value="30" <%= range == '30' ? 'selected' : '' %>>This Month (30 days)</option>
            <option value="60" <%= range == '60' ? 'selected' : '' %>>Next 60 days</option>
          </select>
        </form>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
              <tr>
                <th>Event</th>
                <th>Child</th>
                <th>Type</th>
                <th>Date</th>
                <th>Driver</th>
                <th>Location</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% myKidsGroupAssignments.forEach(a => { %>
                <tr>
                  <td><strong><%= a.event_name %></strong></td>
                  <td><%= a.child_name %></td>
                  <td>
                    <span class="badge bg-<%= a.assignment_type === 'dropoff' ? 'primary' : 'success' %>">
                      <i class="fas fa-<%= a.assignment_type === 'dropoff' ? 'sign-in-alt' : 'sign-out-alt' %> me-1"></i>
                      <%= a.assignment_type.charAt(0).toUpperCase() + a.assignment_type.slice(1) %>
                    </span>
                  </td>
                  <td><%= new Date(a.event_date).toLocaleDateString() %></td>
                  <td><strong><%= a.driver_name %></strong></td>
                  <td><%= a.location %></td>
                  <td>
                    <span class="badge bg-<%= a.status === 'confirmed' ? 'success' : a.status === 'pending' ? 'warning text-dark' : a.status === 'completed' ? 'info' : 'secondary' %>">
                      <%= a.status.charAt(0).toUpperCase() + a.status.slice(1) %>
                    </span>
                  </td>
                  <td>
                    <% if (a.status === 'confirmed') { %>
                      <a href="/recurring-events/<%= a.event_id %>/group" class="btn btn-sm btn-outline-info" target="_blank">
                        <i class="fas fa-comments me-1"></i>Group Chat
                      </a>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Next Upcoming Recurring Event Rides -->
  <% if (recurringAssignments && recurringAssignments.length > 0) { %>
    <div class="card mb-4 border-info">
      <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>🗓️ Upcoming Recurring Event Rides</h5>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
              <tr>
                <th>Event</th>
                <th>Child</th>
                <th>Type</th>
                <th>Date</th>
                <th>Assigned To</th>
                <th>Location</th>
                <th>Status</th>
                <th>Notes</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% recurringAssignments.forEach(a => { %>
                <tr class="<%= a.group_assignment ? 'table-info' : '' %>" 
                    data-assignment-id="<%= a.id %>" 
                    data-event-id="<%= a.event_id %>">
                  <td>
                    <strong><%= a.event_name %></strong>
                    <br><small class="text-muted"><%= a.day_of_week %>s, <%= a.start_time %>-<%= a.end_time %></small>
                    <% if (a.group_assignment) { %>
                      <br><span class="badge bg-info text-white">Group Event</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (a.is_consolidated && a.child_count > 1) { %>
                      <strong><%= a.child_name %></strong>
                      <br><small class="text-muted"><%= a.child_count %> children</small>
                      <br><span class="badge bg-info text-white">Group Drive</span>
                    <% } else { %>
                      <%= a.child_name %>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge bg-<%= a.assignment_type === 'dropoff' ? 'primary' : 'success' %>">
                      <i class="fas fa-<%= a.assignment_type === 'dropoff' ? 'sign-in-alt' : 'sign-out-alt' %> me-1"></i>
                      <%= a.assignment_type.charAt(0).toUpperCase() + a.assignment_type.slice(1) %>
                    </span>
                  </td>
                  <td><span data-time="<%= a.event_date %>"><%= new Date(a.event_date).toLocaleDateString() %></span></td>
                  <td><%= a.assigned_parent_name %></td>
                  <td><%= a.location %></td>
                  <td>
                    <span class="badge bg-<%= a.status === 'confirmed' ? 'success' : a.status === 'pending' ? 'warning text-dark' : a.status === 'completed' ? 'info' : 'secondary' %>">
                      <%= a.status.charAt(0).toUpperCase() + a.status.slice(1) %>
                    </span>
                  </td>
                  <td><%= a.notes || '—' %></td>
                  <td>
                    <% if (a.group_assignment || a.is_consolidated || a.user_id === session.userId) { %>
                      <a href="/recurring-event-groups/<%= a.event_id %>" class="btn btn-sm btn-outline-info">
                        <i class="fas fa-users me-1"></i>Group
                      </a>
                    <% } %>
                    <% if (a.user_id === session.userId || a.child_parent_id === session.userId) { %>
                      <button class="btn btn-sm btn-outline-danger" 
                              onclick="showCancelAssignmentModal('<%= a.id %>', '<%= a.child_name %>', '<%= a.event_date %>')">
                        <i class="fas fa-times me-1"></i>Cancel
                      </button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Admin Group Assignments Section -->
  <% if (adminGroupAssignments && adminGroupAssignments.length > 0) { %>
    <div class="card mb-4 border-warning">
      <div class="card-header bg-warning text-dark">
        <h5 class="mb-0"><i class="fas fa-user-shield me-2"></i>👑 Group Admin View: All Assignments for Your Groups</h5>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
              <tr>
                <th>Event</th>
                <th>Child</th>
                <th>Type</th>
                <th>Date</th>
                <th>Assigned Parent/Driver</th>
                <th>Location</th>
                <th>Status</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              <% adminGroupAssignments.forEach(a => { %>
                <tr class="<%= a.group_assignment ? 'table-warning' : '' %>">
                  <td><strong><%= a.event_name %></strong></td>
                  <td><%= a.child_name %></td>
                  <td>
                    <span class="badge bg-<%= a.assignment_type === 'dropoff' ? 'primary' : 'success' %>">
                      <i class="fas fa-<%= a.assignment_type === 'dropoff' ? 'sign-in-alt' : 'sign-out-alt' %> me-1"></i>
                      <%= a.assignment_type.charAt(0).toUpperCase() + a.assignment_type.slice(1) %>
                    </span>
                  </td>
                  <td><%= new Date(a.event_date).toLocaleDateString() %></td>
                  <td><%= a.assigned_parent_name %></td>
                  <td><%= a.location %></td>
                  <td>
                    <span class="badge bg-<%= a.status === 'confirmed' ? 'success' : a.status === 'pending' ? 'warning text-dark' : a.status === 'completed' ? 'info' : 'secondary' %>">
                      <%= a.status.charAt(0).toUpperCase() + a.status.slice(1) %>
                    </span>
                  </td>
                  <td><%= a.notes || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Not Yet Assigned / Action Needed Section -->
  <% if (unassignedGroupInstances && unassignedGroupInstances.length > 0) { %>
    <div class="card mb-4 border-warning">
      <div class="card-header bg-warning text-dark">
        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Not Yet Assigned / Action Needed</h5>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
              <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Time</th>
                <th>Location</th>
                <th>Current Driver</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% unassignedGroupInstances.forEach(instance => { %>
                <tr>
                  <td><strong><%= instance.event_name %></strong></td>
                  <td><%= new Date(instance.event_date).toLocaleDateString() %></td>
                  <td><%= instance.start_time %> - <%= instance.end_time %></td>
                  <td><%= instance.location %></td>
                  <td>
                    <% if (instance.driver_name) { %>
                      <span class="text-danger"><%= instance.driver_name %></span>
                    <% } else { %>
                      <span class="text-warning">Not assigned</span>
                    <% } %>
                  </td>
                  <td>
                    <form method="POST" action="/event-instances/<%= instance.id %>/assign-self-driver" style="display:inline;">
                      <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-car me-1"></i>Assign Myself as Driver
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Current Listings Section -->
  <div class="card mb-4 border-success">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0">📋 Current Listings</h5>
      <div class="d-flex align-items-center gap-3">
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="toggleView" onchange="toggleViewMode()">
          <label class="form-check-label text-white" for="toggleView">🗋️ Card View</label>
        </div>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="checkbox" id="seekingOnly" onchange="applyFilters()">
          <label class="form-check-label text-white" for="seekingOnly">👃 Seeking Drivers Only</label>
        </div>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="checkbox" id="hideExpired" onchange="applyFilters()" checked>
          <label class="form-check-label text-white" for="hideExpired">✅ Hide Expired</label>
        </div>
      </div>
    </div>
    <div class="card-body">
      <!-- Search -->
      <div class="input-group mb-4">
        <span class="input-group-text">🔎</span>
        <input type="text" id="rideSearch" class="form-control" placeholder="Search ride offers or requests...">
      </div>

      <!-- Active Offers Table -->
      <% const activeOffers = rideOffers.filter(offer => new Date(offer.pickup_time) > new Date()); %>
      <% if (activeOffers.length > 0) { %>
        <h6 class="text-success mb-3">🚘 Active Ride Offers</h6>
        <table class="table table-hover ride-table mb-4" id="activeOffersTable">
          <thead class="table-light">
            <tr><th>Driver</th><th>School</th><th>Pickup</th><th>Available Seats</th><th>Notes</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% activeOffers.forEach(offer => { %>
              <tr data-seats="<%= offer.remaining_seats %>" data-type="offer" data-expired="false">
                <td><strong><%= offer.driver_name %></strong></td>
                <td><%= offer.school %></td>
                <td><span data-time="<%= offer.pickup_time %>"><%= new Date(offer.pickup_time).toLocaleString() %></span></td>
                <td>
                  <span class="badge bg-<%= offer.remaining_seats > 0 ? 'success' : 'danger' %>">
                    <%= offer.remaining_seats %> / <%= offer.available_seats %>
                  </span>
                </td>
                <td><%= offer.notes || '—' %></td>
                <td>
                  <% if (offer.user_id === session.userId) { %>
                    <!-- Driver actions -->
                    <form action="/rides/cancel-offer/<%= offer.id %>" method="POST" onsubmit="return confirm('Are you sure you want to cancel this offer?')" style="display: inline;">
                      <button class="btn btn-sm btn-outline-danger">Cancel Offer</button>
                    </form>
                    <button class="btn btn-sm btn-outline-info" data-offer-id="<%= offer.id %>" onclick="showBookings(this.dataset.offerId)">View Bookings</button>
                  <% } else if (offer.remaining_seats > 0) { %>
                    <!-- Passenger actions -->
                    <button class="btn btn-sm btn-outline-success" 
                            data-offer-id="<%= offer.id %>" 
                            data-driver-name="<%= offer.driver_name %>" 
                            data-destination="<%= offer.school %>" 
                            data-available-seats="<%= offer.remaining_seats %>"
                            onclick="showBookingModal(this.dataset.offerId, this.dataset.driverName, this.dataset.destination, this.dataset.availableSeats)">
                      Book Ride
                    </button>
                  <% } else { %>
                    <span class="text-muted">Full</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

      <!-- Active Requests Table -->
      <% const activeRequests = requests.filter(request => new Date(request.pickup_time) > new Date()); %>
      <% if (activeRequests.length > 0) { %>
        <h6 class="text-success mb-3">📣 Active Ride Requests</h6>
        <table class="table table-striped ride-table" id="activeRequestsTable">
          <thead class="table-light">
            <tr><th>Child</th><th>Pickup</th><th>Dropoff</th><th>Note</th><th>Time</th><th>Status</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% activeRequests.forEach(request => { %>
              <tr data-assigned="<%= request.assigned_user_id ? 'yes' : 'no' %>" data-type="request" data-expired="false">
                <td><%= request.child_name %><br><small class="text-muted">by <%= request.user_name %></small></td>
                <td><%= request.pickup_location %></td>
                <td><%= request.dropoff_location || '—' %></td>
                <td><%= request.note || '—' %></td>
                <td><span data-time="<%= request.pickup_time %>"><%= new Date(request.pickup_time).toLocaleString() %></span></td>
                <td>
                  <% if (request.status === 'completed') { %>
                    <span class="badge bg-success">Completed</span>
                  <% } else if (!request.assigned_user_id) { %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% } else { %>
                    <span class="badge bg-primary">Assigned</span><br><small><%= request.assigned_driver_name %></small>
                  <% } %>
                </td>
                <td class="d-flex gap-1">
                  <% if (request.status !== 'completed') { %>
                    <% if (!request.assigned_user_id && request.user_id !== session.userId) { %>
                      <form action="/requests/assign-request/<%= request.id %>" method="POST" onsubmit="return confirmHelp('<%= request.child_name %>', '<%= request.user_name %>', '<%= request.pickup_location %>', '<%= request.dropoff_location %>', '<%= request.pickup_time %>');">
                        <button class="btn btn-sm btn-outline-success">Help</button>
                      </form>
                    <% } %>
                    <% if (request.user_id === session.userId) { %>
                      <form action="/requests/cancel-request/<%= request.id %>" method="POST" onsubmit="return confirm('Are you sure you want to cancel this ride request?');">
                        <button class="btn btn-sm btn-outline-danger">Cancel</button>
                      </form>
                    <% } %>
                    <a href="/messages/group/ride/<%= request.id %>" class="btn btn-sm btn-outline-info">
                      <i class="fas fa-comments me-1"></i>Chat
                    </a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

      <!-- No Active Listings Message -->
      <% if (activeOffers.length === 0 && activeRequests.length === 0) { %>
        <div class="alert alert-info text-center" role="alert">
          <i class="fas fa-info-circle me-2"></i>
          No active ride listings found. Create a new offer or request above!
        </div>
      <% } %>
    </div>
  </div>

  <!-- Expired Listings Section (Collapsible) -->
  <% const expiredOffers = rideOffers.filter(offer => new Date(offer.pickup_time) <= new Date()); %>
  <% const expiredRequests = requests.filter(request => new Date(request.pickup_time) <= new Date()); %>
  <% if (expiredOffers.length > 0 || expiredRequests.length > 0) { %>
    <div class="card mb-4 border-secondary">
      <div class="card-header bg-secondary text-white" data-bs-toggle="collapse" data-bs-target="#expiredListings" style="cursor: pointer;">
        <h5 class="mb-0 d-flex justify-content-between align-items-center">
          <span>⏰ Expired Listings (<%= expiredOffers.length + expiredRequests.length %>)</span>
          <i class="fas fa-chevron-down"></i>
        </h5>
      </div>
      <div class="collapse" id="expiredListings">
        <div class="card-body">
          <!-- Expired Offers -->
          <% if (expiredOffers.length > 0) { %>
            <h6 class="text-muted mb-3">🚘 Expired Ride Offers</h6>
            <table class="table table-hover ride-table mb-4" id="expiredOffersTable">
              <thead class="table-light">
                <tr><th>Driver</th><th>School</th><th>Pickup</th><th>Seats</th><th>Notes</th></tr>
              </thead>
              <tbody>
                <% expiredOffers.forEach(offer => { %>
                  <tr data-seats="<%= offer.remaining_seats %>" data-type="offer" data-expired="true">
                    <td><strong><%= offer.driver_name %></strong></td>
                    <td><%= offer.school %></td>
                    <td><span data-time="<%= offer.pickup_time %>"><%= new Date(offer.pickup_time).toLocaleString() %></span></td>
                    <td><%= offer.remaining_seats %> / <%= offer.available_seats %></td>
                    <td><%= offer.notes || '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>

          <!-- Expired Requests -->
          <% if (expiredRequests.length > 0) { %>
            <h6 class="text-muted mb-3">📣 Expired Ride Requests</h6>
            <table class="table table-striped ride-table" id="expiredRequestsTable">
              <thead class="table-light">
                <tr><th>Child</th><th>Pickup</th><th>Dropoff</th><th>Note</th><th>Time</th><th>Status</th></tr>
              </thead>
              <tbody>
                <% expiredRequests.forEach(request => { %>
                  <tr data-assigned="<%= request.assigned_user_id ? 'yes' : 'no' %>" data-type="request" data-expired="true">
                    <td><%= request.child_name %><br><small class="text-muted">by <%= request.user_name %></small></td>
                    <td><%= request.pickup_location %></td>
                    <td><%= request.dropoff_location || '—' %></td>
                    <td><%= request.note || '—' %></td>
                    <td><span data-time="<%= request.pickup_time %>"><%= new Date(request.pickup_time).toLocaleString() %></span></td>
                    <td>
                      <% if (!request.assigned_user_id) { %>
                        <span class="badge bg-secondary">Expired</span>
                      <% } else { %>
                        <span class="badge bg-success">Completed</span><br><small><%= request.assigned_driver_name %></small>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<!-- Booking Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Book Ride</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="bookingForm" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Driver</label>
            <input type="text" class="form-control" id="modalDriver" readonly>
          </div>
          <div class="mb-3">
            <label class="form-label">Destination</label>
            <input type="text" class="form-control" id="modalDestination" readonly>
          </div>
          <div class="mb-3">
            <label class="form-label">Available Seats</label>
            <input type="text" class="form-control" id="modalAvailableSeats" readonly>
          </div>
          <div class="mb-3">
            <label class="form-label">Select Children (Each child = 1 seat)</label>
            <div id="childrenSelection">
              <% children.forEach(child => { %>
                <div class="form-check">
                  <input class="form-check-input child-checkbox" type="checkbox" name="selected_children" value="<%= child.id %>" id="child_<%= child.id %>">
                  <label class="form-check-label" for="child_<%= child.id %>">
                    <%= child.name %> – <%= child.school %>
                  </label>
                </div>
              <% }) %>
            </div>
            <small class="text-muted">Selected: <span id="selectedCount">0</span> children</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Notes (Optional)</label>
            <textarea name="notes" class="form-control" placeholder="Any special requirements..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="bookRideBtn">Book Ride</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Bookings Modal -->
<div class="modal fade" id="bookingsModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Ride Bookings</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="bookingsList">
          <!-- Bookings will be loaded here -->
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Message Modal -->
<div class="modal fade" id="messageModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Send Message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="messageForm" method="POST">
        <div class="modal-body">
          <input type="hidden" name="target_type" id="messageTargetType">
          <input type="hidden" name="target_id" id="messageTargetId">
          <div class="mb-3">
            <label class="form-label">To</label>
            <input type="text" class="form-control" id="messageTo" readonly>
          </div>
          <div class="mb-3">
            <label class="form-label">Message</label>
            <textarea name="message" class="form-control" required></textarea>
          </div>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="include_child" id="includeChildCheckbox">
            <label class="form-check-label" for="includeChildCheckbox">
              Include my child in this conversation (group message)
            </label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Send</button>
        </div>
