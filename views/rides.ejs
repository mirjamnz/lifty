<div id="rideCards" class="d-none flex-wrap gap-3 px-4"></div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tarekraafat/autocomplete.js@10.2.7/dist/css/autoComplete.min.css">
<script src="https://cdn.jsdelivr.net/npm/@tarekraafat/autocomplete.js@10.2.7/dist/autoComplete.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  flatpickr("#offerPickupTime", {
    enableTime: true,
    dateFormat: "Y-m-d\\TH:i",
    minDate: "today",
    defaultDate: new Date()
  });

  flatpickr("#requestPickupTime", {
    enableTime: true,
    dateFormat: "Y-m-d\\TH:i",
    minDate: "today",
    defaultDate: new Date()
  });

  document.querySelectorAll('[data-time]').forEach(el => {
    el.innerText = moment(el.dataset.time).fromNow();
  });

  document.getElementById('rideSearch').addEventListener('input', e => {
    const q = e.target.value.toLowerCase();
    document.querySelectorAll('tbody tr').forEach(row => {
      row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
  });

  document.querySelectorAll('.autocomplete').forEach(input => {
    const type = input.dataset.type || 'organization';

    new autoComplete({
      selector: () => input,
      threshold: 1,
      debounce: 200,
      searchEngine: "loose",
      data: {
        src: async (query) => {
          try {
            const res = await fetch(`/organizations/autocomplete?term=${encodeURIComponent(query)}&type=${encodeURIComponent(type)}`);
            return await res.json();
          } catch (err) {
            console.error("Autocomplete fetch error", err);
            return [];
          }
        },
        keys: ["label"]
      },
      resultsList: {
        noResults: true,
        maxResults: 10,
        render: true
      },
      resultItem: {
        highlight: true,
        content: (data) => data.label
      },
      onSelection: (feedback) => {
        const selected = feedback.selection.value;
        input.value = selected.value || selected.label || "";
        input.dispatchEvent(new Event('input', { bubbles: true }));
      },
      events: {
        input: {
          selection: (event) => {
            const feedback = event.detail;
            const selected = feedback.selection.value;
            event.target.value = selected.value || selected.label || "";
            event.target.dispatchEvent(new Event('input', { bubbles: true }));
          }
        }
      }
    });
  });

  window.toggleViewMode = function () {
    const tables = document.querySelectorAll('.ride-table');
    const cards = document.getElementById('rideCards');
    const isCardView = document.getElementById('toggleView').checked;

    if (isCardView) {
      tables.forEach(table => table.style.display = 'none');
      cards.classList.remove('d-none');
      cards.innerHTML = '';

      document.querySelectorAll('.ride-table tbody tr').forEach(row => {
        const type = row.dataset.type;
        const isSeeking = type === 'request' && row.dataset.assigned === 'no';
        const isExpired = row.dataset.expired === 'true';
        const hideExpired = document.getElementById('hideExpired').checked;
        
        if ((!hideExpired || !isExpired) && (!document.getElementById('seekingOnly').checked || (document.getElementById('seekingOnly').checked && isSeeking))) {
          const card = document.createElement('div');
          card.classList.add('card', 'mb-3', 'shadow-sm');
          if (isExpired) card.classList.add('border-secondary', 'bg-light');
          
          card.innerHTML = `
            <div class="card-body">
              <h5 class="card-title">${type === 'offer' ? '🚘 Offer' : '📣 Request'} ${isExpired ? '<span class="badge bg-secondary">Expired</span>' : ''}</h5>
              <p class="card-text">
                ${type === 'offer' ? `Driver: ${row.cells[0].textContent}` : `Child: ${row.cells[0].textContent}`} <br>
                ${type === 'offer' ? `School: ${row.cells[1].textContent}` : `Pickup: ${row.cells[1].textContent}, Dropoff: ${row.cells[2].textContent}`} <br>
                ${row.cells[3].textContent !== '—' ? `Notes: ${row.cells[3].textContent}` : ''} <br>
                Time: ${row.cells[type === 'offer' ? 2 : 4].textContent}
              </p>
              ${type === 'request' && row.dataset.assigned === 'no' && row.cells[6] && row.cells[6].querySelector('form') ? row.cells[6].innerHTML : ''}
            </div>
          `;
          cards.appendChild(card);
        }
      });
    } else {
      tables.forEach(table => table.style.display = '');
      cards.classList.add('d-none');
    }
    applyFilters();
  }

  window.applyFilters = function () {
    const isSeekingOnly = document.getElementById('seekingOnly').checked;
    const hideExpired = document.getElementById('hideExpired').checked;
    
    document.querySelectorAll('.ride-table tbody tr').forEach(row => {
      const isRequest = row.dataset.type === 'request';
      const isUnassigned = row.dataset.assigned === 'no';
      const isExpired = row.dataset.expired === 'true';
      
      let shouldShow = true;
      
      if (hideExpired && isExpired) {
        shouldShow = false;
      } else if (isSeekingOnly && isRequest && !isUnassigned) {
        shouldShow = false;
      }
      
      row.style.display = shouldShow ? '' : 'none';
    });
    
    if (document.getElementById('toggleView').checked) toggleViewMode();
  }

  window.confirmHelp = function (childName, userName, pickup, dropoff, time) {
    return confirm(`Are you sure you want to help ${childName} (${userName})?\nPickup: ${pickup}\nDropoff: ${dropoff}\nTime: ${new Date(time).toLocaleString()}`);
  }

  window.showBookingModal = function (offerId, driverName, destination, availableSeats) {
    document.getElementById('modalDriver').value = driverName;
    document.getElementById('modalDestination').value = destination;
    document.getElementById('modalAvailableSeats').value = availableSeats;
    document.getElementById('bookingForm').action = `/rides/book-ride/${offerId}`;
    
    // Reset form
    document.querySelectorAll('.child-checkbox').forEach(checkbox => {
      checkbox.checked = false;
    });
    document.getElementById('selectedCount').textContent = '0';
    document.getElementById('bookRideBtn').disabled = true;
    
    const modal = new bootstrap.Modal(document.getElementById('bookingModal'));
    modal.show();
  }

  // Handle child selection
  document.addEventListener('change', function(e) {
    if (e.target.classList.contains('child-checkbox')) {
      const selectedCount = document.querySelectorAll('.child-checkbox:checked').length;
      const availableSeats = parseInt(document.getElementById('modalAvailableSeats').value);
      
      document.getElementById('selectedCount').textContent = selectedCount;
      
      // Enable/disable book button based on selection
      const bookBtn = document.getElementById('bookRideBtn');
      if (selectedCount > 0 && selectedCount <= availableSeats) {
        bookBtn.disabled = false;
        bookBtn.textContent = `Book Ride (${selectedCount} child${selectedCount > 1 ? 'ren' : ''})`;
      } else {
        bookBtn.disabled = true;
        if (selectedCount > availableSeats) {
          bookBtn.textContent = `Too many children (max ${availableSeats})`;
        } else {
          bookBtn.textContent = 'Book Ride';
        }
      }
    }
  });

  // Handle form submission
  document.getElementById('bookingForm').addEventListener('submit', function(e) {
    const selectedChildren = document.querySelectorAll('.child-checkbox:checked');
    const availableSeats = parseInt(document.getElementById('modalAvailableSeats').value);
    
    if (selectedChildren.length === 0) {
      e.preventDefault();
      alert('Please select at least one child.');
      return;
    }
    
    if (selectedChildren.length > availableSeats) {
      e.preventDefault();
      alert(`You can only book ${availableSeats} seat${availableSeats > 1 ? 's' : ''} for ${availableSeats} child${availableSeats > 1 ? 'ren' : ''}.`);
      return;
    }
    
    // Add hidden inputs for each selected child
    selectedChildren.forEach(child => {
      const hiddenInput = document.createElement('input');
      hiddenInput.type = 'hidden';
      hiddenInput.name = 'child_ids[]';
      hiddenInput.value = child.value;
      this.appendChild(hiddenInput);
    });
    
    // Add total seats
    const seatsInput = document.createElement('input');
    seatsInput.type = 'hidden';
    seatsInput.name = 'seats_requested';
    seatsInput.value = selectedChildren.length;
    this.appendChild(seatsInput);
  });

  window.showBookings = function (offerId) {
    // This would load bookings for the specific offer
    // For now, we'll show a placeholder
    document.getElementById('bookingsList').innerHTML = `
      <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>
        Booking management feature coming soon!
      </div>
    `;
    
    const modal = new bootstrap.Modal(document.getElementById('bookingsModal'));
    modal.show();
  }

  window.showMessageModal = function(type, id, toName) {
    document.getElementById('messageTargetType').value = type;
    document.getElementById('messageTargetId').value = id;
    document.getElementById('messageTo').value = toName;
    document.getElementById('messageForm').action = '/messages/send';
    const modal = new bootstrap.Modal(document.getElementById('messageModal'));
    modal.show();
  }

  // Cancel assignment functionality for recurring events
  window.showCancelAssignmentModal = function(assignmentId, childName, eventDate) {
    document.getElementById('cancelAssignmentId').value = assignmentId;
    document.getElementById('cancelChildName').textContent = childName;
    document.getElementById('cancelEventDate').textContent = new Date(eventDate).toLocaleDateString();
    const modal = new bootstrap.Modal(document.getElementById('cancelAssignmentModal'));
    modal.show();
  }
});
</script>

<!-- Cancel Assignment Modal -->
<div class="modal fade" id="cancelAssignmentModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Cancel Recurring Assignment</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="cancelAssignmentForm" method="POST">
        <div class="modal-body">
          <input type="hidden" id="cancelAssignmentId" name="assignment_id">
          <p>Are you sure you want to cancel the assignment for <strong id="cancelChildName"></strong> on <strong id="cancelEventDate"></strong>?</p>
          <div class="mb-3">
            <label for="cancellation_reason" class="form-label">Reason (Optional)</label>
            <textarea class="form-control" id="cancellation_reason" name="cancellation_reason" 
                      placeholder="e.g., Child is sick, family emergency..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep Assignment</button>
          <button type="submit" class="btn btn-danger">Cancel Assignment</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
// Set up cancel assignment form action
document.addEventListener('DOMContentLoaded', function() {
  const cancelForm = document.getElementById('cancelAssignmentForm');
  if (cancelForm) {
    cancelForm.addEventListener('submit', function(e) {
      const assignmentId = document.getElementById('cancelAssignmentId').value;
      // Find the event ID from the assignment row
      const assignmentRow = document.querySelector(`tr[data-assignment-id="${assignmentId}"]`);
      if (assignmentRow) {
        const eventId = assignmentRow.getAttribute('data-event-id');
        this.action = `/recurring-events/${eventId}/cancel-assignment`;
      }
    });
  }
});
</script>

