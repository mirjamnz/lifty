<!--views/short-notice.ejs -->
<%- include('partials/header1') %>
<%- include('partials/navbar1') %>

<div class="container mt-4">
  <!-- Page Header -->
  <div class="row mb-4">
    <div class="col">
      <h2 class="mb-0">
        <i class="fas fa-clock me-2"></i>Short-Notice Ride Requests
      </h2>
      <p class="text-muted">Quickly coordinate rides with trusted parent groups</p>
    </div>
    <div class="col-auto">
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRequestModal">
        <i class="fas fa-plus me-1"></i>New Request
      </button>
    </div>
  </div>

  <!-- Pending Requests Section -->
  <div class="row mb-4">
    <div class="col">
      <div class="card">
        <div class="card-header bg-warning text-dark">
          <h5 class="mb-0">
            <i class="fas fa-exclamation-triangle me-2"></i>Pending Requests (<%= pendingRequests.length %>)
          </h5>
        </div>
        <div class="card-body">
          <% if (pendingRequests.length === 0) { %>
            <div class="text-center py-4">
              <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
              <p class="text-muted">No pending requests at the moment.</p>
            </div>
          <% } else { %>
            <div class="row">
              <% pendingRequests.forEach(request => { %>
                <div class="col-md-6 col-lg-4 mb-3">
                  <div class="card h-100 border-warning">
                    <div class="card-body">
                      <h6 class="card-title">
                        <i class="fas fa-clock me-1"></i><%= request.group_name %>
                      </h6>
                      <p class="card-text text-muted small">
                        From <strong><%= request.requester_name %></strong>
                      </p>
                      <div class="mb-2">
                        <small class="text-muted">
                          <i class="fas fa-calendar me-1"></i>
                          <%= new Date(request.pickup_time).toLocaleDateString() %>
                        </small>
                      </div>
                      <div class="mb-2">
                        <small class="text-muted">
                          <i class="fas fa-map-marker-alt me-1"></i>
                          <%= request.pickup_location %> → <%= request.dropoff_location %>
                        </small>
                      </div>
                      <% if (request.message) { %>
                        <p class="card-text small"><%= request.message %></p>
                      <% } %>
                      <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-warning">
                          <i class="fas fa-users me-1"></i><%= request.response_count %> responses
                        </span>
                        <a href="/short-notice/<%= request.id %>" class="btn btn-primary btn-sm">
                          <i class="fas fa-eye me-1"></i>View Details
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- My Requests Section -->
  <div class="row mb-4">
    <div class="col">
      <div class="card">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0">
            <i class="fas fa-paper-plane me-2"></i>My Requests (<%= myRequests.length %>)
          </h5>
        </div>
        <div class="card-body">
          <% if (myRequests.length === 0) { %>
            <div class="text-center py-4">
              <i class="fas fa-paper-plane fa-3x text-muted mb-3"></i>
              <p class="text-muted">You haven't sent any requests yet.</p>
              <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRequestModal">
                <i class="fas fa-plus me-1"></i>Send Your First Request
              </button>
            </div>
          <% } else { %>
            <div class="row">
              <% myRequests.forEach(request => { %>
                <div class="col-md-6 col-lg-4 mb-3">
                  <div class="card h-100">
                    <div class="card-body">
                      <h6 class="card-title">
                        <i class="fas fa-users me-1"></i><%= request.group_name %>
                      </h6>
                      <div class="mb-2">
                        <small class="text-muted">
                          <i class="fas fa-calendar me-1"></i>
                          <%= new Date(request.pickup_time).toLocaleDateString() %>
                        </small>
                      </div>
                      <div class="mb-2">
                        <small class="text-muted">
                          <i class="fas fa-map-marker-alt me-1"></i>
                          <%= request.pickup_location %> → <%= request.dropoff_location %>
                        </small>
                      </div>
                      <% if (request.message) { %>
                        <p class="card-text small"><%= request.message %></p>
                      <% } %>
                      <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-<%= request.status === 'pending' ? 'warning' : request.status === 'accepted' ? 'success' : 'danger' %>">
                          <%= request.status.charAt(0).toUpperCase() + request.status.slice(1) %>
                        </span>
                        <span class="badge bg-info">
                          <i class="fas fa-users me-1"></i><%= request.response_count %> responses
                        </span>
                        <a href="/short-notice/<%= request.id %>" class="btn btn-outline-primary btn-sm">
                          <i class="fas fa-eye me-1"></i>View
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Create Request Modal -->
<div class="modal fade" id="createRequestModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-plus me-2"></i>Create Short-Notice Request
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/short-notice" method="POST">
        <div class="modal-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="groupSelect" class="form-label">Target Group</label>
              <select class="form-select" id="groupSelect" name="group_id" required>
                <option value="">Select a trusted group</option>
                <% trustedGroups.forEach(group => { %>
                  <option value="<%= group.id %>"><%= group.name %> (<%= group.member_count %> members)</option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label for="pickupTime" class="form-label">Pickup Time</label>
              <input type="datetime-local" class="form-control" id="pickupTime" name="pickup_time" required>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="dropoffTime" class="form-label">Dropoff Time</label>
              <input type="datetime-local" class="form-control" id="dropoffTime" name="dropoff_time" required>
            </div>
            <div class="col-md-6 mb-3">
              <label for="pickupLocation" class="form-label">Pickup Location</label>
              <input type="text" class="form-control" id="pickupLocation" name="pickup_location" required>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="dropoffLocation" class="form-label">Dropoff Location</label>
              <input type="text" class="form-control" id="dropoffLocation" name="dropoff_location" required>
            </div>
            <div class="col-md-6 mb-3">
              <label for="requestMessage" class="form-label">Message (Optional)</label>
              <textarea class="form-control" id="requestMessage" name="message" rows="3" placeholder="Add any additional details..."></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Send Request</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
// Set default times (pickup 15 minutes before dropoff)
document.getElementById('dropoffTime').addEventListener('change', function() {
  const dropoffTime = new Date(this.value);
  const pickupTime = new Date(dropoffTime.getTime() - 15 * 60 * 1000); // 15 minutes before
  document.getElementById('pickupTime').value = pickupTime.toISOString().slice(0, 16);
});

// Auto-fill pickup location with user's address if available
document.addEventListener('DOMContentLoaded', function() {
  // This could be enhanced to auto-fill from user profile
  const userAddress = '<%= session.home_address %>';
  if (userAddress) {
    document.getElementById('pickupLocation').value = userAddress;
  }
});
</script>

<%- include('partials/footer1') %> 