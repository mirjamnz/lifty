<!--views/child-dashboard.ejs -->
<!DOCTYPE html>
<%- include('partials/header1') %>
<%- include('partials/navbar-child') %>

<div class="container my-4">
  <!-- Welcome Message -->
  <h1 class="mb-4 text-primary">👋 Hey, <%= child.name %>!</h1>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 text-success">My Rides</h2>
    <form method="get" action="/child-dashboard" class="d-flex align-items-center gap-2 mb-0">
      <label for="range" class="form-label mb-0 me-2">Show:</label>
      <select name="range" id="range" class="form-select form-select-sm" onchange="this.form.submit()">
        <option value="0" <%= range == 0 ? 'selected' : '' %>>Today</option>
        <option value="2" <%= range == 2 ? 'selected' : '' %>>Next 2 days</option>
        <option value="7" <%= range == 7 ? 'selected' : '' %>>Next 7 days</option>
      </select>
    </form>
  </div>
  <% if (autojump) { %>
    <div class="alert alert-info text-center py-2 mb-3">
      <i class="fas fa-info-circle me-1"></i> Showing next available rides.
    </div>
  <% } %>

  <% 
    // Merge and sort all rides by date/time
    const allRides = [...requests, ...offers, ...recurringAssignments].sort((a, b) => {
      const aTime = a.pickup_time || a.event_date;
      const bTime = b.pickup_time || b.event_date;
      return new Date(aTime) - new Date(bTime);
    });
  %>

  <% if (allRides.length === 0) { %>
    <div class="alert alert-info text-center" role="alert">
      No rides found for the selected date range. Check back later!
    </div>
  <% } else { %>
    <div class="row g-4">
      <% allRides.forEach(function(ride) { %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm" style="border-radius: 1rem;">
            <div class="card-header text-center" style="background-color: <%= ride.type === 'request' ? '#fff3cd' : ride.type === 'offer' ? '#4dabf7' : '#e3f2fd' %>;">
              <span class="badge <%= ride.type === 'request' ? 'bg-warning text-dark' : ride.type === 'offer' ? 'bg-primary' : 'bg-info text-dark' %> me-2">
                <%= ride.type === 'request' ? 'Request' : ride.type === 'offer' ? 'Offer' : 'Recurring' %>
              </span>
              <% if (ride.type === 'recurring') { %>
                <span class="badge bg-light text-dark me-2" style="font-weight: 500; font-size: 1rem;">
                  <%= new Date(ride.event_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </span>
              <% } else { %>
                <span class="badge bg-light text-dark me-2" style="font-weight: 500; font-size: 1rem;">
                  <%= ride.formatted_time %>
                </span>
              <% } %>
              <% if (ride.status) { %>
                <span class="badge bg-<%= ride.status === 'Assigned' || ride.status === 'confirmed' ? 'success' : ride.status === 'Pending' ? 'warning text-dark' : ride.status === 'completed' ? 'info' : 'secondary' %>">
                  <%= ride.status.charAt(0).toUpperCase() + ride.status.slice(1) %>
                </span>
              <% } %>
            </div>
            <div class="card-body p-3">
              <% if (ride.type === 'recurring') { %>
                <h5 class="card-title fw-bold text-info mb-3"><%= ride.event_name %></h5>
                <ul class="list-group list-group-flush mb-2">
                  <li class="list-group-item bg-transparent py-1">
                    <i class="fas fa-clock me-2 text-info"></i>
                    <strong>Time:</strong> <%= ride.start_time %> - <%= ride.end_time %>
                  </li>
                  <li class="list-group-item bg-transparent py-1">
                    <i class="fas fa-user me-2 text-success"></i>
                    <strong>Event Driver:</strong> <%= ride.assigned_parent_name %>
                  </li>
                  <li class="list-group-item bg-transparent py-1">
                    <i class="fas fa-map-marker-alt me-2 text-warning"></i>
                    <strong>Location:</strong> <%= ride.location %>
                  </li>
                  <li class="list-group-item bg-transparent py-1">
                    <i class="fas fa-calendar-week me-2 text-primary"></i>
                    <strong>Schedule:</strong> <%= ride.day_of_week %>s
                  </li>
                </ul>
                <% if (ride.notes) { %>
                  <div class="alert alert-secondary py-1 px-2 small mb-0 mt-2"><%= ride.notes %></div>
                <% } %>
              <% } else { %>
                <ul class="list-group list-group-flush mb-2">
                  <li class="list-group-item bg-transparent py-1">
                    <i class="fas fa-user me-2 text-success"></i>
                    <strong>Driver:</strong> <%= ride.driver_name || 'Not yet assigned' %>
                  </li>
                  <li class="list-group-item bg-transparent py-1">
                    <i class="fas fa-map-marker-alt me-2 text-info"></i>
                    <strong>Pickup:</strong> <%= ride.pickup_location || 'Current Location' %>
                  </li>
                  <li class="list-group-item bg-transparent py-1">
                    <i class="fas fa-flag-checkered me-2 text-success"></i>
                    <strong>Dropoff:</strong> <%= ride.dropoff_location || ride.school || 'N/A' %>
                  </li>
                </ul>
                <% if (ride.note) { %>
                  <div class="alert alert-secondary py-1 px-2 small mb-0"><%= ride.note %></div>
                <% } %>
              <% } %>
            </div>
            <div class="card-footer bg-transparent text-center">
              <% if (ride.type === 'request' && ride.status === 'Assigned') { %>
                <a href="/messages/group/ride/<%= ride.id %>" class="btn btn-sm btn-outline-primary ms-2">Chat</a>
              <% } %>
              <% if (ride.type === 'request' && ride.status !== 'completed') { %>
                <form action="/child-dashboard/complete-request/<%= ride.id %>" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-success ms-2">Mark as Complete</button>
                </form>
              <% } else if (ride.type === 'request' && ride.status === 'completed') { %>
                <form action="/child-dashboard/undo-complete/<%= ride.id %>" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-warning ms-2">Undo Complete</button>
                </form>
              <% } %>
              <% if (ride.type === 'recurring') { %>
                <a href="/messages/group/recurring/<%= ride.event_id %>" class="btn btn-sm btn-outline-primary ms-2">
                  <i class="fas fa-comments me-1"></i>Group Chat
                </a>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="/css/style.css">
