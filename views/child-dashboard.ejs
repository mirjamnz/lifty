<!--views/child-dashboard.ejs -->
<!DOCTYPE html>
<%- include('partials/header1') %>
<%- include('partials/navbar-child') %>

<div class="container my-4">
  <!-- Welcome Message -->
  <h1 class="mb-4 text-primary">👶 Welcome, <%= child.name %>!</h1>

  <!-- Your Ride Requests Section -->
  <h2 class="mb-3 text-success">Your Ride Requests</h2>
  <% if (!requests || requests.length === 0) { %>
    <div class="alert alert-info text-center" role="alert">
      No ride requests found. Check back later!
    </div>
  <% } else { %>
    <div class="row g-4">
      <% requests.forEach(function(request) { %>
        <% const driver = users.find(u => u.id === request.assigned_user_id) || { name: 'Not Assigned' }; %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm" style="background-color: <%= request.status === 'Assigned' ? '#d1e7dd' : '#fff3cd' %>; border-radius: 1rem;">
            <div class="card-header <%= request.status === 'Assigned' ? 'bg-success text-white' : 'bg-warning text-dark' %> text-center">
              <span class="badge <%= request.status === 'Assigned' ? 'bg-light text-success' : 'bg-light text-warning' %>"><%= request.status %></span>
            </div>
            <div class="card-body p-3">
              <div class="d-flex align-items-center mb-2">
                <i class="fas fa-calendar-alt fa-lg me-2 text-primary"></i>
                <span class="fw-bold fs-5 text-primary"> <%= request.formatted_time %> </span>
              </div>
              <div class="d-flex align-items-center mb-2">
                <i class="fas fa-user fa-lg me-2 text-success"></i>
                <span class="fw-bold">Assigned Driver:</span>
                <span class="ms-2">
                  <% if (driver && driver.name && driver.name !== 'Not Assigned') { %>
                    <%= driver.name %>
                  <% } else { %>
                    <span class="text-warning">Not yet assigned</span>
                  <% } %>
                </span>
              </div>
              <div class="row mb-2">
                <div class="col-6">
                  <div class="d-flex align-items-center">
                    <i class="fas fa-map-marker-alt fa-lg me-2 text-info"></i>
                    <div>
                      <div class="fw-bold text-info">Pickup</div>
                      <div class="fw-bold text-dark"><%= request.pickup_location %></div>
                    </div>
                  </div>
                </div>
                <div class="col-6">
                  <div class="d-flex align-items-center">
                    <i class="fas fa-flag-checkered fa-lg me-2 text-success"></i>
                    <div>
                      <div class="fw-bold text-success">Dropoff</div>
                      <div class="fw-bold text-dark"><%= request.dropoff_location || 'N/A' %></div>
                    </div>
                  </div>
                </div>
              </div>
              <% if (request.note) { %>
                <div class="alert alert-secondary py-1 px-2 small mb-0"><%= request.note %></div>
              <% } %>
            </div>
            <div class="card-footer bg-transparent text-center">
              <small class="text-white">Ride ID: <%= request.id %></small>
              <% if (request.status === 'Assigned') { %>
                <a href="/messages/group/ride/<%= request.id %>" class="btn btn-sm btn-outline-primary ms-2">Chat</a>
              <% } %>
              <% if (request.status !== 'completed') { %>
                <form action="/child-dashboard/complete-request/<%= request.id %>" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-success ms-2">Mark as Complete</button>
                </form>
              <% } else { %>
                <form action="/child-dashboard/undo-complete/<%= request.id %>" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-warning ms-2">Undo Complete</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- Your Ride Offers Section -->
  <h2 class="mb-3 mt-5 text-success">Your Ride Offers</h2>
  <% if (!offers || offers.length === 0) { %>
    <div class="alert alert-info text-center" role="alert">
      No ride offers found. Check back later!
    </div>
  <% } else { %>
    <div class="row g-4">
      <% offers.forEach(function(offer) { %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm" style="background-color: #4dabf7; border-radius: 1rem;">
            <div class="card-header bg-success text-white text-center">
              <span class="badge bg-light text-success">Offered</span>
            </div>
            <div class="card-body p-3 text-white">
              <h5 class="card-title fw-bold">Ride to <%= offer.school || 'N/A' %></h5>
              <ul class="list-group list-group-flush">
                <li class="list-group-item bg-transparent">
                  <i class="fas fa-calendar-alt me-2 text-success"></i>
                  <strong>Date & Time:</strong> <%= offer.formatted_time %>
                </li>
                <li class="list-group-item bg-transparent">
                  <i class="fas fa-map-marker-alt me-2 text-success"></i>
                  <strong>From:</strong> Current Location
                </li>
                <li class="list-group-item bg-transparent">
                  <i class="fas fa-flag-checkered me-2 text-success"></i>
                  <strong>To:</strong> <%= offer.school || 'N/A' %>
                </li>
              </ul>
            </div>
            <div class="card-footer bg-transparent text-center">
              <small class="text-white">Offer ID: <%= offer.id %></small>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- Your Recurring Event Rides Section -->
  <h2 class="mb-3 mt-5 text-info">🗓️ Your Recurring Event Rides</h2>
  <% if (!recurringAssignments || recurringAssignments.length === 0) { %>
    <div class="alert alert-info text-center" role="alert">
      No recurring event rides found. Check back later!
    </div>
  <% } else { %>
    <div class="row g-4">
      <% recurringAssignments.forEach(function(assignment) { %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm" style="background-color: #e3f2fd; border-radius: 1rem;">
            <div class="card-header bg-info text-white text-center">
              <span class="badge bg-light text-info">
                <i class="fas fa-<%= assignment.assignment_type === 'dropoff' ? 'sign-in-alt' : 'sign-out-alt' %> me-1"></i>
                <%= assignment.assignment_type.charAt(0).toUpperCase() + assignment.assignment_type.slice(1) %>
              </span>
            </div>
            <div class="card-body p-3">
              <h5 class="card-title fw-bold text-info"><%= assignment.event_name %></h5>
              <ul class="list-group list-group-flush">
                <li class="list-group-item bg-transparent">
                  <i class="fas fa-calendar-alt me-2 text-info"></i>
                  <strong>Date:</strong> <%= new Date(assignment.event_date).toLocaleDateString() %>
                </li>
                <li class="list-group-item bg-transparent">
                  <i class="fas fa-clock me-2 text-info"></i>
                  <strong>Time:</strong> <%= assignment.start_time %> - <%= assignment.end_time %>
                </li>
                <li class="list-group-item bg-transparent">
                  <i class="fas fa-user me-2 text-success"></i>
                  <strong>Driver:</strong> <%= assignment.assigned_parent_name %>
                </li>
                <li class="list-group-item bg-transparent">
                  <i class="fas fa-map-marker-alt me-2 text-warning"></i>
                  <strong>Location:</strong> <%= assignment.location %>
                </li>
                <li class="list-group-item bg-transparent">
                  <i class="fas fa-calendar-week me-2 text-primary"></i>
                  <strong>Schedule:</strong> <%= assignment.day_of_week %>s
                </li>
              </ul>
              <% if (assignment.notes) { %>
                <div class="alert alert-secondary py-1 px-2 small mb-0 mt-2"><%= assignment.notes %></div>
              <% } %>
            </div>
            <div class="card-footer bg-transparent text-center">
              <span class="badge bg-<%= assignment.status === 'confirmed' ? 'success' : assignment.status === 'pending' ? 'warning text-dark' : assignment.status === 'completed' ? 'info' : 'secondary' %>">
                <%= assignment.status.charAt(0).toUpperCase() + assignment.status.slice(1) %>
              </span>
              <a href="/recurring-event-groups/<%= assignment.event_id %>" class="btn btn-sm btn-outline-info ms-2">
                <i class="fas fa-users me-1"></i>Group
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="/css/style.css">

