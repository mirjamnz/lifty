<!--views/child-dashboard.ejs -->
<%- include('partials/header1') %>
<%- include('partials/navbar-child') %>

<div class="container my-4">
  <!-- Welcome Message -->
  <h1 class="mb-4">Welcome, <%= child.name %>!</h1>

  <!-- Your Ride Requests Section -->
  <h2>Your Ride Requests</h2>
  <% if (!requests || requests.length === 0) { %>
    <p class="text-muted">No ride requests found.</p>
  <% } else { %>
    <div class="row mb-5">
      <% requests.forEach(function(request) { %>
        <div class="col-md-6 col-lg-4">
          <div class="card mb-3">
            <div class="card-body">
              <h5 class="card-title">Ride to <%= request.dropoff_location || 'N/A' %></h5>
              <p class="card-text">
                <strong>Pickup:</strong> <%= request.pickup_location %><br>
                <strong>Drop-off:</strong> <%= request.dropoff_location || 'N/A' %><br>
                <strong>Date & Time:</strong> <%= new Date(request.pickup_time).toLocaleString('en-NZ', { dateStyle: 'medium', timeStyle: 'short' }) %>
              </p>
              <% if (request.assigned_user_id) { %>
                <p class="card-text"><small class="text-muted">Status: Assigned</small></p>
              <% } %>
              <a href="#" class="btn btn-primary btn-sm">View</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- Your Ride Offers Section -->
  <h2>Your Ride Offers</h2>
  <% if (!offers || offers.length === 0) { %>
    <p class="text-muted">No ride offers found.</p>
  <% } else { %>
    <div class="row">
      <% offers.forEach(function(offer) { %>
        <div class="col-md-6 col-lg-4">
          <div class="card mb-3">
            <div class="card-body">
              <h5 class="card-title">Ride to <%= offer.school %></h5>
              <p class="card-text">
                <strong>Pickup Time:</strong> <%= new Date(offer.pickup_time).toLocaleString('en-NZ', { dateStyle: 'medium', timeStyle: 'short' }) %>
              </p>
              <a href="#" class="btn btn-primary btn-sm">View</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<!-- Bootstrap 5 JS bundle (with Popper) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
<%- include('partials/footer1') %>