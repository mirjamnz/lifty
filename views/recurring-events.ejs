<%- include('partials/header1') %>
<%- include('partials/navbar1') %>

<div class="container py-5">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📅 Recurring Events</h2>
        <a href="/recurring-events/create" class="btn btn-primary">
          <i class="fas fa-plus me-2"></i>Create Event
        </a>
      </div>

      <% if (success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- My Group Memberships -->
      <% if (groupMemberships && groupMemberships.length > 0) { %>
        <div class="card mb-4 border-info">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0">
              <i class="fas fa-users me-2"></i>
              My Group Events (<%= groupMemberships.filter(m => m.role === 'parent' || m.role === 'admin').length %>)
            </h5>
          </div>
          <div class="card-body">
            <div class="row">
              <% 
                // Group by event to avoid duplicates
                const uniqueGroupEvents = groupMemberships
                  .filter(m => m.role === 'parent' || m.role === 'admin')
                  .reduce((acc, member) => {
                    if (!acc.find(e => e.event_id === member.event_id)) {
                      acc.push(member);
                    }
                    return acc;
                  }, []);
              %>
              <% uniqueGroupEvents.forEach(membership => { %>
                <div class="col-md-6 col-lg-4 mb-3">
                  <div class="card h-100 border-info">
                    <div class="card-body">
                      <h6 class="card-title text-info">
                        <i class="fas fa-users me-2"></i>
                        <%= membership.event_name %>
                        <% if (membership.role === 'admin') { %>
                          <span class="badge bg-warning text-dark ms-2">Admin</span>
                        <% } %>
                      </h6>
                      <p class="card-text">
                        <small class="text-muted">
                          <i class="fas fa-child me-1"></i>
                          Group Event
                        </small>
                      </p>
                      <div class="d-flex justify-content-between">
                        <a href="/recurring-event-groups/<%= membership.event_id %>" 
                           class="btn btn-outline-info btn-sm">
                          <i class="fas fa-users me-1"></i>Group
                        </a>
                        <a href="/recurring-events/<%= membership.event_id %>/assignments" 
                           class="btn btn-outline-success btn-sm">
                          <i class="fas fa-tasks me-1"></i>Assignments
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      <% } %>

      <!-- My Individual Subscriptions -->
      <% if (subscriptions && subscriptions.length > 0) { %>
        <div class="card mb-4 border-success">
          <div class="card-header bg-success text-white">
            <h5 class="mb-0">
              <i class="fas fa-check-circle me-2"></i>
              My Individual Subscriptions (<%= subscriptions.length %>)
            </h5>
          </div>
          <div class="card-body">
            <div class="row">
              <% subscriptions.forEach(subscription => { %>
                <div class="col-md-6 col-lg-4 mb-3">
                  <div class="card h-100 border-success">
                    <div class="card-body">
                      <h6 class="card-title text-success">
                        <i class="fas fa-calendar-check me-2"></i>
                        <%= subscription.event_name %>
                      </h6>
                      <p class="card-text">
                        <small class="text-muted">
                          <i class="fas fa-child me-1"></i>
                          <%= subscription.child_name %>
                        </small>
                      </p>
                      <div class="d-flex justify-content-between">
                        <a href="/recurring-events/<%= subscription.event_id %>/assignments" 
                           class="btn btn-outline-success btn-sm">
                          <i class="fas fa-tasks me-1"></i>Assignments
                        </a>
                        <form method="POST" action="/recurring-events/<%= subscription.event_id %>/unsubscribe" 
                              style="display: inline;">
                          <input type="hidden" name="child_id" value="<%= subscription.child_id %>">
                          <button type="submit" class="btn btn-outline-danger btn-sm" 
                                  onclick="return confirm('Unsubscribe from this event?')">
                            <i class="fas fa-times me-1"></i>Unsubscribe
                          </button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Available Events -->
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">
            <i class="fas fa-calendar-alt me-2"></i>
            Available Events (<%= events.length %>)
          </h5>
        </div>
        <div class="card-body">
          <% if (events.length === 0) { %>
            <div class="text-center py-4">
              <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
              <h5>No recurring events available</h5>
              <p class="text-muted">Be the first to create a recurring event!</p>
              <a href="/recurring-events/create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Create First Event
              </a>
            </div>
          <% } else { %>
            <div class="row">
              <% events.forEach(event => { %>
                <div class="col-md-6 col-lg-4 mb-4">
                  <div class="card h-100 <%= event.is_group_event ? 'border-info' : '' %>">
                    <div class="card-header <%= event.is_group_event ? 'bg-info text-white' : '' %>">
                      <h6 class="mb-0">
                        <i class="fas fa-<%= event.activity_type === 'Sport' ? 'futbol' : 
                                          event.activity_type === 'Club' ? 'users' : 
                                          event.activity_type === 'School' ? 'graduation-cap' : 'star' %> me-2"></i>
                        <%= event.name %>
                        <% if (event.is_group_event) { %>
                          <span class="badge bg-light text-dark ms-2">Group</span>
                        <% } %>
                      </h6>
                    </div>
                    <div class="card-body">
                      <p class="card-text"><%= event.description || 'No description' %></p>
                      
                      <% if (event.is_group_event && event.group_description) { %>
                        <div class="mb-3">
                          <small class="text-info">
                            <i class="fas fa-info-circle me-1"></i>
                            <%= event.group_description %>
                          </small>
                        </div>
                      <% } %>
                      
                      <div class="mb-3">
                        <small class="text-muted">
                          <i class="fas fa-clock me-1"></i>
                          <%= event.day_of_week %>s, <%= event.start_time %> - <%= event.end_time %>
                        </small>
                      </div>
                      
                      <div class="mb-3">
                        <small class="text-muted">
                          <i class="fas fa-map-marker-alt me-1"></i>
                          <%= event.location %>
                        </small>
                      </div>
                      
                      <div class="mb-3">
                        <small class="text-muted">
                          <% if (event.is_group_event) { %>
                            <i class="fas fa-users me-1"></i>
                            <%= event.group_member_count %> member<%= event.group_member_count !== 1 ? 's' : '' %>
                          <% } else { %>
                            <i class="fas fa-users me-1"></i>
                            <%= event.subscriber_count %> subscriber<%= event.subscriber_count !== 1 ? 's' : '' %>
                          <% } %>
                        </small>
                      </div>
                      
                      <div class="mb-3">
                        <small class="text-muted">
                          <i class="fas fa-user me-1"></i>
                          Created by <%= event.created_by_name %>
                        </small>
                      </div>
                    </div>
                    <div class="card-footer">
                      <div class="d-flex justify-content-between align-items-center">
                        <% if (event.is_group_event) { %>
                          <a href="/recurring-event-groups/<%= event.id %>" 
                             class="btn btn-outline-info btn-sm">
                            <i class="fas fa-users me-1"></i>Join Group
                          </a>
                        <% } else { %>
                          <a href="/recurring-events/<%= event.id %>/assignments" 
                             class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-eye me-1"></i>View
                          </a>
                        <% } %>
                        
                        <% if (!event.is_group_event && children && children.length > 0) { %>
                          <div class="dropdown">
                            <button class="btn btn-success btn-sm dropdown-toggle" type="button" 
                                    data-bs-toggle="dropdown">
                              <i class="fas fa-plus me-1"></i>Subscribe
                            </button>
                            <ul class="dropdown-menu">
                              <% children.forEach(child => { %>
                                <li>
                                  <form method="POST" action="/recurring-events/<%= event.id %>/subscribe" 
                                        style="display: inline;">
                                    <input type="hidden" name="child_id" value="<%= child.id %>">
                                    <button type="submit" class="dropdown-item">
                                      <i class="fas fa-child me-2"></i>
                                      <%= child.name %>
                                    </button>
                                  </form>
                                </li>
                              <% }) %>
                            </ul>
                          </div>
                        <% } %>
                        <% if ((event.created_by === session.userId) || (groupMemberships && groupMemberships.some(m => m.event_id === event.id && m.role === 'admin'))) { %>
                          <form method="POST" action="/recurring-events/<%= event.id %>/delete" style="display:inline;">
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                              onclick="return confirm('Are you sure you want to delete this event? This cannot be undone for all participants!');">
                              <i class="fas fa-trash me-1"></i>Delete
                            </button>
                          </form>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.card {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.dropdown-item:hover {
  background-color: #e9ecef;
}

.border-info {
  border-color: #17a2b8 !important;
}

.bg-info {
  background-color: #17a2b8 !important;
}
</style>

<%- include('partials/footer1') %> 