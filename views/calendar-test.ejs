<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FullCalendar Test</title>
  <!-- FullCalendar v5.11.3 CSS (guaranteed CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
  <style>
    body { font-family: Arial, sans-serif; margin: 2rem; }
    #calendar { max-width: 900px; margin: 0 auto; }
  </style>
</head>
<body>
  <h2>FullCalendar Standalone Test</h2>
  <div id="calendar"></div>

  <!-- FullCalendar v5.11.3 JS (guaranteed CDN) -->
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var calendarEl = document.getElementById('calendar');
      var calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        headerToolbar: {
          left: 'prev,next today',
          center: 'title',
          right: 'dayGridMonth,timeGridWeek,timeGridDay'
        },
        height: 600,
        events: [
          // Static demo events
          { title: 'Test Event 1', start: new Date().toISOString().slice(0,10) },
          { title: 'Test Event 2', start: new Date(Date.now() + 86400000).toISOString().slice(0,10) }
        ]
      });
      calendar.render();
    });
  </script>
</body>
</html> 