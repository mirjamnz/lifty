<%- include('partials/header1') %>
<%- include(session && session.is_admin ? 'partials/navbar2' : 'partials/navbar1') %>

<style>
.event-card {
  transition: transform 0.2s;
}
.event-card:hover {
  transform: translateY(-2px);
}
.attendance-status {
  font-size: 0.8rem;
  padding: 0.2rem 0.5rem;
  border-radius: 0.25rem;
}
.attendance-confirmed {
  background-color: #d4edda;
  color: #155724;
}
.attendance-pending {
  background-color: #fff3cd;
  color: #856404;
}
.driver-assigned {
  background-color: #cce5ff;
  color: #004085;
}
.message-container {
  max-height: 400px;
  overflow-y: auto;
}
</style>

<div class="container py-5">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="text-primary mb-1">👥 <%= event.name %></h2>
      <p class="text-muted mb-0">
        <%= event.day_of_week %>s • <%= event.start_time %> - <%= event.end_time %> • <%= event.location %>
      </p>
      <small class="text-muted">Created by <%= event.created_by_name %></small>
    </div>
    <div class="d-flex gap-2">
      <a href="/recurring-event-groups/<%= event.id %>/generate-instances" 
         class="btn btn-outline-warning btn-sm"
         onclick="return confirm('Generate upcoming event instances?')">
        <i class="fas fa-calendar-plus me-1"></i>Generate Instances
      </a>
      <a href="/recurring-events" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to Events
      </a>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <div class="row g-4">
    <!-- Upcoming Instances -->
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0">📅 Upcoming Events</h5>
        </div>
        <div class="card-body">
          <% if (instances && instances.length > 0) { %>
            <% instances.forEach(instance => { %>
              <div class="border-bottom pb-3 mb-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div class="flex-grow-1">
                    <h6 class="mb-1">
                      <%= new Date(instance.event_date).toLocaleDateString('en-US', { 
                        weekday: 'long', 
                        year: 'numeric', 
                        month: 'long', 
                        day: 'numeric' 
                      }) %>
                    </h6>
                    <div class="row">
                      <div class="col-md-6">
                        <strong>Driver:</strong>
                        <% if (instance.driver_name) { %>
                          <span class="text-success"><%= instance.driver_name %></span>
                          <span class="attendance-status driver-assigned">Assigned</span>
                        <% } else { %>
                          <span class="text-warning">Not assigned</span>
                        <% } %>
                      </div>
                      <div class="col-md-6">
                        <strong>Status:</strong>
                        <span class="badge bg-<%= instance.status === 'confirmed' ? 'success' : instance.status === 'pending' ? 'warning' : 'secondary' %>">
                          <%= instance.status.charAt(0).toUpperCase() + instance.status.slice(1) %>
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="ms-3">
                    <!-- Driver Assignment Button -->
                    <% if (!instance.driver_name) { %>
                      <button class="btn btn-sm btn-outline-primary assign-driver-btn" 
                              data-instance-date="<%= instance.event_date %>"
                              data-bs-toggle="modal" 
                              data-bs-target="#assignDriverModal">
                        <i class="fas fa-car me-1"></i>Assign Driver
                      </button>
                    <% } %>
                    
                    <!-- Attendance Confirmation -->
                    <% 
                      const userChildren = members.filter(m => m.user_id === session.userId && m.child_id);
                      if (userChildren.length > 0) { 
                    %>
                      <button class="btn btn-sm btn-outline-success confirm-attendance-btn"
                              data-instance-date="<%= instance.event_date %>"
                              data-bs-toggle="modal"
                              data-bs-target="#confirmAttendanceModal">
                        <i class="fas fa-check me-1"></i>Confirm Attendance
                      </button>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center text-muted py-4">
              <i class="fas fa-calendar-times fa-3x mb-3"></i>
              <p>No upcoming events scheduled</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Group Members -->
    <div class="col-lg-4">
      <div class="card shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0">👨‍👩‍👧‍👦 Group Members</h5>
        </div>
        <div class="card-body">
          <% if (members && members.length > 0) { %>
            <% members.forEach(member => { %>
              <div class="border-bottom pb-2 mb-2">
                <div class="d-flex justify-content-between align-items-start">
                  <div class="flex-grow-1">
                    <div class="fw-bold"><%= member.user_name %></div>
                    <% if (member.child_name) { %>
                      <small class="text-muted">
                        <i class="fas fa-child me-1"></i><%= member.child_name %>
                        <% if (member.school) { %> • <%= member.school %><% } %>
                      </small>
                      <div class="mt-1">
                        <% if (member.attendance_confirmed) { %>
                          <span class="attendance-status attendance-confirmed">
                            <i class="fas fa-check me-1"></i>Attendance Confirmed
                          </span>
                        <% } else { %>
                          <span class="attendance-status attendance-pending">
                            <i class="fas fa-clock me-1"></i>Attendance Pending
                          </span>
                        <% } %>
                      </div>
                    <% } %>
                    <div class="mt-1">
                      <% if (member.can_drive) { %>
                        <span class="badge bg-success">Can Drive</span>
                      <% } %>
                      <% if (member.role === 'admin') { %>
                        <span class="badge bg-primary">Admin</span>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center text-muted py-3">
              <i class="fas fa-users fa-2x mb-2"></i>
              <p>No members yet</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Group Chat -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0">💬 Group Chat</h5>
        </div>
        <div class="card-body">
          <div class="message-container mb-3">
            <% if (messages && messages.length > 0) { %>
              <% messages.reverse().forEach(message => { %>
                <div class="border-bottom pb-2 mb-2">
                  <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                      <div class="fw-bold">
                        <%= message.sender_name %>
                        <% if (message.message_type === 'assignment') { %>
                          <span class="badge bg-info">Assignment</span>
                        <% } %>
                      </div>
                      <div class="text-muted"><%= message.message %></div>
                      <small class="text-muted">
                        <%= new Date(message.sent_at).toLocaleString() %>
                      </small>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="text-center text-muted py-3">
                <i class="fas fa-comments fa-2x mb-2"></i>
                <p>No messages yet. Start the conversation!</p>
              </div>
            <% } %>
          </div>
          
          <!-- Send Message Form -->
          <form method="POST" action="/recurring-event-groups/<%= event.id %>/send-message">
            <div class="input-group">
              <input type="text" class="form-control" name="message" 
                     placeholder="Type your message..." required>
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-paper-plane"></i> Send
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Assign Driver Modal -->
<div class="modal fade" id="assignDriverModal" tabindex="-1" aria-labelledby="assignDriverModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="assignDriverModalLabel">Assign Driver</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="POST" action="/recurring-event-groups/<%= event.id %>/assign-driver">
        <div class="modal-body">
          <input type="hidden" name="instance_date" id="instanceDate">
          <div class="mb-3">
            <label for="driver_id" class="form-label">Select Driver</label>
            <select class="form-select" name="driver_id" required>
              <option value="">Choose a driver...</option>
              <% members.filter(m => m.can_drive && m.role === 'parent').forEach(member => { %>
                <option value="<%= member.user_id %>"><%= member.user_name %></option>
              <% }) %>
            </select>
            <div class="form-text">Select a parent who can drive for this event.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Assign Driver</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Confirm Attendance Modal -->
<div class="modal fade" id="confirmAttendanceModal" tabindex="-1" aria-labelledby="confirmAttendanceModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="confirmAttendanceModalLabel">Confirm Attendance</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="POST" action="/recurring-event-groups/<%= event.id %>/confirm-attendance">
        <div class="modal-body">
          <input type="hidden" name="instance_date" id="attendanceInstanceDate">
          <div class="mb-3">
            <label for="child_id" class="form-label">Select Child</label>
            <select class="form-select" name="child_id" required>
              <option value="">Choose a child...</option>
              <% members.filter(m => m.user_id === session.userId && m.child_id).forEach(member => { %>
                <option value="<%= member.child_id %>"><%= member.child_name %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label for="will_attend" class="form-label">Attendance Status</label>
            <select class="form-select" name="will_attend" required>
              <option value="true">Will attend</option>
              <option value="false">Will not attend</option>
            </select>
            <div class="form-text">Confirm whether your child will attend this event instance.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Confirm Attendance</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Handle assign driver modal
  const assignDriverBtns = document.querySelectorAll('.assign-driver-btn');
  assignDriverBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const instanceDate = this.getAttribute('data-instance-date');
      document.getElementById('instanceDate').value = instanceDate;
    });
  });
  
  // Handle confirm attendance modal
  const confirmAttendanceBtns = document.querySelectorAll('.confirm-attendance-btn');
  confirmAttendanceBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const instanceDate = this.getAttribute('data-instance-date');
      document.getElementById('attendanceInstanceDate').value = instanceDate;
    });
  });
});
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

<%- include('partials/footer1') %> 