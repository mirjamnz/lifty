<!--views/trusted-groups.ejs -->
<%- include('partials/header1') %>
<%- include('partials/navbar1') %>

<div class="container mt-4">
  <!-- Page Header -->
  <div class="row mb-4">
    <div class="col">
      <h2 class="mb-0">
        <i class="fas fa-users me-2"></i>Trusted Parent Groups
      </h2>
      <p class="text-muted">Manage your trusted parent groups for quick ride coordination</p>
    </div>
    <div class="col-auto">
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createGroupModal">
        <i class="fas fa-plus me-1"></i>Create New Group
      </button>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="row mb-4">
    <div class="col">
      <div class="card border-info">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0">
            <i class="fas fa-bolt me-2"></i>Quick Actions
          </h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <a href="/short-notice" class="btn btn-success btn-lg w-100 mb-2">
                <i class="fas fa-clock me-2"></i>Send Short-Notice Request
              </a>
            </div>
            <div class="col-md-6">
              <a href="/notifications" class="btn btn-warning btn-lg w-100 mb-2">
                <i class="fas fa-bell me-2"></i>View Notifications
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- My Groups Section -->
  <div class="row mb-4">
    <div class="col">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">
            <i class="fas fa-crown me-2"></i>Groups I Created (<%= myGroups.length %>)
          </h5>
        </div>
        <div class="card-body">
          <% if (myGroups.length === 0) { %>
            <div class="text-center py-4">
              <i class="fas fa-users fa-3x text-muted mb-3"></i>
              <p class="text-muted">You haven't created any groups yet.</p>
              <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createGroupModal">
                <i class="fas fa-plus me-1"></i>Create Your First Group
              </button>
            </div>
          <% } else { %>
            <div class="row">
              <% myGroups.forEach(group => { %>
                <div class="col-md-6 col-lg-4 mb-3">
                  <div class="card h-100 border-primary">
                    <div class="card-header bg-primary text-white">
                      <h6 class="mb-0">
                        <i class="fas fa-users me-1"></i><%= group.name %>
                      </h6>
                    </div>
                    <div class="card-body">
                      <% if (group.description) { %>
                        <p class="card-text text-muted small"><%= group.description %></p>
                      <% } %>
                      <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-info">
                          <i class="fas fa-user me-1"></i><%= group.member_count %> members
                        </span>
                        <small class="text-muted">
                          Created <%= new Date(group.created_at).toLocaleDateString() %>
                        </small>
                      </div>
                      <div class="btn-group btn-group-sm w-100">
                        <button class="btn btn-outline-primary" data-group-id="<%= group.id %>" onclick="viewGroupMembers(this.dataset.groupId)">
                          <i class="fas fa-eye me-1"></i>Members
                        </button>
                        <button class="btn btn-outline-success" data-group-id="<%= group.id %>" onclick="window.location.href='/short-notice?group=' + this.dataset.groupId">
                          <i class="fas fa-clock me-1"></i>Request Ride
                        </button>
                        <button class="btn btn-outline-danger" data-group-id="<%= group.id %>" data-group-name="<%= group.name %>" onclick="deleteGroup(this.dataset.groupId, this.dataset.groupName)">
                          <i class="fas fa-trash"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Member Groups Section -->
  <div class="row mb-4">
    <div class="col">
      <div class="card">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0">
            <i class="fas fa-user-friends me-2"></i>Groups I'm In (<%= memberGroups.length %>)
          </h5>
        </div>
        <div class="card-body">
          <% if (memberGroups.length === 0) { %>
            <div class="text-center py-4">
              <i class="fas fa-user-friends fa-3x text-muted mb-3"></i>
              <p class="text-muted">You're not a member of any groups yet.</p>
              <p class="text-muted small">Ask other parents to add you to their trusted groups.</p>
            </div>
          <% } else { %>
            <div class="row">
              <% memberGroups.forEach(group => { %>
                <div class="col-md-6 col-lg-4 mb-3">
                  <div class="card h-100 border-success">
                    <div class="card-header bg-success text-white">
                      <h6 class="mb-0">
                        <i class="fas fa-users me-1"></i><%= group.name %>
                      </h6>
                    </div>
                    <div class="card-body">
                      <% if (group.description) { %>
                        <p class="card-text text-muted small"><%= group.description %></p>
                      <% } %>
                      <p class="card-text text-muted small">
                        <i class="fas fa-crown me-1"></i>Created by <%= group.creator_name %>
                      </p>
                      <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-info">
                          <i class="fas fa-user me-1"></i><%= group.member_count %> members
                        </span>
                        <small class="text-muted">
                          Joined <%= new Date(group.created_at).toLocaleDateString() %>
                        </small>
                      </div>
                      <div class="btn-group btn-group-sm w-100">
                        <button class="btn btn-outline-primary" data-group-id="<%= group.id %>" onclick="viewGroupMembers(this.dataset.groupId)">
                          <i class="fas fa-eye me-1"></i>Members
                        </button>
                        <button class="btn btn-outline-success" data-group-id="<%= group.id %>" onclick="window.location.href='/short-notice?group=' + this.dataset.groupId">
                          <i class="fas fa-clock me-1"></i>Request Ride
                        </button>
                        <button class="btn btn-outline-warning" data-group-id="<%= group.id %>" data-group-name="<%= group.name %>" onclick="leaveGroup(this.dataset.groupId, this.dataset.groupName)">
                          <i class="fas fa-sign-out-alt"></i>Leave
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Ride Requests Section -->
  <div class="row mb-4">
    <div class="col">
      <div class="card">
        <div class="card-header bg-warning text-dark">
          <h5 class="mb-0">
            <i class="fas fa-car me-2"></i>Recent Ride Requests
          </h5>
        </div>
        <div class="card-body">
          <div id="recentRequests">
            <div class="text-center py-4">
              <i class="fas fa-spinner fa-spin fa-2x text-muted mb-3"></i>
              <p class="text-muted">Loading recent requests...</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Create Group Modal -->
<div class="modal fade" id="createGroupModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-plus me-2"></i>Create New Trusted Group
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/trusted-groups" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label for="groupName" class="form-label">Group Name</label>
            <input type="text" class="form-control" id="groupName" name="name" required>
          </div>
          <div class="mb-3">
            <label for="groupDescription" class="form-label">Description (Optional)</label>
            <textarea class="form-control" id="groupDescription" name="description" rows="3"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Add Members</label>
            <div class="row">
              <% allUsers.forEach(user => { %>
                <div class="col-md-6">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="member_ids" value="<%= user.id %>" id="user<%= user.id %>">
                    <label class="form-check-label" for="user<%= user.id %>">
                      <%= user.name %> (<%= user.email %>)
                    </label>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Group</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Group Members Modal -->
<div class="modal fade" id="groupMembersModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-users me-2"></i>Group Members
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="groupMembersContent">
        <!-- Content will be loaded dynamically -->
      </div>
    </div>
  </div>
</div>

<script>
// Load recent ride requests on page load
document.addEventListener('DOMContentLoaded', function() {
  loadRecentRequests();
});

function loadRecentRequests() {
  fetch('/trusted-groups/recent-requests')
    .then(response => response.json())
    .then(data => {
      const container = document.getElementById('recentRequests');
      
      if (data.requests.length === 0) {
        container.innerHTML = `
          <div class="text-center py-4">
            <i class="fas fa-car fa-3x text-muted mb-3"></i>
            <p class="text-muted">No recent ride requests found.</p>
            <a href="/short-notice" class="btn btn-primary">
              <i class="fas fa-plus me-1"></i>Send Your First Request
            </a>
          </div>
        `;
      } else {
        let html = '<div class="list-group">';
        data.requests.forEach(request => {
          const statusClass = request.status === 'pending' ? 'list-group-item-warning' : 
                             request.status === 'accepted' ? 'list-group-item-success' : 
                             'list-group-item-secondary';
          const statusText = request.status === 'pending' ? 'Pending' : 
                           request.status === 'accepted' ? 'Accepted' : 
                           request.status === 'declined' ? 'Declined' : 'Cancelled';
          
          html += `
            <div class="list-group-item ${statusClass}">
              <div class="d-flex w-100 justify-content-between">
                <h6 class="mb-1">
                  <i class="fas fa-car me-1"></i>${request.requester_name} - ${request.group_name}
                </h6>
                <small class="text-muted">
                  ${new Date(request.created_at).toLocaleDateString()}
                  <span class="badge bg-${request.status === 'pending' ? 'warning' : request.status === 'accepted' ? 'success' : 'secondary'} ms-2">${statusText}</span>
                </small>
              </div>
              <p class="mb-1">
                <strong>From:</strong> ${request.pickup_location}<br>
                <strong>To:</strong> ${request.dropoff_location}<br>
                <strong>Time:</strong> ${new Date(request.pickup_time).toLocaleString()}
              </p>
              <small class="text-muted">
                <i class="fas fa-comments me-1"></i>${request.response_count} responses
                <a href="/short-notice/${request.id}" class="btn btn-sm btn-outline-primary ms-2">View Details</a>
              </small>
            </div>
          `;
        });
        html += '</div>';
        container.innerHTML = html;
      }
    })
    .catch(error => {
      console.error('Error loading recent requests:', error);
      document.getElementById('recentRequests').innerHTML = `
        <div class="text-center py-4">
          <i class="fas fa-exclamation-triangle fa-2x text-danger mb-3"></i>
          <p class="text-danger">Error loading recent requests.</p>
        </div>
      `;
    });
}

function viewGroupMembers(groupId) {
  // Show loading state
  document.getElementById('groupMembersContent').innerHTML = `
    <div class="text-center py-4">
      <i class="fas fa-spinner fa-spin fa-2x text-muted mb-3"></i>
      <p>Loading group members...</p>
    </div>
  `;
  
  // Show the modal
  new bootstrap.Modal(document.getElementById('groupMembersModal')).show();
  
  // Fetch group members via AJAX
  fetch(`/trusted-groups/${groupId}/members`)
    .then(response => {
      if (!response.ok) {
        throw new Error('Failed to load group members');
      }
      return response.json();
    })
    .then(data => {
      const container = document.getElementById('groupMembersContent');
      
      if (data.members.length === 0) {
        container.innerHTML = `
          <div class="text-center py-4">
            <i class="fas fa-users fa-3x text-muted mb-3"></i>
            <p class="text-muted">No members found in this group.</p>
          </div>
        `;
      } else {
        let html = `
          <div class="mb-3">
            <h6 class="text-muted">${data.group.name}</h6>
            ${data.group.description ? `<p class="text-muted small">${data.group.description}</p>` : ''}
          </div>
          <div class="list-group">
        `;
        
        data.members.forEach(member => {
          const roleBadge = member.role === 'Creator' ? 
            '<span class="badge bg-primary ms-2">Creator</span>' : 
            '<span class="badge bg-secondary ms-2">Member</span>';
          
          const joinedDate = member.joined_at ? 
            new Date(member.joined_at).toLocaleDateString() : 
            'Unknown';
          
          html += `
            <div class="list-group-item">
              <div class="d-flex w-100 justify-content-between align-items-center">
                <div>
                  <h6 class="mb-1">
                    <i class="fas fa-user me-2"></i>${member.name}
                    ${roleBadge}
                  </h6>
                  <small class="text-muted">
                    <i class="fas fa-envelope me-1"></i>${member.email}
                  </small>
                </div>
                <small class="text-muted">
                  <i class="fas fa-calendar me-1"></i>Joined ${joinedDate}
                </small>
              </div>
            </div>
          `;
        });
        
        html += '</div>';
        container.innerHTML = html;
      }
    })
    .catch(error => {
      console.error('Error loading group members:', error);
      document.getElementById('groupMembersContent').innerHTML = `
        <div class="text-center py-4">
          <i class="fas fa-exclamation-triangle fa-2x text-danger mb-3"></i>
          <p class="text-danger">Error loading group members.</p>
          <button class="btn btn-primary" onclick="viewGroupMembers(${groupId})">
            <i class="fas fa-redo me-1"></i>Try Again
          </button>
        </div>
      `;
    });
}

function deleteGroup(groupId, groupName) {
  if (confirm(`Are you sure you want to delete the group "${groupName}"? This action cannot be undone.`)) {
    fetch(`/trusted-groups/${groupId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json'
      }
    }).then(response => {
      if (response.ok) {
        location.reload();
      } else {
        alert('Error deleting group');
      }
    });
  }
}

function leaveGroup(groupId, groupName) {
  if (confirm(`Are you sure you want to leave the group "${groupName}"?`)) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `/trusted-groups/${groupId}/leave`;
    document.body.appendChild(form);
    form.submit();
  }
}
</script>

<%- include('partials/footer1') %> 