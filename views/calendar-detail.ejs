<%- include('partials/header1') %>
<%- include('partials/navbar1') %>

<!-- FullCalendar CSS -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />

<div class="container mt-4">
  <h3 class="mb-3"><i class="fas fa-calendar-alt me-2"></i>Full Calendar</h3>
  <div id="calendar"></div>

  <!-- Event Detail Modal placeholder -->
  <div id="eventModalContainer"></div>
</div>

<!-- FullCalendar JS & deps -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales-all.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const calendarEl = document.getElementById('calendar');
    const calendarEvents = <%- JSON.stringify(calendarEvents || []) %>;

    const calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: 'dayGridMonth',
      headerToolbar: {
        left: 'prev,next today',
        center: 'title',
        right: 'dayGridMonth,timeGridWeek,listWeek'
      },
      height: 'auto',
      timeZone: 'local',
      events: calendarEvents,
      eventDisplay: 'block',
      eventTimeFormat: { hour:'2-digit',minute:'2-digit',meridiem:'short' },
      eventClick: function(info){
        info.jsEvent.preventDefault();
        const event = info.event;
        const isActivityGroup = event.extendedProps.type === 'activity_group';
        const instanceId = event.extendedProps.instance_id || event.id;

        const dropoffLabel = (event.extendedProps.dropoff_driver && event.extendedProps.dropoff_driver !== 'Unassigned')
          ? `Take Over Drop Off at ${event.title}` : `I can Drop Off at ${event.title}`;
        const pickupLabel = (event.extendedProps.pickup_driver && event.extendedProps.pickup_driver !== 'Unassigned')
          ? `Take Over Pick Up from ${event.title}` : `I can Pick Up from ${event.title}`;
        const bothLabel = ((event.extendedProps.dropoff_driver && event.extendedProps.dropoff_driver !== 'Unassigned') || (event.extendedProps.pickup_driver && event.extendedProps.pickup_driver !== 'Unassigned'))
          ? 'Take Over Both' : 'I can Do Both';

        const modalHTML = `
          <div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="eventModalLabel"><i class="fas fa-calendar-event me-2"></i>${event.title}</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <p class="text-muted mb-3"><i class="fas fa-info-circle me-2"></i>${event.extendedProps.description || 'No description'}</p>
                  <div class="alert alert-info">
                    <i class="fas fa-clock me-2"></i><strong>Time:</strong> ${event.start.toLocaleString('en-NZ',{weekday:'long',year:'numeric',month:'long',day:'numeric',hour:'2-digit',minute:'2-digit',hour12:true})}
                    ${event.end ? `<br><i class='fas fa-stop-circle me-2'></i><strong>End:</strong> ${event.end.toLocaleString('en-NZ',{hour:'2-digit',minute:'2-digit',hour12:true})}`:''}
                  </div>
                  ${isActivityGroup?`
                    <div class="alert alert-secondary mb-3">
                      <strong>Dropoff:</strong> <span class="${event.extendedProps.dropoff_driver==='Unassigned'?'text-danger':'text-success'}">${event.extendedProps.dropoff_driver||'Unassigned'}</span><br>
                      <strong>Pickup:</strong> <span class="${event.extendedProps.pickup_driver==='Unassigned'?'text-danger':'text-success'}">${event.extendedProps.pickup_driver||'Unassigned'}</span>
                    </div>
                    <div class="mt-3">
                      <form method="POST" action="/event-instances/${instanceId}/assign-self-driver" style="display:inline;">
                        <input type="hidden" name="assignmentType" value="dropoff"><button type="submit" class="btn btn-primary btn-sm me-2">${dropoffLabel}</button>
                      </form>
                      <form method="POST" action="/event-instances/${instanceId}/assign-self-driver" style="display:inline;">
                        <input type="hidden" name="assignmentType" value="pickup"><button type="submit" class="btn btn-success btn-sm me-2">${pickupLabel}</button>
                      </form>
                      <form method="POST" action="/event-instances/${instanceId}/assign-self-driver" style="display:inline;">
                        <input type="hidden" name="assignmentType" value="both"><button type="submit" class="btn btn-info btn-sm">${bothLabel}</button>
                      </form>
                    </div>`:''}
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Close</button>
                </div>
              </div>
            </div>
          </div>`;

        const container = document.getElementById('eventModalContainer');
        container.innerHTML = modalHTML;
        const modal = new bootstrap.Modal(document.getElementById('eventModal'));
        modal.show();
        document.getElementById('eventModal').addEventListener('hidden.bs.modal',function(){this.remove();});
      }
    });
    calendar.render();
  });
</script>

<%- include('partials/footer1') %>
