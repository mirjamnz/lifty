<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notifications - Lifty</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<%- include('partials/navbar1') %>

<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <h1 class="mb-4">
        <i class="fas fa-bell me-2"></i>Notifications
      </h1>
      
      <!-- Notification Stats -->
      <div class="row mb-4">
        <div class="col-md-6">
          <div class="card border-primary">
            <div class="card-body">
              <h5 class="card-title text-primary">
                <i class="fas fa-envelope me-2"></i>General Notifications
              </h5>
              <p class="card-text">
                <span class="badge bg-primary"><%= unreadGeneral || 0 %> unread</span>
                <span class="text-muted ms-2"><%= (generalNotifications && generalNotifications.length) || 0 %> total</span>
              </p>
            </div>
          </div>
        </div>
        <!-- Removed Trusted Group stats -->
      </div>

      <!-- General Notifications -->
      <div class="card mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">
            <i class="fas fa-envelope me-2"></i>General Notifications
          </h5>
        </div>
        <div class="card-body">
          <% if (!generalNotifications || generalNotifications.length === 0) { %>
            <div class="text-center text-muted py-4">
              <i class="fas fa-inbox fa-3x mb-3"></i>
              <p>No general notifications yet.</p>
            </div>
          <% } else { %>
            <div class="list-group">
              <% generalNotifications.forEach(notification => { %>
                <div class="list-group-item list-group-item-action <%= !notification.is_read ? 'list-group-item-primary' : '' %>" 
                     data-notification-id="<%= notification.id %>">
                  <div class="d-flex w-100 justify-content-between">
                    <h6 class="mb-1"><%= notification.title || notification.type || 'Notification' %></h6>
                    <small class="text-muted">
                      <%= notification.created_at ? new Date(notification.created_at).toLocaleDateString() : 'Unknown date' %>
                      <% if (!notification.is_read) { %>
                        <span class="badge bg-primary ms-2">New</span>
                      <% } %>
                    </small>
                  </div>
                  <p class="mb-1"><%= notification.message || 'No message content' %></p>
                  <small class="text-muted">
                    <i class="fas fa-tag me-1"></i><%= notification.type || 'general' %>
                  </small>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Trusted Group Notifications section removed -->
    </div>
  </div>
</div>

<script>
// Mark notifications as read when clicked
document.addEventListener('DOMContentLoaded', function() {
  // General notifications
  document.querySelectorAll('[data-notification-id]').forEach(item => {
    item.addEventListener('click', function() {
      const notificationId = this.getAttribute('data-notification-id');
      markNotificationAsRead(notificationId);
    });
  });

  // Removed trusted group click handler
});

function markNotificationAsRead(notificationId) {
  fetch(`/notifications/${notificationId}/read`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Remove the "New" badge and update styling
      const notification = document.querySelector(`[data-notification-id="${notificationId}"]`);
      if (notification) {
        notification.classList.remove('list-group-item-primary');
        const badge = notification.querySelector('.badge');
        if (badge) badge.remove();
      }
    }
  })
  .catch(error => console.error('Error marking notification as read:', error));
}

// Removed trusted group read function
</script>

<%- include('partials/footer1') %>

</body>
</html> 