<!--views/organizations.ejs -->
<%- include('partials/header1') %>
<%- include('partials/navbar1') %>

<style>
/* REFINED MODAL CSS - VISIBLE BUT INTERACTIVE */
.custom-modal {
  display: none !important;
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  background-color: rgba(0,0,0,0.5) !important;
  z-index: 999999 !important;
  overflow-y: auto !important;
}

.custom-modal.active {
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
}

.modal-content-wrapper {
  position: fixed !important;
  top: 50% !important;
  left: 50% !important;
  transform: translate(-50%, -50%) !important;
  background: white !important;
  border-radius: 8px !important;
  padding: 0 !important;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1) !important;
  max-height: 90vh !important;
  overflow-y: auto !important;
  z-index: 1000000 !important;
  pointer-events: auto !important;
}

/* ALLOW NORMAL INTERACTIONS INSIDE MODAL */
.custom-modal.active .modal-content-wrapper,
.custom-modal.active .modal-content-wrapper *,
.custom-modal.active .modal-content-wrapper input,
.custom-modal.active .modal-content-wrapper select,
.custom-modal.active .modal-content-wrapper button,
.custom-modal.active .modal-content-wrapper form {
  pointer-events: auto !important;
  cursor: auto !important;
}

.custom-modal.active .modal-content-wrapper input:hover,
.custom-modal.active .modal-content-wrapper select:hover,
.custom-modal.active .modal-content-wrapper button:hover {
  pointer-events: auto !important;
  cursor: pointer !important;
}

/* ONLY DISABLE HOVER EFFECTS ON BACKGROUND ELEMENTS WHEN MODAL IS OPEN */
.modal-active .card:hover {
  transform: none !important;
}

.modal-active section .col-md-4:hover {
  transform: none !important;
}

/* KEEP MODAL BACKDROP CLICKABLE */
.custom-modal.active {
  pointer-events: auto !important;
}

/* BUT MODAL CONTENT SHOULD BLOCK BACKDROP CLICKS */
.custom-modal.active .modal-content-wrapper {
  pointer-events: auto !important;
}
</style>

<div class="container py-5">
  <h2 class="mb-4">🏫 Schools & Clubs Management</h2>

  <% if (session.success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= session.success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% session.success = null; %>
  <% } %>

  <!-- User's Affiliations Section -->
  <% if (userAffiliations && userAffiliations.length > 0) { %>
    <div class="card mb-4 border-primary">
      <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
          <i class="fas fa-user-check me-2"></i>Your Affiliations
        </h5>
      </div>
      <div class="card-body">
        <div class="row">
          <% userAffiliations.forEach(function(affiliation) { %>
            <div class="col-md-6 col-lg-4 mb-3">
              <div class="d-flex align-items-center p-3 border rounded bg-light">
                <div class="flex-shrink-0 me-3">
                  <i class="fas fa-<%= affiliation.type === 'school' ? 'graduation-cap' : affiliation.type === 'club' ? 'users' : 'calendar' %> text-primary fs-4"></i>
                </div>
                <div class="flex-grow-1">
                  <h6 class="mb-1 fw-bold"><%= affiliation.name %></h6>
                  <small class="text-muted">
                    <% affiliation.roles.split(',').forEach(function(role) { %>
                      <span class="badge bg-<%= role === 'parent' ? 'success' : 'info' %> me-1">
                        <%= role === 'parent' ? 'Parent' : 'Child' %>
                      </span>
                    <% }); %>
                    <%= affiliation.type.charAt(0).toUpperCase() + affiliation.type.slice(1) %>
                  </small>
                  <% if (affiliation.address) { %>
                    <br><small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i><%= affiliation.address %></small>
                  <% } %>
                </div>
                <div class="flex-shrink-0 ms-2">
                  <button class="btn btn-sm btn-outline-danger" onclick="removeAffiliation('<%= affiliation.id %>', '<%= affiliation.name %>')" title="Leave Organization">
                    <i class="fas fa-times"></i>
                  </button>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  <% } %>

  <div class="row">
    <!-- 🏫 Clubs & Schools -->
    <div class="col-md-8">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title mb-0">🏫 Your Organizations</h5>
            <button class="btn btn-primary btn-sm" onclick="openAddModal()">
              <i class="fas fa-plus me-1"></i>Add Organization
            </button>
          </div>
          
          <!-- Search Bar -->
          <div class="mb-3">
            <div class="input-group">
              <span class="input-group-text">
                <i class="fas fa-search"></i>
              </span>
              <input type="text" id="organizationSearch" class="form-control" placeholder="Search organizations by name, type, or address...">
              <button class="btn btn-outline-secondary" type="button" id="clearSearch">
                <i class="fas fa-times"></i>
              </button>
            </div>
          </div>

          <% if (organizations && organizations.length > 0) { %>
            <div class="table-responsive">
              <table class="table">
                <thead class="table-light">
                  <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Address</th>
                    <th>Affiliations</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="organizationsTableBody">
                  <% organizations.forEach(org => { %>
                    <tr>
                      <td><strong><%= org.name %></strong></td>
                      <td>
                        <span class="badge bg-<%= org.type === 'school' ? 'primary' : org.type === 'club' ? 'success' : 'info' %>">
                          <%= org.type.charAt(0).toUpperCase() + org.type.slice(1) %>
                        </span>
                      </td>
                      <td><%= org.address || 'Not specified' %></td>
                      <td>
                        <div class="d-flex flex-column align-items-start">
                          <small class="text-muted">
                            <i class="fas fa-users me-1"></i>
                            <a href="/organizations/<%= org.id %>/details" class="text-decoration-none">
                              <span class="badge bg-primary hover-bg-primary-dark"><%= org.parent_count || 0 %> parents</span>
                            </a>
                          </small>
                          <small class="text-muted mt-1">
                            <i class="fas fa-child me-1"></i>
                            <a href="/organizations/<%= org.id %>/details" class="text-decoration-none">
                              <span class="badge bg-success hover-bg-success-dark"><%= org.child_count || 0 %> children</span>
                            </a>
                          </small>
                        </div>
                      </td>
                      <td>
                        <% 
                          // Check if user is already affiliated with this organization
                          const isAffiliated = userAffiliations && userAffiliations.some(aff => aff.id === org.id);
                        %>
                        <% if (!isAffiliated) { %>
                          <button class="btn btn-sm btn-success" onclick="openJoinModal('<%= org.id %>')">
                            <i class="fas fa-user-plus me-1"></i>Join
                          </button>
                        <% } else { %>
                          <span class="badge bg-success">Already Member</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="text-muted">No organizations registered yet.</p>
          <% } %>

          <!-- Join Organization Modals -->
          <% if (organizations && organizations.length > 0) { %>
            <% organizations.forEach(function(org) { %>
              <% 
                // Check if user is already affiliated with this organization
                const isAffiliated = userAffiliations && userAffiliations.some(aff => aff.id === org.id);
              %>
              <% if (!isAffiliated) { %>
                <div class="custom-modal" id="joinModal<%= org.id %>">
                  <div class="modal-content-wrapper" style="min-width: 400px; max-width: 500px;">
                    <div style="padding: 1rem; border-bottom: 1px solid #dee2e6; display: flex; justify-content: space-between; align-items: center;">
                      <h5 style="margin: 0;">
                        <i class="fas fa-user-plus me-2"></i>Join <%= org.name %>
                      </h5>
                      <button type="button" class="btn-close" onclick="closeJoinModal('<%= org.id %>')" style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">&times;</button>
                    </div>
                    <form action="/organizations/<%= org.id %>/join" method="POST" id="joinForm<%= org.id %>">
                      <div style="padding: 1rem;">
                        <p class="mb-3">
                          <strong><%= org.name %></strong> is a <%= org.type.charAt(0).toUpperCase() + org.type.slice(1) %>.
                          <% if (org.address) { %>
                            <br><small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i><%= org.address %></small>
                          <% } %>
                        </p>
                        
                        <div class="mb-3">
                          <label for="role<%= org.id %>" class="form-label">Join as:</label>
                          <select name="role" id="role<%= org.id %>" class="form-select" required>
                            <option value="parent">Parent</option>
                            <option value="child">Child</option>
                          </select>
                        </div>
                        
                        <div class="mb-3" id="childSelect<%= org.id %>" style="display: none;">
                          <label for="child_id<%= org.id %>" class="form-label">Select Child:</label>
                          <select name="child_id" id="child_id<%= org.id %>" class="form-select">
                            <option value="">No child (join as individual)</option>
                            <!-- This will be populated with user's children if available -->
                          </select>
                        </div>
                      </div>
                      <div style="padding: 1rem; border-top: 1px solid #dee2e6; display: flex; justify-content: flex-end; gap: 0.5rem;">
                        <button type="button" class="btn btn-secondary" onclick="closeJoinModal('<%= org.id %>')">Cancel</button>
                        <button type="submit" class="btn btn-success" id="submitBtn<%= org.id %>">
                          <i class="fas fa-user-plus me-1"></i>Join Organization
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
              <% } %>
            <% }); %>
          <% } %>

          <!-- Add Organization Modal -->
          <div class="custom-modal" id="addOrganizationModal">
            <div class="modal-content-wrapper" style="min-width: 500px; max-width: 600px;">
              <div style="padding: 1rem; border-bottom: 1px solid #dee2e6; display: flex; justify-content: space-between; align-items: center;">
                <h5 style="margin: 0;">
                  <i class="fas fa-plus me-2"></i>Add New Organization
                </h5>
                <button type="button" class="btn-close" onclick="closeAddModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">&times;</button>
              </div>
              <form action="/organizations/add" method="POST" id="addOrganizationForm">
                <div style="padding: 1rem;">
                  <div class="mb-3">
                    <label for="name" class="form-label">Organization Name *</label>
                    <input type="text" class="form-control" id="name" name="name" required>
                  </div>
                  
                  <div class="mb-3">
                    <label for="type" class="form-label">Type *</label>
                    <select class="form-select" id="type" name="type" required>
                      <option value="">Select type...</option>
                      <option value="school">School</option>
                      <option value="club">Club</option>
                      <option value="event">Event</option>
                      <option value="other">Other</option>
                    </select>
                  </div>
                  
                  <div class="mb-3">
                    <label for="address" class="form-label">Address *</label>
                    <input type="text" class="form-control" id="address" name="address" required>
                  </div>
                  
                  <div class="row">
                    <div class="col-md-6">
                      <div class="mb-3">
                        <label for="lat" class="form-label">Latitude</label>
                        <input type="number" step="any" class="form-control" id="lat" name="lat">
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="mb-3">
                        <label for="lng" class="form-label">Longitude</label>
                        <input type="number" step="any" class="form-control" id="lng" name="lng">
                      </div>
                    </div>
                  </div>
                </div>
                <div style="padding: 1rem; border-top: 1px solid #dee2e6; display: flex; justify-content: flex-end; gap: 0.5rem;">
                  <button type="button" class="btn btn-secondary" onclick="closeAddModal()">Cancel</button>
                  <button type="submit" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i>Add Organization
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 📋 Quick Stats -->
    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="card-title">📊 Quick Stats</h5>
          <div class="row text-center">
            <div class="col-6">
              <div class="border-end">
                <h4 class="text-primary"><%= organizations ? organizations.filter(o => o.type === 'school').length : 0 %></h4>
                <small class="text-muted">Schools</small>
              </div>
            </div>
            <div class="col-6">
              <h4 class="text-success"><%= organizations ? organizations.filter(o => o.type === 'club').length : 0 %></h4>
              <small class="text-muted">Clubs</small>
            </div>
          </div>
          <hr>
          <div class="row text-center">
            <div class="col-6">
              <div class="border-end">
                <h4 class="text-info"><%= organizations ? organizations.filter(o => o.type === 'event').length : 0 %></h4>
                <small class="text-muted">Events</small>
              </div>
            </div>
            <div class="col-6">
              <h4 class="text-secondary"><%= organizations ? organizations.filter(o => o.type === 'other').length : 0 %></h4>
              <small class="text-muted">Other</small>
            </div>
          </div>
          <hr>
          <div class="row text-center">
            <div class="col-6">
              <div class="border-end">
                <h4 class="text-warning"><%= organizations ? organizations.reduce((sum, org) => sum + (org.parent_count || 0), 0) : 0 %></h4>
                <small class="text-muted">Total Parents</small>
              </div>
            </div>
            <div class="col-6">
              <h4 class="text-info"><%= organizations ? organizations.reduce((sum, org) => sum + (org.child_count || 0), 0) : 0 %></h4>
              <small class="text-muted">Total Children</small>
            </div>
          </div>
        </div>
      </div>

      <!-- 💡 Tips -->
      <div class="card shadow-sm mt-3">
        <div class="card-body">
          <h6 class="card-title">💡 Tips</h6>
          <ul class="list-unstyled small">
            <li class="mb-2">• Add schools your children attend</li>
            <li class="mb-2">• Include sports clubs and activities</li>
            <li class="mb-2">• Add special events and field trips</li>
            <li class="mb-2">• Organizations help with ride coordination</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// REFINED JAVASCRIPT - VISIBLE BUT INTERACTIVE
function forceModalVisible(modalId) {
  const modal = document.getElementById(modalId);
  if (modal) {
    // Add body class to override background hover effects only
    document.body.classList.add('modal-active');
    
    // Make modal visible
    modal.classList.add('active');
    modal.style.display = 'block';
    modal.style.visibility = 'visible';
    modal.style.opacity = '1';
    
    // Disable body scroll
    document.body.style.overflow = 'hidden';
    
    // Force repaint once
    modal.offsetHeight;
    
    console.log('🔧 Modal visible and interactive:', modalId);
  }
}

function forceModalHidden(modalId) {
  const modal = document.getElementById(modalId);
  if (modal) {
    document.body.classList.remove('modal-active');
    modal.classList.remove('active');
    modal.style.display = 'none';
    document.body.style.overflow = '';
    console.log('🔧 Modal hidden:', modalId);
  }
}

function openJoinModal(orgId) {
  console.log('🔧 Opening join modal for org:', orgId);
  forceModalVisible('joinModal' + orgId);
}

function closeJoinModal(orgId) {
  console.log('🔧 Closing join modal for org:', orgId);
  forceModalHidden('joinModal' + orgId);
}

function openAddModal() {
  console.log('🔧 Opening add modal');
  forceModalVisible('addOrganizationModal');
}

function closeAddModal() {
  console.log('🔧 Closing add modal');
  forceModalHidden('addOrganizationModal');
}

function removeAffiliation(orgId, orgName) {
  if (confirm(`Are you sure you want to leave ${orgName}?`)) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `/organizations/${orgId}/leave`;
    document.body.appendChild(form);
    form.submit();
  }
}

// Initialize when DOM is ready
document.addEventListener('DOMContentLoaded', function() {
  console.log('🔧 Setting up refined event handlers...');

  // Backdrop click handlers
  document.querySelectorAll('.custom-modal').forEach(modal => {
    modal.addEventListener('click', function(event) {
      // Only close if clicking directly on the backdrop (not modal content)
      if (event.target === modal) {
        if (modal.id === 'addOrganizationModal') {
          closeAddModal();
        } else if (modal.id.startsWith('joinModal')) {
          const orgId = modal.id.replace('joinModal', '');
          closeJoinModal(orgId);
        }
      }
    });
  });

  // Prevent modal content clicks from closing modal
  document.querySelectorAll('.modal-content-wrapper').forEach(wrapper => {
    wrapper.addEventListener('click', function(event) {
      event.stopPropagation();
    });
  });

  // Role selection handlers
  document.querySelectorAll('select[name="role"]').forEach(select => {
    select.addEventListener('change', function() {
      const orgId = this.id.replace('role', '');
      const childSelect = document.getElementById('childSelect' + orgId);
      if (childSelect) {
        childSelect.style.display = this.value === 'child' ? 'block' : 'none';
      }
    });
  });

  // Search functionality
  const searchInput = document.getElementById('organizationSearch');
  const clearSearchBtn = document.getElementById('clearSearch');
  const tableBody = document.getElementById('organizationsTableBody');
  
  if (searchInput && tableBody) {
    searchInput.addEventListener('input', function() {
      const searchTerm = this.value.toLowerCase();
      const rows = tableBody.querySelectorAll('tr');
      
      rows.forEach(function(row) {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(searchTerm) ? '' : 'none';
      });
    });
    
    if (clearSearchBtn) {
      clearSearchBtn.addEventListener('click', function() {
        searchInput.value = '';
        const rows = tableBody.querySelectorAll('tr');
        rows.forEach(function(row) {
          row.style.display = '';
        });
      });
    }
  }

  // ESC key handler
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      document.querySelectorAll('.custom-modal.active').forEach(modal => {
        if (modal.id === 'addOrganizationModal') {
          closeAddModal();
        } else if (modal.id.startsWith('joinModal')) {
          const orgId = modal.id.replace('joinModal', '');
          closeJoinModal(orgId);
        }
      });
    }
  });

  console.log('✅ Refined event handlers set up complete');
});
</script>

<%- include('partials/footer1') %>