<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Messages - Lifty</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<%- include('partials/navbar-child') %>

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>
                    <i class="fas fa-comments me-2"></i>My Messages
                    <% if (totalUnread > 0) { %>
                        <span class="badge bg-danger ms-2"><%= totalUnread %></span>
                    <% } %>
                </h1>
                <a href="/child-dashboard" class="btn btn-outline-primary">
                    <i class="fas fa-arrow-left me-1"></i>Back to Dashboard
                </a>
            </div>

            <% if (groupThreads.length === 0) { %>
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-comment-dots fa-3x text-muted mb-3"></i>
                        <h3 class="text-muted">No messages yet</h3>
                        <p class="text-muted">When you have ride requests, you'll be able to chat with your parents and drivers here.</p>
                    </div>
                </div>
            <% } else { %>
                <div class="row">
                    <% groupThreads.forEach(thread => { %>
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100 <%= thread.unread_count > 0 ? 'border-primary' : '' %>">
                                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0">
                                            <i class="fas fa-car me-1"></i>Ride #<%= thread.ride_id %>
                                        </h6>
                                        <small class="text-muted">
                                            <%= new Date(thread.pickup_time).toLocaleDateString() %>
                                        </small>
                                    </div>
                                    <% if (thread.unread_count > 0) { %>
                                        <span class="badge bg-danger"><%= thread.unread_count %></span>
                                    <% } %>
                                </div>
                                <div class="card-body">
                                    <div class="mb-2">
                                        <strong>From:</strong> 
                                        <small class="text-truncate d-block"><%= thread.pickup_location %></small>
                                    </div>
                                    <div class="mb-2">
                                        <strong>To:</strong> 
                                        <small class="text-truncate d-block"><%= thread.dropoff_location %></small>
                                    </div>
                                    <div class="mb-3">
                                        <strong>Status:</strong> 
                                        <span class="badge bg-<%= thread.status === 'Assigned' ? 'success' : 'warning' %>">
                                            <%= thread.status %>
                                        </span>
                                        <% if (thread.driver_name) { %>
                                            <br><small>Driver: <%= thread.driver_name %></small>
                                        <% } %>
                                    </div>
                                    
                                    <% if (thread.latest_message) { %>
                                        <div class="border-top pt-3">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-grow-1">
                                                    <strong class="small"><%= thread.latest_message.sender_name %>:</strong>
                                                    <p class="small mb-1 text-truncate">
                                                        <%= thread.latest_message.content.substring(0, 50) %><%= thread.latest_message.content.length > 50 ? '...' : '' %>
                                                    </p>
                                                </div>
                                                <small class="text-muted ms-2">
                                                    <%= new Date(thread.latest_message.sent_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                                </small>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <div class="border-top pt-3">
                                            <p class="text-muted small mb-1">No messages yet</p>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="card-footer">
                                    <a href="/messages/group/ride/<%= thread.ride_id %>" class="btn btn-primary btn-sm w-100">
                                        <i class="fas fa-comments me-1"></i>
                                        <%= thread.unread_count > 0 ? 'View Messages' : 'Open Chat' %>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('partials/footer1') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 