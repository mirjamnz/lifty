<!-- views/partials/navbar1.ejs -->
 <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
  <div class="container">
    <a class="navbar-brand" href="/"><i class="fas fa-car-side me-2"></i>Lifty</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <% if (session && session.userId) { %>
          <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link" href="/rides">Rides</a></li>
          <li class="nav-item"><a class="nav-link" href="/recurring-events">Recurring Events</a></li>
          <li class="nav-item"><a class="nav-link" href="/organizations">Schools & Clubs</a></li>
          <li class="nav-item"><a class="nav-link" href="/dashboard#add-child-form">Add a Child</a></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/register">Register</a></li>
          <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
        <% } %>
      </ul>
      
      <!-- Right side of navbar -->
      <ul class="navbar-nav">
        <% if (session && session.userId) { %>
          <!-- Create New Button -->
          <li class="nav-item me-3">
            <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#createRideModal">
              <i class="fas fa-plus me-1"></i>Create New
            </button>
          </li>
          <!-- Messages -->
          <li class="nav-item">
            <a class="nav-link" href="/messages/all">
              <i class="fas fa-envelope"></i> Messages
              <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                <span class="badge rounded-pill bg-danger ms-1"><%= unreadCount %></span>
              <% } %>
            </a>
          </li>
          <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<!-- DEBUG: unreadCount is <%= typeof unreadCount !== 'undefined' ? unreadCount : 'undefined' %> -->
