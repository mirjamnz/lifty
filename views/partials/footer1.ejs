<!-- views/partials/footer1.ejs -->
<footer class="bg-dark text-white pt-5 pb-4">
  <div class="container">
    <div class="row">
      <!-- Brand and Mission -->
      <div class="col-md-4 mb-4">
        <h5><i class="fas fa-car-side me-2"></i>Lifty</h5>
        <p class="text-muted">
          Making school transportation safer, more efficient, and eco-friendly for busy families.
        </p>
      </div>

      <!-- Company Links -->
      <div class="col-md-2 mb-4">
        <h6 class="text-uppercase fw-bold mb-3">Company</h6>
        <ul class="list-unstyled">
          <li><a href="#" class="text-white text-decoration-none">About Us</a></li>
          <li><a href="#" class="text-white text-decoration-none">Contact</a></li>
        </ul>
      </div>

      <!-- Resources Links -->
      <div class="col-md-2 mb-4">
        <h6 class="text-uppercase fw-bold mb-3">Resources</h6>
        <ul class="list-unstyled">
          <li><a href="#" class="text-white text-decoration-none">Blog</a></li>
          <li><a href="#" class="text-white text-decoration-none">Safety Tips</a></li>
          <li><a href="#" class="text-white text-decoration-none">Help Center</a></li>
        </ul>
      </div>

      <!-- Legal Links -->
      <div class="col-md-2 mb-4">
        <h6 class="text-uppercase fw-bold mb-3">Legal</h6>
        <ul class="list-unstyled">
          <li><a href="#" class="text-white text-decoration-none">Terms of Service</a></li>
          <li><a href="#" class="text-white text-decoration-none">Privacy Policy</a></li>
          <li><a href="#" class="text-white text-decoration-none">Cookie Policy</a></li>
        </ul>
      </div>

      <!-- Download Section -->
      <div class="col-md-2 mb-4">
        <h6 class="text-uppercase fw-bold mb-3">Download</h6>
        <ul class="list-unstyled">
          <li><a href="#" class="text-white text-decoration-none">Store</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom line -->
    <hr class="bg-light" />
    <div class="text-center text-muted small">
      © 2025 Lifty. All rights reserved.
    </div>
  </div>
</footer>
<!-- Flatpickr JS -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
  flatpickr("input[name='pickup_time']", {
    enableTime: true,
    dateFormat: "Y-m-d H:i",
    defaultDate: new Date(),
    minDate: "today"
  });
</script>
<!-- Bootstrap 5 JS bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
<% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
  <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
    <div id="unreadToast" class="toast align-items-center text-bg-primary border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body">
          <i class="fas fa-envelope me-2"></i>
          You have <strong><%= unreadCount %></strong> unread message<%= unreadCount !== 1 ? 's' : '' %>!
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
      <div class="mt-2 ms-3 mb-2">
        <a href="/messages/inbox" class="btn btn-light btn-sm">
          <i class="fas fa-inbox me-1"></i>View Inbox
        </a>
      </div>
    </div>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var toastEl = document.getElementById('unreadToast');
      if (toastEl) {
        var toast = new bootstrap.Toast(toastEl, { delay: 10000 });
        toast.show();
      }
    });
  </script>
<% } %>
</body>
</html>