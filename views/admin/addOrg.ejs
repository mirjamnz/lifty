<!--views/admin/addOrg.ejs -->
<%- include('../partials/header1') %>
<%- include(session && session.is_admin ? '../partials/navbar2' : '../partials/navbar1') %>

<div class="container py-5">
  <h2 class="mb-4">➕ Add New Organization</h2>

  <form method="POST" action="/admin/organizations/add">
    <div class="mb-3">
      <label class="form-label">Name</label>
      <input type="text" name="name" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Type</label>
      <select name="type" class="form-select" required>
        <option value="school">School</option>
        <option value="club">Club</option>
        <option value="event">Event</option>
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label">Address</label>
      <input type="text" name="address" class="form-control">
    </div>
    <button type="submit" class="btn btn-success">➕ Add Organization</button>
    <a href="/admin/dashboard" class="btn btn-secondary">Cancel</a>
  </form>
</div>

<%- include('../partials/footer1') %>