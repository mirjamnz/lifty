<!--views/admin/dashboard.ejs -->
<%- include('../partials/header1') %>
<%- include('../partials/navbar2') %>

<div class="container mt-4">
  <!-- Page Header -->
  <div class="row mb-4">
    <div class="col">
      <h2 class="mb-0">
        <i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard
      </h2>
      <p class="text-muted">System overview and management</p>
    </div>
  </div>

  <!-- Flash Messages -->
  <% if (session.success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-2"></i><%= session.success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  
  <% if (session.error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="fas fa-exclamation-circle me-2"></i><%= session.error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- System Statistics -->
  <div class="row mb-4">
    <div class="col-md-3 mb-3">
      <div class="card border-primary">
        <div class="card-body text-center">
          <h3 class="text-primary mb-1"><%= userStats.total_users %></h3>
          <p class="text-muted mb-0">Total Users</p>
          <i class="fas fa-users fa-2x text-muted mt-2"></i>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card border-success">
        <div class="card-body text-center">
          <h3 class="text-success mb-1"><%= userStats.total_parents %></h3>
          <p class="text-muted mb-0">Parents</p>
          <i class="fas fa-user-friends fa-2x text-muted mt-2"></i>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card border-info">
        <div class="card-body text-center">
          <h3 class="text-info mb-1"><%= childStats.total_children %></h3>
          <p class="text-muted mb-0">Children</p>
          <i class="fas fa-child fa-2x text-muted mt-2"></i>
        </div>
      </div>
    </div>
    <div class="col-md-3 mb-3">
      <div class="card border-warning">
        <div class="card-body text-center">
          <h3 class="text-warning mb-1"><%= orgStats.total_organizations %></h3>
          <p class="text-muted mb-0">Organizations</p>
          <i class="fas fa-building fa-2x text-muted mt-2"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="row mb-4">
    <div class="col">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">
            <i class="fas fa-bolt me-2"></i>Quick Actions
          </h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-3 mb-3">
              <a href="/admin/users" class="btn btn-outline-primary w-100">
                <i class="fas fa-users me-2"></i>Manage Users
              </a>
            </div>
            <div class="col-md-3 mb-3">
              <a href="/admin/organizations" class="btn btn-outline-success w-100">
                <i class="fas fa-building me-2"></i>Organizations
              </a>
            </div>
            <div class="col-md-3 mb-3">
              <a href="/admin/messages" class="btn btn-outline-info w-100">
                <i class="fas fa-envelope me-2"></i>Messages
              </a>
            </div>
            <div class="col-md-3 mb-3">
              <a href="/admin/groups" class="btn btn-outline-warning w-100">
                <i class="fas fa-layer-group me-2"></i>Groups
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- User/Child Relationships -->
  <div class="row mb-4">
    <div class="col">
      <div class="card">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0">
            <i class="fas fa-users me-2"></i>User/Child Relationships
          </h5>
        </div>
        <div class="card-body">
          <% if (userChildRelationships.length === 0) { %>
            <div class="text-center py-4">
              <i class="fas fa-users fa-3x text-muted mb-3"></i>
              <p class="text-muted">No user/child relationships found.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Parent</th>
                    <th>Email</th>
                    <th>Children</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% 
                  let currentUserId = null;
                  let currentUserRow = null;
                  %>
                  <% userChildRelationships.forEach(relationship => { %>
                    <% if (currentUserId !== relationship.user_id) { %>
                      <% if (currentUserRow) { %>
                        </td>
                        <td>
                          <% if (currentUserRow.user_blocked) { %>
                            <span class="badge bg-danger">Blocked</span>
                          <% } else { %>
                            <span class="badge bg-success">Active</span>
                          <% } %>
                        </td>
                        <td>
                          <div class="btn-group btn-group-sm">
                            <a href="/admin/users/<%= currentUserRow.user_id %>/edit" class="btn btn-outline-primary">
                              <i class="fas fa-edit"></i>
                            </a>
                            <a href="/admin/users/<%= currentUserRow.user_id %>/manage-block" class="btn btn-outline-warning">
                              <i class="fas fa-ban"></i>
                            </a>
                          </div>
                        </td>
                      </tr>
                      <% } %>
                      <tr>
                        <td>
                          <strong><%= relationship.user_name %></strong>
                        </td>
                        <td><%= relationship.user_email %></td>
                        <td>
                          <% if (relationship.child_name) { %>
                            <span class="badge bg-info">
                              <%= relationship.child_name %>
                              <% if (relationship.child_blocked) { %>
                                <i class="fas fa-ban text-danger"></i>
                              <% } %>
                            </span>
                          <% } else { %>
                            <span class="text-muted">No children</span>
                          <% } %>
                        <% 
                        currentUserId = relationship.user_id;
                        currentUserRow = relationship;
                        %>
                    <% } else { %>
                      <% if (relationship.child_name) { %>
                        <br><span class="badge bg-info">
                          <%= relationship.child_name %>
                          <% if (relationship.child_blocked) { %>
                            <i class="fas fa-ban text-danger"></i>
                          <% } %>
                        </span>
                      <% } %>
                    <% } %>
                  <% }); %>
                  <% if (currentUserRow) { %>
                    </td>
                    <td>
                      <% if (currentUserRow.user_blocked) { %>
                        <span class="badge bg-danger">Blocked</span>
                      <% } else { %>
                        <span class="badge bg-success">Active</span>
                      <% } %>
                    </td>
                    <td>
                      <div class="btn-group btn-group-sm">
                        <a href="/admin/users/<%= currentUserRow.user_id %>/edit" class="btn btn-outline-primary">
                          <i class="fas fa-edit"></i>
                        </a>
                        <a href="/admin/users/<%= currentUserRow.user_id %>/manage-block" class="btn btn-outline-warning">
                          <i class="fas fa-ban"></i>
                        </a>
                      </div>
                    </td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="row mb-4">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0">
            <i class="fas fa-car me-2"></i>Recent Ride Requests
          </h5>
        </div>
        <div class="card-body">
          <% if (recentRides.length === 0) { %>
            <p class="text-muted">No recent ride requests.</p>
          <% } else { %>
            <% recentRides.forEach(ride => { %>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                  <strong><%= ride.requester_name %></strong>
                  <br><small class="text-muted"><%= ride.child_name %></small>
                </div>
                <small class="text-muted">
                  <%= new Date(ride.created_at).toLocaleDateString() %>
                </small>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0">
            <i class="fas fa-envelope me-2"></i>Recent Messages
          </h5>
        </div>
        <div class="card-body">
          <% if (recentMessages.length === 0) { %>
            <p class="text-muted">No recent messages.</p>
          <% } else { %>
            <% recentMessages.forEach(message => { %>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                  <strong><%= message.sender_name %></strong>
                  <br><small class="text-muted"><%= message.content.substring(0, 50) %>...</small>
                </div>
                <small class="text-muted">
                  <%= new Date(message.sent_at).toLocaleDateString() %>
                </small>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Trusted Groups Section -->
  <div class="row mb-4">
    <div class="col">
      <div class="card">
        <div class="card-header bg-warning text-dark">
          <h5 class="mb-0">
            <i class="fas fa-users me-2"></i>Trusted Groups (<%= trustedGroups.length %>)
          </h5>
        </div>
        <div class="card-body">
          <% if (trustedGroups.length === 0) { %>
            <div class="text-center py-4">
              <i class="fas fa-users fa-3x text-muted mb-3"></i>
              <p class="text-muted">No trusted groups found.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Group Name</th>
                    <th>Description</th>
                    <th>Creator</th>
                    <th>Members</th>
                    <th>Created</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% trustedGroups.forEach(group => { %>
                    <tr>
                      <td>
                        <strong><%= group.name %></strong>
                      </td>
                      <td>
                        <% if (group.description) { %>
                          <%= group.description %>
                        <% } else { %>
                          <span class="text-muted">No description</span>
                        <% } %>
                      </td>
                      <td>
                        <span class="badge bg-info">
                          <i class="fas fa-user me-1"></i><%= group.creator_name %>
                        </span>
                      </td>
                      <td>
                        <span class="badge bg-secondary">
                          <i class="fas fa-users me-1"></i><%= group.member_count %> members
                        </span>
                      </td>
                      <td>
                        <small class="text-muted">
                          <%= new Date(group.created_at).toLocaleDateString() %>
                        </small>
                      </td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <button class="btn btn-outline-primary edit-group-btn" 
                                  data-group-id="<%= group.id %>" 
                                  data-group-name="<%= group.name %>" 
                                  data-group-description="<%= group.description || '' %>">
                            <i class="fas fa-edit"></i>
                          </button>
                          <button class="btn btn-outline-danger delete-group-btn" 
                                  data-group-id="<%= group.id %>" 
                                  data-group-name="<%= group.name %>">
                            <i class="fas fa-trash"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Edit Group Modal -->
<div class="modal fade" id="editGroupModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fas fa-edit me-2"></i>Edit Trusted Group
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="editGroupForm" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label for="groupName" class="form-label">Group Name</label>
            <input type="text" class="form-control" id="groupName" name="name" required>
          </div>
          <div class="mb-3">
            <label for="groupDescription" class="form-label">Description</label>
            <textarea class="form-control" id="groupDescription" name="description" rows="3"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Members</label>
            <div class="row">
              <% allUsers.forEach(user => { %>
                <div class="col-md-6 mb-2">
                  <div class="form-check">
                    <input class="form-check-input member-checkbox" type="checkbox" 
                           name="members" value="<%= user.id %>" 
                           id="member<%= user.id %>">
                    <label class="form-check-label" for="member<%= user.id %>">
                      <%= user.name %> (<%= user.email %>)
                    </label>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-1"></i>Update Group
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Delete Group Modal -->
<div class="modal fade" id="deleteGroupModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title text-danger">
          <i class="fas fa-exclamation-triangle me-2"></i>Delete Trusted Group
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="deleteGroupForm" method="POST">
        <div class="modal-body">
          <p>Are you sure you want to delete the group "<span id="deleteGroupName"></span>"?</p>
          <p class="text-muted">This action cannot be undone.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">
            <i class="fas fa-trash me-1"></i>Delete Group
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
let currentGroupId = null;

// Edit group functionality
document.addEventListener('DOMContentLoaded', function() {
  // Edit group buttons
  document.querySelectorAll('.edit-group-btn').forEach(button => {
    button.addEventListener('click', function() {
      const groupId = this.getAttribute('data-group-id');
      const groupName = this.getAttribute('data-group-name');
      const groupDescription = this.getAttribute('data-group-description');
      
      currentGroupId = groupId;
      
      // Set form action
      document.getElementById('editGroupForm').action = `/admin/dashboard/trusted-groups/${groupId}/edit`;
      
      // Set form values
      document.getElementById('groupName').value = groupName;
      document.getElementById('groupDescription').value = groupDescription;
      
      // Clear all checkboxes
      document.querySelectorAll('.member-checkbox').forEach(checkbox => {
        checkbox.checked = false;
      });
      
      // Load and check current members
      fetch(`/admin/dashboard/trusted-groups/${groupId}/members`)
        .then(response => response.json())
        .then(data => {
          data.members.forEach(member => {
            const checkbox = document.getElementById(`member${member.id}`);
            if (checkbox) {
              checkbox.checked = true;
            }
          });
        })
        .catch(error => {
          console.error('Error loading group members:', error);
        });
      
      // Show modal
      new bootstrap.Modal(document.getElementById('editGroupModal')).show();
    });
  });
  
  // Delete group buttons
  document.querySelectorAll('.delete-group-btn').forEach(button => {
    button.addEventListener('click', function() {
      const groupId = this.getAttribute('data-group-id');
      const groupName = this.getAttribute('data-group-name');
      
      // Set form action and group name
      document.getElementById('deleteGroupForm').action = `/admin/dashboard/trusted-groups/${groupId}/delete`;
      document.getElementById('deleteGroupName').textContent = groupName;
      
      // Show modal
      new bootstrap.Modal(document.getElementById('deleteGroupModal')).show();
    });
  });
});
</script>

<%- include('../partials/footer1') %>