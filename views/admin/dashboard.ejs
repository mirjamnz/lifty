<!--views/admin/dashboard.ejs -->
<%- include('../partials/header1') %>
<%- include(session && session.is_admin ? '../partials/navbar2' : '../partials/navbar1') %>

<div class="container py-5">
  <h2 class="mb-4 fw-bold text-primary">🛠 Admin Dashboard</h2>

  <% if (session.success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= session.success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <% session.success = null; %>
  <% } %>
  <% if (session.error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= session.error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <% session.error = null; %>
  <% } %>

  <% if (typeof stats !== 'undefined') { %>
    <div class="row mb-4 g-3">
      <div class="col-md-2">
        <div class="card shadow-sm border-primary">
          <div class="card-body text-center">
            <h6 class="text-primary">Total Users</h6>
            <div class="fw-bold fs-4"><%= stats.total_users %></div>
            <small>Parents: <%= stats.total_parents %> | Children: <%= stats.total_children %> | Admins: <%= stats.total_admins %></small>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="card shadow-sm border-success">
          <div class="card-body text-center">
            <h6 class="text-success">Groups/Events</h6>
            <div class="fw-bold fs-4"><%= stats.total_groups %></div>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="card shadow-sm border-info">
          <div class="card-body text-center">
            <h6 class="text-info">Children</h6>
            <div class="fw-bold fs-4"><%= stats.total_children_table %></div>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="card shadow-sm border-warning">
          <div class="card-body text-center">
            <h6 class="text-warning">Active Group Members</h6>
            <div class="fw-bold fs-4"><%= stats.total_active_group_members %></div>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="card shadow-sm border-danger">
          <div class="card-body text-center">
            <h6 class="text-danger">Pending Invitations</h6>
            <div class="fw-bold fs-4"><%= stats.total_pending_invitations %></div>
            <small>Recent Signups (7d): <%= stats.recent_signups %></small>
          </div>
        </div>
      </div>
    </div>
    <div class="row mb-3">
      <div class="col-md-6 col-lg-4 col-xl-3">
        <div class="card shadow-sm border-secondary">
          <div class="card-body text-center">
            <h6 class="text-secondary mb-0">Most Active Group</h6>
            <% if (stats.most_active_group) { %>
              <span class="fw-bold"><%= stats.most_active_group %></span> (<%= stats.most_active_group_count %> members)
            <% } else { %>
              <span class="text-muted">No group data</span>
            <% } %>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-lg-8 col-xl-9 d-flex align-items-center">
        <div class="d-flex flex-wrap gap-2 w-100 justify-content-md-end justify-content-center mt-3 mt-md-0">
          <a href="/admin/organizations" class="btn btn-outline-success">🏫 Manage Organizations</a>
          <a href="/admin/groups" class="btn btn-outline-primary">👥 Manage Groups/Events</a>
           <!--  <a href="/admin/users/add" class="btn btn-outline-success">➕ Add Parent</a> -->
          <!--  <a href="/admin/children/add" class="btn btn-outline-success">➕ Add Child</a> -->
        </div>
      </div>
    </div>
  <% } %>

  <div class="row g-4">
    <!-- Parents -->
    <div class="col-lg-6">
      <h4 class="text-success">👤 Parents</h4>
      <a href="/admin/users/add" class="btn btn-success mb-3">➕ Add New Parent</a>
      <div class="table-responsive">
        <table class="table table-bordered table-sm table-striped rounded shadow-sm" id="parentsTable">
          <thead class="table-light">
            <tr>
              <th>Name <a href="#" class="sort text-dark" data-sort="name">🔽</a></th>
              <th>Email <a href="#" class="sort text-dark" data-sort="email">🔽</a></th>
              <th>Blocked? <a href="#" class="sort text-dark" data-sort="is_blocked">🔽</a></th>
              <th>Address Privacy</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length > 0) { %>
              <% users.filter(user => user.role === 'parent').forEach(user => { %>
                <tr>
                  <td class="<%= user.is_blocked ? 'blocked-user' : '' %>">
                    <%= user.name %> <%- user.is_blocked ? '<i class="fas fa-lock text-danger ms-1"></i>' : '' %>
                  </td>
                  <td class="<%= user.is_blocked ? 'blocked-user' : '' %>"><%= user.email %></td>
                  <td class="<%= user.is_blocked ? 'blocked-user' : '' %>"><%= user.is_blocked ? "Yes" : "No" %></td>
                  <td>
                    <form method="POST" action="/admin/users/<%= user.id %>/privacy" class="d-inline privacy-form" data-user-id="<%= user.id %>">
                      <input type="hidden" name="user_id" value="<%= user.id %>">
                      <div class="form-check form-switch">
                        <input class="form-check-input privacy-checkbox" type="checkbox" name="is_address_private" id="privacy_<%= user.id %>" data-user-id="<%= user.id %>" <%= (user.is_address_private == 1 || user.is_address_private === true || user.is_address_private === '1' || user.is_address_private === 'true') ? 'checked' : '' %>>
                        <label class="form-check-label" for="privacy_<%= user.id %>">
                          <i class="fas fa-eye-slash me-1"></i> Private
                        </label>
                      </div>
                      <button type="submit" class="btn btn-sm btn-outline-secondary ms-2" onclick="console.log('🔍 Submit button clicked for user', '<%= user.id %>')">Update</button>
                    </form>
                  </td>
                  <td>
                    <button class="btn btn-sm btn-warning manage-block" data-user-id="<%= user.id %>" data-blocked="<%= user.is_blocked %>" title="<%= user.is_blocked ? 'Unblock' : 'Block' %>">
                      <%= user.is_blocked ? '🔓' : '🔒' %>
                    </button>
                    <form action="/admin/users/<%= user.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete <%= user.name %>?');">
                      <button type="submit" class="btn btn-sm btn-danger" title="Delete User">🗑️</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="4" class="text-center text-muted">No parents found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Family / Whānau -->
    <div class="col-lg-6">
      <h4 class="text-success">👨‍👩‍👧‍👦 Family / Whānau</h4>
      <a href="/admin/children/add" class="btn btn-success mb-3">➕ Add New Child</a>
      <div class="table-responsive">
        <table class="table table-bordered table-sm table-striped rounded shadow-sm" id="childrenTable">
          <thead class="table-light">
            <tr>
              <th>Parents</th>
              <th>Children</th>
            </tr>
          </thead>
          <tbody>
            <% if (whanauGroups && whanauGroups.length > 0) { %>
              <% whanauGroups.forEach(group => { %>
                <tr class="<%= group.parents.some(p => p.is_blocked) || group.children.some(c => c.is_blocked) ? 'table-danger' : '' %>">
                  <td>
                    <% group.parents.forEach(parent => { %>
                      <div class="<%= parent.is_blocked ? 'blocked-user' : '' %> mb-2">
                        <div class="fw-bold fs-5 mb-1">
                          <i class="fas fa-user me-1"></i> 
                          <%= parent.name %> 
                          <% if (parent.is_blocked) { %>
                            <i class="fas fa-lock text-danger ms-1" title="Blocked"></i>
                          <% } %>
                        </div>
                        <div class="text-muted small mb-1">(<%= parent.email %>)</div>
                        <div class="btn-group btn-group-sm" role="group">
                          <button class="btn btn-sm <%= parent.is_blocked ? 'btn-success' : 'btn-warning' %> manage-block" 
                                  data-user-id="<%= parent.id %>" 
                                  data-blocked="<%= parent.is_blocked %>" 
                                  title="<%= parent.is_blocked ? 'Unblock' : 'Block' %>">
                            <%= parent.is_blocked ? '🔓 Unblock' : '🔒 Block' %>
                          </button>
                        </div>
                      </div>
                    <% }) %>
                  </td>
                  <td>
                    <% group.children.forEach(child => { %>
                      <div class="mb-2 <%= child.is_blocked ? 'blocked-user' : '' %>">
                        <span class="fw-bold fs-5">
                          <i class="fas fa-child me-1"></i> 
                          <%= child.name %>
                          <% if (child.is_blocked) { %>
                            <i class="fas fa-lock text-danger ms-1" title="Blocked"></i>
                          <% } %>
                        </span>
                        <span class="text-muted small ms-2">School: <%= child.school || 'N/A' %> <% if (child.club) { %>- Club: <%= child.club %> <% } %></span>
                        <!-- Admin: Edit Child -->
                        <a href="/admin/children/<%= child.id %>/edit" class="btn btn-outline-warning btn-sm ms-1" title="Edit Child">✏️</a>
                        <!-- Admin: Delete Child -->
                        <form method="POST" action="/admin/children/<%= child.id %>/delete" class="d-inline ms-1" onsubmit="return confirm('Are you sure you want to delete <%= child.name %>? This will also delete their user account.');">
                          <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Child">🗑️</button>
                        </form>
                        <!-- Admin: Add Parent to Child -->
                        <form method="POST" action="/admin/children/<%= child.id %>/add-parent" class="d-inline ms-2" style="display:inline-block;">
                          <input type="text" name="parent_email_or_username" class="form-control form-control-sm d-inline-block" style="width: 160px; display:inline-block;" placeholder="Add parent (email/username)" required>
                          <button type="submit" class="btn btn-outline-primary btn-sm ms-1">Add Parent</button>
                        </form>
                      </div>
                    <% }) %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="2" class="text-center text-muted">No whānau groups found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Groups / Events -->
  <div class="row mt-4">
    <div class="col-12">
      <h4 class="text-primary">👥 Groups / Events</h4>
      <div class="table-responsive">
        <table class="table table-bordered table-sm table-striped rounded shadow-sm" id="groupsTable">
          <thead class="table-light">
            <tr>
              <th>Name</th>
              <th>Schedule</th>
              <th>Location</th>
              <th>Members</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof groups !== 'undefined' && groups.length > 0) { %>
              <% groups.forEach(group => { %>
                <tr>
                  <td><%= group.name %></td>
                  <td><%= group.day_of_week %>s, <%= group.start_time %> - <%= group.end_time %></td>
                  <td><%= group.location %></td>
                  <td><%= group.group_member_count || 0 %></td>
                  <td>
                    <a href="/admin/groups/<%= group.id %>/members" class="btn btn-sm btn-outline-primary">Manage Members</a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" class="text-center text-muted">No groups found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal for Block/Unblock Management -->
<div class="modal fade" id="blockModal" tabindex="-1" aria-labelledby="blockModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="blockModalLabel">Manage Block Status</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to <strong><span id="actionText"></span></strong> <span id="userName"></span>?</p>
        <p>This will also affect associated children.</p>
        <div id="confirmationAnimation" class="text-center" style="display:none;">
          <div class="spinner-border text-warning" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <form id="blockForm" method="POST" action="">
          <input type="hidden" name="userId" id="blockUserId">
          <input type="hidden" name="action" id="blockAction">
          <button type="submit" class="btn btn-warning" id="confirmBlock">Confirm</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="/css/style.css">

<script>
  $(document).ready(function() {
    // Initialize DataTables for Organizations
    $('#organizationsTable').DataTable({
      "order": [[0, "asc"]],
      "pageLength": 10,
      "lengthMenu": [5, 10, 25, 50]
    });

    // Initialize DataTables for Parents
    $('#parentsTable').DataTable({
      "order": [[0, "asc"]],
      "pageLength": 10,
      "lengthMenu": [5, 10, 25, 50]
    });

    // Initialize DataTables for Children
    var childrenTable = $('#childrenTable').DataTable({
      "order": [[0, "asc"]], // Sort by Parent Name by default
      "pageLength": 10,
      "lengthMenu": [5, 10, 25, 50]
    });

    // Sorting functionality
    $('.sort').on('click', function(e) {
      e.preventDefault();
      const tableId = $(this).closest('table').attr('id');
      const column = $(this).data('sort');
      const table = $(`#${tableId}`).DataTable();
      const order = table.order()[0][1] === 'asc' ? 'desc' : 'asc';
      table.order([parseInt($(this).closest('th').index()), order]).draw();
      $(this).text(order === 'asc' ? '🔽' : '🔼');
    });

    // Modal for Block/Unblock
    $('.manage-block').on('click', function() {
      const userId = $(this).data('user-id');
      const blocked = $(this).data('blocked');
      const userName = $(this).closest('tr').find('td:first').text().trim().replace(/<[^>]+>/g, '');
      const action = blocked ? 'unblock' : 'block';
      $('#blockUserId').val(userId);
      $('#blockAction').val(action);
      $('#actionText').text(action);
      $('#userName').text(userName);
      $('#blockForm').attr('action', `/admin/users/${userId}/${action}`);
      $('#blockModal').modal('show');
    });

    $('#confirmBlock').on('click', function() {
      const animation = $('#confirmationAnimation');
      animation.show();
      setTimeout(() => {
        animation.hide();
      }, 1000);
    });

    // Handle privacy form submission
    /*
    $(document).on('submit', '.privacy-form', function(e) {
      console.log('🔍 Privacy form submit event triggered');
      
      try {
        const form = $(this);
        const userId = form.data('user-id');
        const checkbox = form.find('.privacy-checkbox');
        const isPrivate = checkbox.is(':checked');
        
        console.log('🔍 Privacy form submitted:', {
          userId: userId,
          isPrivate: isPrivate,
          formAction: form.attr('action'),
          formData: form.serialize(),
          formElement: form[0],
          checkboxElement: checkbox[0]
        });
        
        // Show loading state on the submit button
        const submitButton = form.find('button[type="submit"]');
        submitButton.html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Updating...').prop('disabled', true);
        
        console.log('🔍 Form submission proceeding...');
      } catch (error) {
        console.error('🔍 Error in privacy form submission:', error);
      }
    });
    */
    
    // Debug: Log when document is ready
    console.log('🔍 Document ready, privacy forms found:', $('.privacy-form').length);
    
    // Debug: Check if forms are properly bound
    $('.privacy-form').each(function(index) {
      console.log('🔍 Privacy form', index, ':', {
        action: $(this).attr('action'),
        userId: $(this).data('user-id'),
        checkbox: $(this).find('.privacy-checkbox').length
      });
    });
    
    // Debug: Test form submission manually
    $('.privacy-form button[type="submit"]').on('click', function(e) {
      console.log('🔍 Submit button clicked:', {
        button: this,
        form: $(this).closest('form')[0],
        formAction: $(this).closest('form').attr('action')
      });
    });
  });
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

<%- include('../partials/footer1') %>