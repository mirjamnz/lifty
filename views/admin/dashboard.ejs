<!--views/admin/dashboard.ejs -->
<%- include('../partials/header1') %>
<%- include(session && session.is_admin ? '../partials/navbar2' : '../partials/navbar1') %>

<div class="container py-5">
  <h2 class="mb-4 fw-bold text-primary">🛠 Admin Dashboard</h2>

  <div class="row">
    <!-- Organizations -->
    <div class="col-md-6">
      <h4 class="text-success">🏫 Organizations</h4>
      <a href="/admin/organizations/add" class="btn btn-success mb-3">➕ Add New Organization</a>
      <div class="table-responsive">
        <table class="table table-bordered table-sm table-striped rounded shadow-sm" id="organizationsTable">
          <thead class="table-light">
            <tr>
              <th>Name <a href="#" class="sort text-dark" data-sort="name">🔽</a></th>
              <th>Type <a href="#" class="sort text-dark" data-sort="type">🔽</a></th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (organizations && organizations.length > 0) { %>
              <% organizations.forEach(org => { %>
                <tr>
                  <td><%= org.name %></td>
                  <td><%= org.type %></td>
                  <td>
                    <form action="/admin/organizations/<%= org.id %>/edit" method="GET" style="display:inline;">
                      <button type="submit" class="btn btn-sm btn-outline-success" title="Edit Organization">✏️</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="3" class="text-center text-muted">No organizations found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Parents -->
    <div class="col-md-6">
      <h4 class="text-success">👤 Parents</h4>
      <a href="/admin/users/add" class="btn btn-success mb-3">➕ Add New Parent</a>
      <div class="table-responsive">
        <table class="table table-bordered table-sm table-striped rounded shadow-sm" id="parentsTable">
          <thead class="table-light">
            <tr>
              <th>Name <a href="#" class="sort text-dark" data-sort="name">🔽</a></th>
              <th>Email <a href="#" class="sort text-dark" data-sort="email">🔽</a></th>
              <th>Blocked? <a href="#" class="sort text-dark" data-sort="is_blocked">🔽</a></th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length > 0) { %>
              <% users.filter(user => user.role === 'parent').forEach(user => { %>
                <tr>
                  <td class="<%= user.is_blocked ? 'blocked-user' : '' %>">
                    <%= user.name %> <%- user.is_blocked ? '<i class="fas fa-lock text-danger ms-1"></i>' : '' %>
                  </td>
                  <td class="<%= user.is_blocked ? 'blocked-user' : '' %>"><%= user.email %></td>
                  <td class="<%= user.is_blocked ? 'blocked-user' : '' %>"><%= user.is_blocked ? "Yes" : "No" %></td>
                  <td>
                    <button class="btn btn-sm btn-warning manage-block" data-user-id="<%= user.id %>" data-blocked="<%= user.is_blocked %>" title="<%= user.is_blocked ? 'Unblock' : 'Block' %>">
                      <%= user.is_blocked ? '🔓' : '🔒' %>
                    </button>
                    <form action="/admin/users/<%= user.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete <%= user.name %>?');">
                      <button type="submit" class="btn btn-sm btn-danger" title="Delete User">🗑️</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="4" class="text-center text-muted">No parents found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Children -->
    <div class="col-md-12 mt-4">
      <h4 class="text-success">👶 Children</h4>
      <a href="/admin/children/add" class="btn btn-success mb-3">➕ Add New Child</a>
      <div class="table-responsive">
        <table class="table table-bordered table-sm table-striped rounded shadow-sm" id="childrenTable">
          <thead class="table-light">
            <tr>
              <th>Parent Name <a href="#" class="sort text-dark" data-sort="parent_name">🔽</a></th>
              <th>Children Details</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && children && users.length > 0) { %>
              <% users.filter(user => user.role === 'parent').forEach(parent => { %>
                <% const parentChildren = children.filter(child => child.user_id === parent.id); %>
                <% if (parentChildren.length > 0) { %>
                  <tr>
                    <td class="<%= parentChildren.some(child => child.is_blocked) ? 'blocked-user' : '' %>">
                      <%= parent.name %> <%- parentChildren.some(child => child.is_blocked) ? '<i class="fas fa-lock text-danger ms-1"></i>' : '' %>
                    </td>
                    <td>
                      <div class="card shadow-sm mb-3">
                        <div class="card-header bg-light" id="heading<%= parent.id %>">
                          <h5 class="mb-0">
                            <button class="btn btn-link text-dark text-decoration-none w-100 text-start collapsed" data-bs-toggle="collapse" data-bs-target="#collapse<%= parent.id %>" aria-expanded="false" aria-controls="collapse<%= parent.id %>">
                              <%= parentChildren.length %> Child<%= parentChildren.length > 1 ? 'ren' : '' %> <i class="fas fa-chevron-down ms-2"></i>
                            </button>
                          </h5>
                        </div>
                        <div id="collapse<%= parent.id %>" class="collapse" aria-labelledby="heading<%= parent.id %>" data-bs-parent="#childrenTable">
                          <div class="card-body p-3">
                            <% parentChildren.forEach(child => { %>
                              <div class="d-flex justify-content-between align-items-center mb-2 p-2 bg-white rounded" style="width: 100%;">
                                <span class="<%= child.is_blocked ? 'blocked-user' : '' %>">
                                  <%= child.name %> - School: <%= child.school || 'N/A' %> <% if (child.club) { %>- Club: <%= child.club %> <% } %>
                                  <%- child.is_blocked ? '<i class="fas fa-lock text-danger ms-1"></i>' : '' %>
                                </span>
                              </div>
                            <% }); %>
                          </div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="d-flex flex-column align-items-start">
                        <button class="btn btn-sm btn-warning manage-block mb-2" data-user-id="<%= parent.id %>" data-blocked="<%= parent.is_blocked %>" title="<%= parent.is_blocked ? 'Unblock' : 'Block' %>">
                          <%= parent.is_blocked ? '🔓' : '🔒' %>
                        </button>
                        <% parentChildren.forEach(child => { %>
                          <div class="d-flex mb-2" style="gap: 5px;">
                            <form action="/admin/children/<%= child.id %>/edit" method="GET" style="display:inline;">
                              <button type="submit" class="btn btn-sm btn-outline-success" title="Edit <%= child.name %>">✏️ <%= child.name %></button>
                            </form>
                            <form action="/admin/children/<%= child.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete <%= child.name %>?');">
                              <button type="submit" class="btn btn-sm btn-danger" title="Delete <%= child.name %>">🗑️ <%= child.name %></button>
                            </form>
                          </div>
                        <% }); %>
                      </div>
                    </td>
                  </tr>
                <% } %>
              <% }); %>
            <% } else { %>
              <tr><td colspan="3" class="text-center text-muted">No children or users found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal for Block/Unblock Management -->
<div class="modal fade" id="blockModal" tabindex="-1" aria-labelledby="blockModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="blockModalLabel">Manage Block Status</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to <strong><span id="actionText"></span></strong> <span id="userName"></span>?</p>
        <p>This will also affect associated children.</p>
        <div id="confirmationAnimation" class="text-center" style="display:none;">
          <div class="spinner-border text-warning" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <form id="blockForm" method="POST" action="">
          <input type="hidden" name="userId" id="blockUserId">
          <input type="hidden" name="action" id="blockAction">
          <button type="submit" class="btn btn-warning" id="confirmBlock">Confirm</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="/css/style.css">

<script>
  $(document).ready(function() {
    // Initialize DataTables for Organizations
    $('#organizationsTable').DataTable({
      "order": [[0, "asc"]],
      "pageLength": 10,
      "lengthMenu": [5, 10, 25, 50]
    });

    // Initialize DataTables for Parents
    $('#parentsTable').DataTable({
      "order": [[0, "asc"]],
      "pageLength": 10,
      "lengthMenu": [5, 10, 25, 50]
    });

    // Initialize DataTables for Children
    $('#childrenTable').DataTable({
      "order": [[0, "asc"]], // Sort by Parent Name by default
      "pageLength": 10,
      "lengthMenu": [5, 10, 25, 50],
      "columnDefs": [
        { "orderable": false, "targets": 2 } // Disable sorting on Actions column
      ]
    });

    // Sorting functionality
    $('.sort').on('click', function(e) {
      e.preventDefault();
      const tableId = $(this).closest('table').attr('id');
      const column = $(this).data('sort');
      const table = $(`#${tableId}`).DataTable();
      const order = table.order()[0][1] === 'asc' ? 'desc' : 'asc';
      table.order([parseInt($(this).closest('th').index()), order]).draw();
      $(this).text(order === 'asc' ? '🔽' : '🔼');
    });

    // Modal for Block/Unblock
    $('.manage-block').on('click', function() {
      const userId = $(this).data('user-id');
      const blocked = $(this).data('blocked');
      const userName = $(this).closest('tr').find('td:first').text().trim().replace(/<[^>]+>/g, '');
      const action = blocked ? 'unblock' : 'block';
      $('#blockUserId').val(userId);
      $('#blockAction').val(action);
      $('#actionText').text(action);
      $('#userName').text(userName);
      $('#blockForm').attr('action', `/admin/users/${userId}/${action}`);
      $('#blockModal').modal('show');
    });

    $('#confirmBlock').on('click', function() {
      const animation = $('#confirmationAnimation');
      animation.show();
      setTimeout(() => {
        animation.hide();
      }, 1000);
    });
  });
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

<%- include('../partials/footer1') %>