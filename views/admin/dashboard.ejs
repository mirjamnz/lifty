<!--views/admin/dashboard.ejs -->
<!DOCTYPE html>
<%- include('../partials/header1') %>
<%- include(session && session.is_admin ? '../partials/navbar2' : '../partials/navbar1') %>

<div class="container py-5">
  <h2 class="mb-4 fw-bold">🛠 Admin Dashboard</h2>

  <div class="row">
    <!-- Organizations -->
    <div class="col-md-6">
      <h4>🏫 Organizations</h4>
      <a href="/admin/organizations/add" class="btn btn-primary mb-3">➕ Add New Organization</a>
      <table class="table table-bordered table-sm table-striped" id="organizationsTable">
        <thead>
          <tr>
            <th>Name <a href="#" class="sort" data-sort="name">🔽</a></th>
            <th>Type <a href="#" class="sort" data-sort="type">🔽</a></th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (organizations && organizations.length > 0) { %>
            <% organizations.forEach(org => { %>
              <tr>
                <td><%= org.name %></td>
                <td><%= org.type %></td>
                <td>
                  <form action="/admin/organizations/<%= org.id %>/edit" method="GET" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Edit Organization">✏️</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="3">No organizations found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Parents -->
    <div class="col-md-6">
      <h4>👤 Parents</h4>
      <a href="/admin/users/add" class="btn btn-primary mb-3">➕ Add New Parent</a>
      <table class="table table-bordered table-sm table-striped" id="parentsTable">
        <thead>
          <tr>
            <th>Name <a href="#" class="sort" data-sort="name">🔽</a></th>
            <th>Email <a href="#" class="sort" data-sort="email">🔽</a></th>
            <th>Blocked? <a href="#" class="sort" data-sort="is_blocked">🔽</a></th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (users && users.length > 0) { %>
            <% users.filter(user => user.role === 'parent').forEach(user => { %>
              <tr>
                <td<%= user.is_blocked ? ' style="color: red; text-decoration: line-through;"' : '' %>><%= user.name %></td>
                <td<%= user.is_blocked ? ' style="color: red; text-decoration: line-through;"' : '' %>><%= user.email %></td>
                <td<%= user.is_blocked ? ' style="color: red; text-decoration: line-through;"' : '' %>><%= user.is_blocked ? "Yes" : "No" %></td>
                <td>
                  <form action="/admin/users/<%= user.id %>/block" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-warning" title="<%= user.is_blocked ? 'Unblock' : 'Block' %>"><%= user.is_blocked ? '🔓' : '🔒' %></button>
                  </form>
                  <form action="/admin/users/<%= user.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete <%= user.name %>?');">
                    <button type="submit" class="btn btn-sm btn-danger" title="Delete User">🗑️</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="4">No parents found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Children -->
    <div class="col-md-12 mt-4">
      <h4>👶 Children</h4>
      <a href="/admin/children/add" class="btn btn-primary mb-3">➕ Add New Child</a>
      <table class="table table-bordered table-sm table-striped" id="childrenTable">
        <thead>
          <tr>
            <th>Parent Name <a href="#" class="sort" data-sort="parent_name">🔽</a></th>
            <th>Child Name <a href="#" class="sort" data-sort="name">🔽</a></th>
            <th>School <a href="#" class="sort" data-sort="school">🔽</a></th>
            <th>Club <a href="#" class="sort" data-sort="club">🔽</a></th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (users && children && users.length > 0 && children.length > 0) { %>
            <% users.filter(user => user.role === 'parent').forEach(parent => { %>
              <% const parentChildren = children.filter(child => child.user_id === parent.id); %>
              <% if (parentChildren.length > 0) { %>
                <% parentChildren.forEach(child => { %>
                  <tr>
                    <td<%= child.is_blocked ? ' style="color: red; text-decoration: line-through;"' : '' %>><%= parent.name %></td>
                    <td<%= child.is_blocked ? ' style="color: red; text-decoration: line-through;"' : '' %>><%= child.name %></td>
                    <td<%= child.is_blocked ? ' style="color: red; text-decoration: line-through;"' : '' %>><%= child.school || 'N/A' %></td>
                    <td<%= child.is_blocked ? ' style="color: red; text-decoration: line-through;"' : '' %>><%= child.club || 'N/A' %></td>
                    <td>
                      <form action="/admin/children/<%= child.id %>/edit" method="GET" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Edit Child">✏️</button>
                      </form>
                      <form action="/admin/children/<%= child.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete <%= child.name %>?');">
                        <button type="submit" class="btn btn-sm btn-danger" title="Delete Child">🗑️</button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            <% }); %>
          <% } else { %>
            <tr><td colspan="5">No children or users found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">

<script>
  $(document).ready(function() {
    // Initialize DataTables for Organizations
    $('#organizationsTable').DataTable({
      "order": [[0, "asc"]],
      "pageLength": 10,
      "lengthMenu": [5, 10, 25, 50]
    });

    // Initialize DataTables for Parents
    $('#parentsTable').DataTable({
      "order": [[0, "asc"]],
      "pageLength": 10,
      "lengthMenu": [5, 10, 25, 50]
    });

    // Initialize DataTables for Children
    $('#childrenTable').DataTable({
      "order": [[1, "asc"]], // Sort by Child Name by default
      "pageLength": 10,
      "lengthMenu": [5, 10, 25, 50]
    });

    // Sorting functionality
    $('.sort').on('click', function(e) {
      e.preventDefault();
      const tableId = $(this).closest('table').attr('id');
      const column = $(this).data('sort');
      const table = $(`#${tableId}`).DataTable();
      const order = table.order()[0][1] === 'asc' ? 'desc' : 'asc';
      table.order([parseInt($(this).closest('th').index()), order]).draw();
      $(this).text(order === 'asc' ? '🔽' : '🔼');
    });
  });
</script>

<%- include('../partials/footer1') %>