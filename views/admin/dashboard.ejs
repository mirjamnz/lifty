<!--views/admin/dashboard.ejs -->
<%- include('../partials/header1') %>
<%- include(session && session.is_admin ? '../partials/navbar2' : '../partials/navbar1') %>


<div class="container py-5">
  <h2 class="mb-4 fw-bold">🛠 Admin Dashboard</h2>

  <div class="row">
    <!-- Organizations -->
    <div class="col-md-6">
      <h4>🏫 Organizations</h4>
      <table class="table table-bordered table-sm table-striped">
        <thead><tr><th>Name</th><th>Type</th><th>Actions</th></tr></thead>
        <tbody>
          <% organizations.forEach(org => { %>
            <tr>
              <td><%= org.name %></td>
              <td><%= org.type %></td>
              <td>
                <a href="/admin/organizations/<%= org.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Users -->
    <div class="col-md-6">
      <h4>👤 Users</h4>
      <table class="table table-bordered table-sm table-striped">
        <thead><tr><th>Name</th><th>Email</th><th>Blocked?</th><th>Actions</th></tr></thead>
        <tbody>
          <% users.forEach(user => { %>
            <tr>
              <td><%= user.name %></td>
              <td><%= user.email %></td>
              <td><%= user.is_blocked ? "Yes" : "No" %></td>
              <td>
                <form action="/admin/users/<%= user.id %>/block" method="POST" style="display:inline;">
                  <button class="btn btn-sm btn-warning"><%= user.is_blocked ? "Unblock" : "Block" %></button>
                </form>
                <form action="/admin/users/<%= user.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure?');">
                  <button class="btn btn-sm btn-danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer1') %>