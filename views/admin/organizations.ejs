<%- include('../partials/header1') %>
<%- include(session && session.is_admin ? '../partials/navbar2' : '../partials/navbar1') %>

<div class="container py-5">
  <h2 class="mb-4 fw-bold text-success">🏫 Organizations</h2>
  <!-- Popularity Chart -->
  <div class="mb-4">
    <h5 class="fw-bold">Most Popular Places (by number of children linked)</h5>
    <canvas id="orgPopularityChart" height="120"></canvas>
  </div>
  <a href="/admin/organizations/add" class="btn btn-success mb-3">➕ Add New Organization</a>
  <div class="table-responsive">
    <table class="table table-bordered table-sm table-striped rounded shadow-sm" id="organizationsTable">
      <thead class="table-light">
        <tr>
          <th>Name</th>
          <th>Type</th>
          <th>Address</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (organizations && organizations.length > 0) { %>
          <% organizations.forEach(org => { %>
            <tr>
              <td><%= org.name %></td>
              <td><%= org.type %></td>
              <td><%= org.address %></td>
              <td>
                <form action="/admin/organizations/<%= org.id %>/edit" method="GET" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-outline-success" title="Edit Organization">✏️</button>
                </form>
                <form action="/admin/organizations/<%= org.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete <%= org.name %>?');">
                  <button type="submit" class="btn btn-sm btn-danger" title="Delete Organization">🗑️</button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="4" class="text-center text-muted">No organizations found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer1') %>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const data = <%- JSON.stringify(orgPopularityData || []) %>;
    if (data.length > 0) {
      const ctx = document.getElementById('orgPopularityChart').getContext('2d');
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: data.map(d => d.name),
          datasets: [{
            label: 'Number of Children',
            data: data.map(d => d.count),
            backgroundColor: 'rgba(54, 162, 235, 0.7)',
            borderColor: 'rgba(54, 162, 235, 1)',
            borderWidth: 1
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { display: false },
            title: { display: false }
          },
          scales: {
            y: { beginAtZero: true, ticks: { precision:0 } }
          }
        }
      });
    }
  });
</script> 