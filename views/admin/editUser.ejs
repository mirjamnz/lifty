<%- include('../partials/header1') %>
<%- include(session && session.is_admin ? '../partials/navbar2' : '../partials/navbar1') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0">Edit User Details & Affiliations</h4>
        </div>
        <div class="card-body">
          <h5 class="mb-3">
            <span class="fw-bold"><%= user.name %></span> <span class="badge bg-secondary"><%= user.email %></span><br>
            <small class="text-muted">Address: <%= user.home_address || '—' %></small>
            <% if(user.is_blocked){ %>
              <span class="badge bg-danger ms-2">Blocked</span>
            <% } %>
            <form action="/admin/users/<%= user.id %>/<%= user.is_blocked? 'unblock':'block' %>" method="POST" style="display:inline;">
              <button type="submit" class="btn btn-sm btn-outline-warning ms-2"><i class="fas fa-ban"></i> <%= user.is_blocked? 'Unblock':'Block' %></button>
            </form>
          </h5>

          <% if (user.role === 'child' && parents && parents.length>0) { %>
            <div class="mb-3">
              <strong>Linked Parents:</strong>
              <ul class="list-group list-group-flush">
                <% parents.forEach(p=>{ %>
                  <li class="list-group-item px-0 d-flex justify-content-between align-items-center"><%= p.name %> <small class="text-muted">(<%= p.email %>)</small>
                    <form action="/admin/children/<%= user.child_profile_id %>/unlink-parent/<%= p.id %>" method="POST" onsubmit="return confirm('Remove parent <%= p.name %>?');">
                      <button class="btn btn-sm btn-outline-danger"><i class="fas fa-unlink"></i></button>
                    </form>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% } %>

          <% if (user.role !== 'child') { %>
            <!-- Mockup: Background checks -->
            <div class="mb-4">
              <h6 class="text-primary">Background Checks (mockup)</h6>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" disabled id="driverLicenseVerified">
                <label class="form-check-label" for="driverLicenseVerified">Driver License verified</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" disabled id="policeVetted">
                <label class="form-check-label" for="policeVetted">Police vetted</label>
              </div>
              <small class="text-muted">(Admin functionality coming soon)</small>
            </div>
          <% } %>
          <form method="POST" action="/admin/users/<%= user.id %>/affiliations" id="editUserForm">
            <!-- Address -->
            <div class="mb-3">
              <label for="homeAddress" class="form-label">Home Address</label>
              <input type="text" class="form-control" id="homeAddress" name="home_address" value="<%= user.home_address || '' %>" placeholder="Enter address...">
            </div>

            <!-- Affiliations Section -->
            <h6 class="mt-4">Affiliations</h6>
            <div class="mb-2">
              <input type="text" class="form-control" id="orgSearch" placeholder="Search organizations..." autocomplete="on">
              <div id="orgSuggestions" class="position-absolute bg-white border rounded shadow-sm w-100" style="display:none; max-height:200px; overflow-y:auto; z-index:1000;"></div>
            </div>
            <div id="selectedOrgs" class="d-flex flex-wrap mb-3">
              <% affiliations.forEach(a=>{ %>
                <% const org = organizations.find(o=>o.id===a.organization_id) || {id:a.organization_id, name:a.organization_id}; %>
                <span class="badge bg-info text-dark m-1" data-id="<%= org.id %>">
                  <%= org.name %>
                  <button type="button" class="btn-close btn-close-white btn-sm ms-1 remove-org" aria-label="Remove"></button>
                  <input type="hidden" name="organization_ids" value="<%= org.id %>">
                </span>
              <% }) %>
            </div>

            <div class="d-flex justify-content-between mt-4">
              <a href="/admin/users" class="btn btn-outline-secondary">Back to Users</a>
              <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer1') %> 

<script>
// === Affiliations search/pill logic ===
(function(){
  const searchInput = document.getElementById('orgSearch');
  const suggestions = document.getElementById('orgSuggestions');
  const selectedWrap = document.getElementById('selectedOrgs');

  if(!searchInput) return;

  let debounce;
  searchInput.addEventListener('input', ()=>{
    clearTimeout(debounce);
    const q=searchInput.value.trim();
    if(q.length<2){ suggestions.style.display='none'; return; }
    debounce=setTimeout(()=>fetch(`/organizations/api/search?q=${encodeURIComponent(q)}`)
      .then(r=>r.json())
      .then(arr=>{
        if(!arr.length){ suggestions.style.display='none'; return; }
        suggestions.innerHTML = arr.map(o=>`<div class="list-group-item list-group-item-action" data-id="${o.id}" data-name="${o.name}">${o.name}${o.address?`<br><small class='text-muted'>${o.address}</small>`:''}</div>`).join('');
        suggestions.style.display='block';
      }).catch(()=>{ suggestions.style.display='none'; }),300);
  });

  suggestions.addEventListener('click',e=>{
    const item=e.target.closest('[data-id]');
    if(!item) return;
    const id=item.dataset.id, name=item.dataset.name;
    if(selectedWrap.querySelector(`span[data-id="${id}"]`)) return;
    const badge=document.createElement('span');
    badge.className='badge bg-info text-dark m-1';
    badge.dataset.id=id;
    badge.innerHTML=`${name} <button type="button" class="btn-close btn-close-white btn-sm ms-1 remove-org" aria-label="Remove"></button>`;
    const hidden=document.createElement('input');
    hidden.type='hidden';
    hidden.name='organization_ids';
    hidden.value=id;
    badge.appendChild(hidden);
    selectedWrap.appendChild(badge);
    suggestions.style.display='none';
    searchInput.value='';
  });

  selectedWrap.addEventListener('click',e=>{
    if(e.target.classList.contains('remove-org')){
      e.target.closest('span[data-id]').remove();
    }
  });
})();
</script>