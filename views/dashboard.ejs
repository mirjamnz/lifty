  <!-- Wizard JS now always included -->
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    // Add Child Only Mode
    let addChildOnlyMode = false;

    // Wizard Modal Initialization
    if (document.getElementById('profileWizardModal')) {
      console.log('Profile wizard modal found, initializing...');
      let wizardStep = 1;
      const totalSteps = 2; // Simplified to 2 steps

      function showStep(step) {
        for (let i = 1; i <= totalSteps; i++) {
          document.getElementById('wizard-step-' + i).classList.toggle('d-none', i !== step);
        }
        document.getElementById('wizard-back-btn').style.display = step === 1 ? 'none' : '';
        document.getElementById('wizard-next-btn').classList.toggle('d-none', step === totalSteps);
        document.getElementById('wizard-finish-btn').classList.toggle('d-none', step !== totalSteps);
        
        // Auto-add child entry when moving to step 2
        if (step === 2) {
          const childrenList = document.getElementById('children-list');
          if (childrenList.children.length === 0) {
            const template = document.getElementById('child-entry-template').firstElementChild.cloneNode(true);
            template.querySelector('.remove-child-btn').onclick = function() {
              template.remove();
            };
            childrenList.appendChild(template);
          }
        }
      }

      function showWizardError(msg) {
        let err = document.getElementById('wizard-error-msg');
        if (!err) {
          err = document.createElement('div');
          err.id = 'wizard-error-msg';
          err.className = 'alert alert-danger';
          err.style.marginBottom = '10px';
          document.querySelector('#wizard-step-' + wizardStep + ' form').prepend(err);
        }
        err.textContent = msg;
      }

      function clearWizardError() {
        const err = document.getElementById('wizard-error-msg');
        if (err) err.remove();
      }

      // Add Quit button handler
      const wizardQuitBtn = document.getElementById('wizard-quit-btn');
      if (wizardQuitBtn) {
        wizardQuitBtn.onclick = async function() {
          const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('profileWizardModal'));
          modal.hide();
        };
      }

      // Wizard finish button handler for both add child only mode and profile completion
      const wizardFinishBtn = document.getElementById('wizard-finish-btn');
      if (wizardFinishBtn) {
        wizardFinishBtn.onclick = async function() {
          console.log('🧙‍♂️ Wizard: Finish button clicked! addChildOnlyMode:', addChildOnlyMode);
          
          if (window.addChildOnlyMode) {
            // Add Child Only Mode logic
            const childrenList = document.getElementById('children-list');
            const childEntries = Array.from(childrenList.querySelectorAll('.child-entry'));
            if (childEntries.length === 0) {
              showWizardError('Please add at least one child.');
              return;
            }
            const children = [];
            for (const entry of childEntries) {
              const name = entry.querySelector('.child-name-input').value.trim();
              const org_id = entry.querySelector('.child-org-select').value;
              const club = entry.querySelector('.child-club-input').value.trim();
              const username = entry.querySelector('.child-username-input').value.trim();
              const password = entry.querySelector('.child-password-input').value.trim();
              if (!name || !org_id || !username || !password) {
                showWizardError('Each child must have a name, organization, username, and password.');
                return;
              }
              children.push({
                name,
                org_id: Number(org_id),
                club,
                username,
                password,
                parent_id: <%= session.userId %>
              });
            }
            try {
              const resp = await fetch('/api/profile/children', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ children })
              });
              const data = await resp.json();
              if (!resp.ok || !data.success) {
                showWizardError(data.error || 'Failed to save children. Please try again.');
                return;
              }
              // Success: hide modal and reload page
              console.log('🧙‍♂️ Wizard: Add Child Only Mode - Children saved successfully!');
              const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('profileWizardModal'));
              modal.hide();
              window.location.reload();
            } catch (err) {
              showWizardError('Network error. Please try again.');
              return;
            }
          } else {
            // Profile Completion Mode logic (Step 2 - Children)
            console.log('🧙‍♂️ Wizard: Processing profile completion finish...');
            clearWizardError();
            const childrenList = document.getElementById('children-list');
            const childEntries = Array.from(childrenList.querySelectorAll('.child-entry'));
            if (childEntries.length === 0) {
              showWizardError('Please add at least one child.');
              return;
            }
            const children = [];
            for (const entry of childEntries) {
              const name = entry.querySelector('.child-name-input').value.trim();
              const org_id = entry.querySelector('.child-org-select').value;
              const club = entry.querySelector('.child-club-input').value.trim();
              const username = entry.querySelector('.child-username-input').value.trim();
              const password = entry.querySelector('.child-password-input').value.trim();
              if (!name || !org_id || !username || !password) {
                showWizardError('Each child must have a name, organization, username, and password.');
                return;
              }
              children.push({
                name,
                org_id: Number(org_id),
                club,
                username,
                password,
                parent_id: <%= session.userId %>
              });
            }
            try {
              console.log('🧙‍♂️ Wizard: About to send API call...');
              const requestBody = JSON.stringify({ children });
              
              const resp = await fetch('/api/profile/children', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: requestBody
              });
              
              const data = await resp.json();
              
              if (!resp.ok || !data.success) {
                console.log('🧙‍♂️ Wizard: API call failed!');
                showWizardError(data.error || 'Failed to save children. Please try again.');
                return;
              }
              console.log('🧙‍♂️ Wizard: Children saved successfully!');
              
              // Mark profile as completed
              console.log('🧙‍♂️ Wizard: Marking profile as completed...');
              const completeResp = await fetch('/api/profile/complete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
              });
              
              if (!completeResp.ok) {
                console.log('🧙‍♂️ Wizard: Failed to mark profile as completed, but continuing...');
              } else {
                console.log('🧙‍♂️ Wizard: Profile marked as completed successfully!');
              }
              
              // Complete the wizard and reload the page
              console.log('🧙‍♂️ Wizard: Completing wizard and reloading page');
              const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('profileWizardModal'));
              modal.hide();
              window.location.reload();
              return;
            } catch (err) {
              console.error('🧙‍♂️ Wizard: Error saving children:', err);
              showWizardError('Network error. Please try again.');
              return;
            }
          }
        };
      }

      // Wizard button event listeners
      document.getElementById('wizard-next-btn').onclick = async function() {
        console.log('🧙‍♂️ Wizard: Next button clicked! Current step:', wizardStep);
        if (wizardStep === 1) {
          clearWizardError();
          const address = document.getElementById('wizard_home_address').value.trim();
          const lat = document.getElementById('wizard_home_lat').value;
          const lng = document.getElementById('wizard_home_lng').value;
          const isPrivate = document.getElementById('wizard_is_address_private').checked;
          if (!address || !lat || !lng) {
            showWizardError('Please select a valid address from the dropdown.');
            return;
          }
          try {
            const resp = await fetch('/api/profile/address', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ home_address: address, home_lat: lat, home_lng: lng, is_address_private: isPrivate })
            });
            const data = await resp.json();
            if (!resp.ok || !data.success) {
              showWizardError(data.error || 'Failed to save address. Please try again.');
              return;
            }
          } catch (err) {
            showWizardError('Network error. Please try again.');
            return;
          }
        }
        
        // Only advance to next step if not on the final step
        if (wizardStep < totalSteps) {
          wizardStep++;
          console.log('🧙‍♂️ Wizard: Advancing to step:', wizardStep);
          showStep(wizardStep);
        }
      };

      document.getElementById('wizard-back-btn').onclick = function() {
        if (wizardStep > 1) {
          wizardStep--;
          showStep(wizardStep);
        }
      };

      document.getElementById('wizard-skip-btn').onclick = async function() {
        try {
          const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('profileWizardModal'));
          modal.hide();
          window.location.reload();
        } catch (err) {
          console.error('Error skipping wizard:', err);
          showWizardError('Network error. Please try again.');
        }
      };

      document.getElementById('add-child-btn').onclick = function() {
        const template = document.getElementById('child-entry-template').firstElementChild.cloneNode(true);
        template.querySelector('.remove-child-btn').onclick = function() {
          template.remove();
        };
        document.getElementById('children-list').appendChild(template);
      };

      // Initialize the modal for new users (only show automatically if profile is not completed)
      try {
        const wizardModal = new bootstrap.Modal(document.getElementById('profileWizardModal'), {
          backdrop: 'static',
          keyboard: false
        });
        showStep(1);
        console.log('Wizard modal initialized');
        
        // Only show the modal automatically for new users (profile_completed = 0)
        <% if (!user.profile_completed) { %>
          wizardModal.show();
          console.log('Wizard modal shown automatically for new user');
        <% } else { %>
          console.log('Wizard modal initialized but not shown (user profile completed)');
        <% } %>
      } catch (e) {
        console.error('Error initializing wizard modal:', e);
      }
    }
  });
  </script>
  <!-- End wizard JS -->

  <!-- Add Child Button Handler - Always Loaded (not conditional) -->
  <script>
  // Open Add Child Wizard button handler - wait for DOM to be ready
  console.log('🧙‍♂️ Wizard: Script starting, setting up DOM ready listener...');
  document.addEventListener('DOMContentLoaded', function() {
    console.log('🧙‍♂️ Wizard: DOM loaded, looking for openAddChildWizard button...');
    const openAddChildWizardBtn = document.getElementById('openAddChildWizard');
    console.log('🧙‍♂️ Wizard: openAddChildWizard button found:', openAddChildWizardBtn);
    if (openAddChildWizardBtn) {
      console.log('🧙‍♂️ Wizard: Setting up click handler for openAddChildWizard button');
      openAddChildWizardBtn.onclick = function() {
        console.log('🧙‍♂️ Wizard: Add Child button clicked!');
        // Set global variable for add child only mode
        window.addChildOnlyMode = true;
        console.log('🧙‍♂️ Wizard: Creating modal instance...');
        const wizardModal = new bootstrap.Modal(document.getElementById('profileWizardModal'), {
          backdrop: 'static',
          keyboard: false
        });
        console.log('🧙‍♂️ Wizard: Modal instance created, showing modal...');
        wizardModal.show();
        console.log('🧙‍♂️ Wizard: Modal show() called');
        // Only show step 2
        document.getElementById('wizard-step-1').classList.add('d-none');
        document.getElementById('wizard-step-2').classList.remove('d-none');
        document.getElementById('wizard-back-btn').style.display = 'none';
        document.getElementById('wizard-skip-btn').style.display = 'none';
        document.getElementById('wizard-next-btn').style.display = 'none';
        console.log('🧙‍♂️ Wizard: Setting up Finish button visibility...');
        const finishBtn = document.getElementById('wizard-finish-btn');
        console.log('🧙‍♂️ Wizard: Finish button element:', finishBtn);
        if (finishBtn) {
          finishBtn.classList.remove('d-none');
          finishBtn.textContent = 'Add Child';
          finishBtn.style.display = 'inline-block';
        }
        document.getElementById('profileWizardLabel').textContent = 'Add a Child';
        
        // Clear children-list and add one child entry by default
        const childrenList = document.getElementById('children-list');
        childrenList.innerHTML = '';
        const template = document.getElementById('child-entry-template').firstElementChild.cloneNode(true);
        template.querySelector('.remove-child-btn').onclick = function() {
          template.remove();
        };
        childrenList.appendChild(template);
      };
      console.log('🧙‍♂️ Wizard: Click handler attached successfully');
    } else {
      console.log('🧙‍♂️ Wizard: ERROR - openAddChildWizard button not found!');
    }
  });
  </script>

