  <!-- Dashboard Calendar Initialization -->
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    console.log('Dashboard Calendar - Starting FullCalendar initialization');
    
    // Debug: Check if FullCalendar is available
    if (typeof FullCalendar === 'undefined') {
      console.error('FullCalendar is not defined! Check if the CDN loaded properly.');
      return;
    }
    console.log('FullCalendar library loaded successfully:', FullCalendar);
    
    // Debug: Check if calendar container exists
    const calendarEl = document.getElementById('calendar');
    if (!calendarEl) {
      console.warn('Calendar container element not found - this is normal if not on dashboard page');
      return;
    }
    console.log('Calendar container found:', calendarEl);
    
    // Debug: Check calendar events data
    const calendarEvents = <%- JSON.stringify(calendarEvents || []) %>;
    console.log('Dashboard calendar events data:', calendarEvents);
    console.log('Number of events:', calendarEvents.length);
    
    // Check if events have valid dates
    calendarEvents.forEach((event, index) => {
      console.log(`Dashboard Event ${index}:`, {
        id: event.id,
        title: event.title,
        start: event.start,
        startType: typeof event.start,
        startValid: event.start ? new Date(event.start).toString() : 'INVALID',
        startParsed: event.start ? new Date(event.start) : null
      });
    });
    
    try {
      // Initialize FullCalendar for dashboard
      const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        headerToolbar: {
          left: 'prev,next today',
          center: 'title',
          right: 'dayGridMonth,timeGridWeek,listWeek'
        },
        height: 350, // Fixed height for sidebar
        timeZone: 'local', // Use local timezone
        initialDate: new Date(), // Start with current date
        events: calendarEvents,
        
        // Enhanced event styling
        eventDisplay: 'block',
        eventTimeFormat: {
          hour: '2-digit',
          minute: '2-digit',
          meridiem: 'short'
        },
        
        // Custom event rendering
        eventDidMount: function(info) {
          console.log('Dashboard Event mounted:', info.event);
          const event = info.event;
          info.el.title = event.title + ' - ' + (event.extendedProps.description || 'No description');
          
          // Add click handler for event details
          info.el.addEventListener('click', function(e) {
            e.preventDefault();
            const isGroupRecurring = event.extendedProps.type === 'group_recurring';
            const isActivityGroup = event.extendedProps.type === 'activity_group';
            const isRideRequest = event.extendedProps.type === 'request' || event.extendedProps.type === 'child_request' || event.extendedProps.type === 'my_request';
            const instanceId = event.extendedProps.instance_id || event.extendedProps.instanceId || event.id;
            console.log('🔧 DASHBOARD DEBUG: Event ID:', event.id);
            console.log('🔧 DASHBOARD DEBUG: Instance ID:', instanceId);
            console.log('🔧 DASHBOARD DEBUG: Extended props:', event.extendedProps);
            
            // Get assignment button labels for group recurring events
            let dropoffBtnLabel = '';
            let pickupBtnLabel = '';
            let bothBtnLabel = '';
            if (isGroupRecurring) {
              dropoffBtnLabel = (event.extendedProps.dropoff_driver && event.extendedProps.dropoff_driver !== 'Unassigned')
                ? `Take Over Drop Off at ${event.title}`
                : `I can Drop Off at ${event.title}`;
              pickupBtnLabel = (event.extendedProps.pickup_driver && event.extendedProps.pickup_driver !== 'Unassigned')
                ? `Take Over Pick Up from ${event.title}`
                : `I can Pick Up from ${event.title}`;
              bothBtnLabel = ((event.extendedProps.dropoff_driver && event.extendedProps.dropoff_driver !== 'Unassigned') ||
                              (event.extendedProps.pickup_driver && event.extendedProps.pickup_driver !== 'Unassigned'))
                ? `Take Over Both`
                : `I can Do Both`;
            }

            // Get assignment button labels for activity groups
            if (isActivityGroup) {
              dropoffBtnLabel = (event.extendedProps.dropoff_driver && event.extendedProps.dropoff_driver !== 'Unassigned')
                ? `Take Over Drop Off at ${event.title}`
                : `I can Drop Off at ${event.title}`;
              pickupBtnLabel = (event.extendedProps.pickup_driver && event.extendedProps.pickup_driver !== 'Unassigned')
                ? `Take Over Pick Up from ${event.title}`
                : `I can Pick Up from ${event.title}`;
              bothBtnLabel = ((event.extendedProps.dropoff_driver && event.extendedProps.dropoff_driver !== 'Unassigned') ||
                              (event.extendedProps.pickup_driver && event.extendedProps.pickup_driver !== 'Unassigned'))
                ? `Take Over Both`
                : `I can Do Both`;
            }

            // Get status badge HTML for ride requests
            let statusBadge = '';
            if (isRideRequest) {
              const status = event.extendedProps.status || 'pending';
              let badgeClass = 'bg-secondary';
              let statusText = 'Unknown';
              if (status === 'pending' || status === 'Pending') {
                badgeClass = 'bg-warning text-dark';
                statusText = 'Pending';
              } else if (status === 'assigned' || status === 'Assigned') {
                badgeClass = 'bg-primary';
                statusText = 'Assigned';
              } else if (status === 'completed' || status === 'Completed') {
                badgeClass = 'bg-success';
                statusText = 'Completed';
              } else if (status === 'cancelled' || status === 'Cancelled') {
                badgeClass = 'bg-danger';
                statusText = 'Cancelled';
              }
              statusBadge = `<span class="badge ${badgeClass} mb-2">${statusText}</span>`;
            }

            const modalHTML = `
              <div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="eventModalLabel">
                        <i class="fas fa-calendar-event me-2"></i>${event.title}
                      </h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <div class="row">
                        <div class="col-12">
                          ${statusBadge}
                          <p class="text-muted mb-3">
                            <i class="fas fa-info-circle me-2"></i>
                            ${event.extendedProps.description || 'No description'}
                          </p>
                          <div class="alert alert-info">
                            <i class="fas fa-clock me-2"></i>
                            <strong>Time:</strong> ${event.start.toLocaleString('en-NZ', { 
                              weekday: 'long',
                              year: 'numeric', 
                              month: 'long', 
                              day: 'numeric',
                              hour: '2-digit', 
                              minute: '2-digit',
                              hour12: true 
                            })}
                            ${event.end ? `<br><i class="fas fa-stop-circle me-2"></i><strong>End:</strong> ${event.end.toLocaleString('en-NZ', { 
                              hour: '2-digit', 
                              minute: '2-digit',
                              hour12: true 
                            })}` : ''}
                          </div>
                          ${isRideRequest && event.extendedProps.driver_name ? `
                            <div class="alert alert-success mb-3">
                              <i class="fas fa-user me-2"></i>
                              <strong>Driver:</strong> ${event.extendedProps.driver_name}
                            </div>
                          ` : ''}
                          ${isGroupRecurring ? `
                            <div class="alert alert-secondary mb-3">
                              <strong>Dropoff:</strong> <span class="${event.extendedProps.dropoff_driver === 'Unassigned' ? 'text-danger' : 'text-success'}">
                                ${event.extendedProps.dropoff_driver || 'Unassigned'}
                              </span><br>
                              <strong>Pickup:</strong> <span class="${event.extendedProps.pickup_driver === 'Unassigned' ? 'text-danger' : 'text-success'}">
                                ${event.extendedProps.pickup_driver || 'Unassigned'}
                              </span>
                            </div>
                            <div class="mt-3">
                              <form method="POST" action="/event-instances/${instanceId}/assign-self-driver" style="display:inline;">
                                <input type="hidden" name="assignmentType" value="dropoff">
                                <button type="submit" class="btn btn-primary btn-sm me-2">${dropoffBtnLabel}</button>
                              </form>
                              <form method="POST" action="/event-instances/${instanceId}/assign-self-driver" style="display:inline;">
                                <input type="hidden" name="assignmentType" value="pickup">
                                <button type="submit" class="btn btn-success btn-sm me-2">${pickupBtnLabel}</button>
                              </form>
                              <form method="POST" action="/event-instances/${instanceId}/assign-self-driver" style="display:inline;">
                                <input type="hidden" name="assignmentType" value="both">
                                <button type="submit" class="btn btn-info btn-sm">${bothBtnLabel}</button>
                              </form>
                            </div>
                          ` : ''}
                          ${isActivityGroup ? `
                            <div class="alert alert-secondary mb-3">
                              <strong>Dropoff:</strong> <span class="${event.extendedProps.dropoff_driver === 'Unassigned' ? 'text-danger' : 'text-success'}">
                                ${event.extendedProps.dropoff_driver || 'Unassigned'}
                              </span><br>
                              <strong>Pickup:</strong> <span class="${event.extendedProps.pickup_driver === 'Unassigned' ? 'text-danger' : 'text-success'}">
                                ${event.extendedProps.pickup_driver || 'Unassigned'}
                              </span>
                            </div>
                            <div class="mt-3">
                              <form method="POST" action="/event-instances/${instanceId}/assign-self-driver" style="display:inline;">
                                <input type="hidden" name="assignmentType" value="dropoff">
                                <button type="submit" class="btn btn-primary btn-sm me-2">${dropoffBtnLabel}</button>
                              </form>
                              <form method="POST" action="/event-instances/${instanceId}/assign-self-driver" style="display:inline;">
                                <input type="hidden" name="assignmentType" value="pickup">
                                <button type="submit" class="btn btn-success btn-sm me-2">${pickupBtnLabel}</button>
                              </form>
                              <form method="POST" action="/event-instances/${instanceId}/assign-self-driver" style="display:inline;">
                                <input type="hidden" name="assignmentType" value="both">
                                <button type="submit" class="btn btn-info btn-sm">${bothBtnLabel}</button>
                              </form>
                            </div>
                          ` : ''}
                          ${isRideRequest ? `
                            <div class="mt-3">
                              <a href="/rides" class="btn btn-outline-primary btn-sm me-2">
                                <i class="fas fa-car me-1"></i>View Ride Details
                              </a>
                              <a href="/messages/group/ride/${event.id.replace(/^(ride_|child_ride_|my_ride_)/, '')}" class="btn btn-outline-info btn-sm">
                                <i class="fas fa-comments me-1"></i>Chat
                              </a>
                            </div>
                          ` : ''}
                        </div>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Close
                      </button>
                      <a href="/calendar" class="btn btn-primary">
                        <i class="fas fa-calendar-alt me-1"></i>View Full Calendar
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            `;
            const existingModal = document.getElementById('eventModal');
            if (existingModal) {
              existingModal.remove();
            }
            document.body.insertAdjacentHTML('beforeend', modalHTML);
            const modal = new bootstrap.Modal(document.getElementById('eventModal'));
            modal.show();
            document.getElementById('eventModal').addEventListener('hidden.bs.modal', function() {
              this.remove();
            });
          });
        },
        
        // Day cell rendering for highlighting
        dayCellDidMount: function(arg) {
          const date = arg.date;
          const dayOfWeek = date.getDay();
          
          // Add weekend styling
          if (dayOfWeek === 0 || dayOfWeek === 6) {
            arg.el.style.backgroundColor = '#f8f9fa';
            arg.el.style.fontWeight = 'bold';
          }
          
          // Add today highlighting
          const today = new Date();
          if (date.toDateString() === today.toDateString()) {
            arg.el.style.border = '2px solid #007bff';
            arg.el.style.borderRadius = '8px';
          }
        },
        
        // Loading state
        loading: function(isLoading) {
          console.log('Dashboard Calendar loading state:', isLoading);
        },
        
        // View-specific settings
        views: {
          dayGridMonth: {
            dayMaxEvents: 3, // Show max 3 events per day in sidebar
            moreLinkClick: 'popover'
          },
          timeGridWeek: {
            slotMinTime: '06:00:00',
            slotMaxTime: '22:00:00'
          },
          listWeek: {
            listDayFormat: { weekday: 'long', month: 'long', day: 'numeric' },
            listDaySideFormat: { weekday: 'long' }
          }
        },
        
        // Custom event colors based on type
        eventClassNames: function(arg) {
          const event = arg.event;
          const classes = [];
          
          // Add type-specific classes
          if (event.extendedProps.type === 'request') {
            classes.push('event-drive');
          } else if (event.extendedProps.type === 'child_request') {
            classes.push('event-ride');
          } else if (event.extendedProps.type === 'my_request') {
            classes.push('event-my-request');
          } else if (event.extendedProps.type === 'recurring') {
            classes.push('event-recurring');
          } else if (event.extendedProps.type === 'group_recurring') {
            classes.push('event-group-recurring');
          } else if (event.extendedProps.type === 'subscribed_recurring') {
            classes.push('event-subscribed-recurring');
          }
          
          return classes;
        },
        
        // After each view change, ensure the week containing today is at the top when in month view
        datesSet: function(info) {
          if (info.view.type === 'dayGridMonth') {
            setTimeout(() => {
              const scroller = calendarEl.querySelector('.fc-daygrid-body-scroller');
              const todayCell = calendarEl.querySelector('.fc-day-today');
              if (scroller && todayCell) {
                // The cell is a <td>; its parent is <tr>
                const weekRow = todayCell.closest('tr');
                if (weekRow) {
                  scroller.scrollTop = weekRow.offsetTop;
                }
              }
            }, 0);
          }
        }
      });
      
      console.log('Dashboard FullCalendar instance created:', calendar);
      
      // Render the calendar
      calendar.render();
      console.log('Dashboard FullCalendar rendered successfully');
      
      // Debug: Check if calendar is visible
      setTimeout(() => {
        const calendarContainer = calendarEl.querySelector('.fc');
        if (calendarContainer) {
          console.log('Dashboard Calendar DOM structure created:', calendarContainer);
          console.log('Dashboard Calendar dimensions:', {
            width: calendarContainer.offsetWidth,
            height: calendarContainer.offsetHeight,
            visible: calendarContainer.offsetWidth > 0 && calendarContainer.offsetHeight > 0
          });
          
          // Check for events in the DOM
          const eventElements = calendarContainer.querySelectorAll('.fc-event');
          console.log('Dashboard Event elements found in DOM:', eventElements.length);
          eventElements.forEach((el, index) => {
            console.log(`Dashboard Event element ${index}:`, el.textContent, el);
          });
        } else {
          console.warn('Dashboard Calendar DOM structure not found after render - calendar may not have loaded properly');
        }
      }, 100);
      
    } catch (error) {
      console.error('Error initializing Dashboard FullCalendar:', error);
      console.error('Error stack:', error.stack);
    }
  });
  </script>

  <!-- Initialize autocomplete only for input elements, not select elements -->
  <script>
  // Ensure autocomplete only applies to input elements, not select elements
  document.addEventListener('DOMContentLoaded', function() {
    // Only initialize autocomplete on input elements with the autocomplete class
    document.querySelectorAll('input.autocomplete').forEach(input => {
      const type = input.dataset.type || 'organization';
      
      if (typeof autoComplete !== 'undefined') {
        new autoComplete({
          selector: () => input,
          threshold: 1,
          debounce: 200,
          searchEngine: "loose",
          data: {
            src: async (query) => {
              try {
                const res = await fetch(`/organizations/autocomplete?term=${encodeURIComponent(query)}&type=${encodeURIComponent(type)}`);
                return await res.json();
              } catch (err) {
                console.error("Autocomplete fetch error", err);
                return [];
              }
            },
            keys: ["label"]
          },
          resultsList: {
            noResults: true,
            maxResults: 10,
            render: true
          },
          resultItem: {
            highlight: true,
            content: (data) => data.label
          },
          onSelection: (feedback) => {
            const selected = feedback.selection.value;
            input.value = selected.value || selected.label || "";
            input.dispatchEvent(new Event('input', { bubbles: true }));
          },
          events: {
            input: {
              selection: (event) => {
                const feedback = event.detail;
                const selected = feedback.selection.value;
                event.target.value = selected.value || selected.label || "";
                event.target.dispatchEvent(new Event('input', { bubbles: true }));
              }
            }
          }
        });
      }
    });
  });
  </script>

