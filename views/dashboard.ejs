<!--views/dashboard.ejs -->
<%- include('partials/header1') %>
<%- include('partials/navbar1') %>

<div class="container py-5">
  <% if (session.success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= session.success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <% session.success = null; %>
  <% } %>

  <h2 class="mb-4 fw-semibold">👋 Welcome, <%= session.userName %>!</h2>

  <!-- Home Address -->
  <div class="card mb-4 shadow-sm rounded-4">
    <div class="card-body">
      <h5 class="card-title fw-semibold">🏠 Your Home Address</h5>
      <form action="/update-address" method="POST" class="row g-2" onsubmit="return validateCoords();">
        <div class="col-md-8">
          <input type="text" name="home_address" id="homeAddress" class="form-control rounded-pill" value="<%= user.home_address || '' %>" required autocomplete="home">
        </div>
        <input type="hidden" name="home_lat" id="homeLat">
        <input type="hidden" name="home_lng" id="homeLng">
        <div class="col-md-4">
          <button type="submit" class="btn btn-success w-100 rounded-pill">📍 Save</button>
        </div>
      </form>
      <div id="map" class="mt-3 rounded shadow-sm" style="height: 300px;"></div>
    </div>
  </div>

  <!-- Children + Organizations in 2 columns -->
  <div class="row">
    <!-- 👶 Your Children -->
    <div class="col-md-8 mb-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <h5 class="card-title mb-3">👶 Your Children</h5>

          <% if (children.length > 0) { %>
            <h5 class="card-title mb-3">👨‍👩‍👧‍👦 My Family / Whānau</h5>
            <ul class="list-group mb-4">
              <% children.forEach(child => { %>
                <li class="list-group-item">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <strong><%= child.name %></strong> – <%= child.school %>
                      <% if (child.club) { %> | Club: <%= child.club %> <% } %>
                      <% if (child.parents && child.parents.length > 0) { %>
                        <br>
                        <small class="text-muted">
                          Parents: <%= child.parents.map(p => p.name + ' (' + p.email + ')').join(', ') %>
                        </small>
                      <% } %>
                    </div>
                    <div>
                      <button class="btn btn-sm btn-outline-secondary me-2" data-bs-toggle="collapse" data-bs-target="#editForm<%= child.id %>">✏️</button>
                      <a href="/delete-child/<%= child.id %>" class="btn btn-sm btn-outline-danger">🗑</a>
                    </div>
                  </div>
                  <div class="collapse mt-2" id="editForm<%= child.id %>">
                    <form action="/edit-child/<%= child.id %>" method="POST" class="row g-2">
                      <div class="col-md-4">
                        <input type="text" name="name" value="<%= child.name %>" class="form-control rounded-pill" required autocomplete="name">
                      </div>
                      <div class="col-md-4">
                        <input name="school" type="text" class="form-control mb-2 autocomplete" data-type="school" placeholder="School Name" required autocomplete="off" value="<%= child.school %>">
                      </div>
                      <div class="col-md-3">
                        <input type="text" name="club" class="form-control autocomplete rounded-pill" data-type="club" placeholder="Club" autocomplete="off" value="<%= child.club %>">
                      </div>
                      <div class="col-md-1">
                        <button type="submit" class="btn btn-primary w-100">💾</button>
                      </div>
                    </form>
                  </div>
                  <% if (child.parents && child.parents.some(p => p.id === session.userId)) { %>
                    <form action="/children/<%= child.id %>/invite-parent" method="POST" class="row g-2 mt-2">
                      <div class="col">
                        <input type="text" name="invite_email_or_username" class="form-control" placeholder="Invite/link parent by email or username" required>
                      </div>
                      <div class="col-auto">
                        <button type="submit" class="btn btn-outline-primary btn-sm">Add Parent</button>
                      </div>
                    </form>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="text-muted">No children registered yet.</p>
          <% } %>

          <form action="/add-child" method="POST" class="row g-2 mt-2 align-items-end">
            <div class="col-md-6">
              <label class="form-label">Child's Name</label>
              <input type="text" name="name" class="form-control rounded-pill" placeholder="Child's Name" required autocomplete="name">
            </div>
            <div class="col-md-6">
              <label class="form-label">School</label>
              <input name="school" type="text" class="form-control rounded-pill autocomplete" data-type="school" placeholder="School Name" required autocomplete="off">
            </div>
            <div class="col-md-6">
              <label class="form-label">Username</label>
              <input type="text" name="child_username" class="form-control rounded-pill" placeholder="Username" autocomplete="username">
            </div>
            <div class="col-md-6">
              <label class="form-label">Password</label>
              <input type="password" name="child_password" class="form-control rounded-pill" placeholder="Password" autocomplete="new-password">
            </div>
            <!-- Add button below all fields -->
            <div class="col-12 mt-3">
              <button type="submit" class="btn btn-success w-100">Add</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- 🏫 Organizations Management -->
    <div class="col-md-4 mb-4">
      <div class="card shadow-sm h-100">
        <div class="card-body d-flex flex-column">
          <h5 class="card-title">🏫 Schools & Clubs</h5>
          
          <div class="text-center py-4">
            <div class="mb-3">
              <i class="fas fa-school fa-3x text-primary"></i>
            </div>
            <h6 class="text-muted mb-3">Manage your schools and clubs</h6>
            <p class="text-muted small mb-4">
              Add, edit, and organize all the schools, clubs, and events your children attend.
            </p>
            <a href="/organizations" class="btn btn-primary w-100">🏫 Manage Organizations</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function validateCoords() {
      const lat = document.getElementById('homeLat').value;
      const lng = document.getElementById('homeLng').value;
      if (!lat || !lng) {
        alert("Please select an address from the suggestions.");
        return false;
      }
      return true;
    }

    function initMap() {
      const userLoc = {
        lat: <%= user.home_lat || -36.8485 %>,
        lng: <%= user.home_lng || 174.7633 %>
      };
      const map = new google.maps.Map(document.getElementById('map'), {
        center: userLoc,
        zoom: 12
      });
      new google.maps.Marker({ position: userLoc, map, title: "Your Home" });

      <% neighbors.forEach(n => { %>
        new google.maps.Marker({
          position: { lat: <%= n.home_lat %>, lng: <%= n.home_lng %> },
          map,
          title: "<%= n.name %>"
        });
      <% }); %>

      const autocomplete = new google.maps.places.Autocomplete(document.getElementById('homeAddress'));
      autocomplete.addListener('place_changed', function () {
        const place = autocomplete.getPlace();
        if (place.geometry) {
          document.getElementById('homeLat').value = place.geometry.location.lat();
          document.getElementById('homeLng').value = place.geometry.location.lng();
        }
      });
    }

    // Modern autocomplete for school and club using AutoComplete.js
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.autocomplete').forEach(input => {
        const type = input.dataset.type || 'organization';
        new autoComplete({
          selector: () => input,
          threshold: 1,
          debounce: 200,
          searchEngine: "loose",
          data: {
            src: async (query) => {
              try {
                const res = await fetch(`/organizations/autocomplete?term=${encodeURIComponent(query)}&type=${encodeURIComponent(type)}`);
                return await res.json();
              } catch (err) {
                console.error("Autocomplete fetch error", err);
                return [];
              }
            },
            keys: ["label"]
          },
          resultsList: {
            noResults: true,
            maxResults: 10,
            render: true
          },
          resultItem: {
            highlight: true,
            content: (data) => data.label
          },
          onSelection: (feedback) => {
            const selected = feedback.selection.value;
            input.value = selected.value || selected.label || "";
            input.dispatchEvent(new Event('input', { bubbles: true }));
          },
          events: {
            input: {
              selection: (event) => {
                const feedback = event.detail;
                const selected = feedback.selection.value;
                event.target.value = selected.value || selected.label || "";
                event.target.dispatchEvent(new Event('input', { bubbles: true }));
              }
            }
          }
        });
      });
    });
  </script>

  <script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= GMAPS_API_KEY %>&libraries=places&callback=initMap"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <!-- Remove bootstrap-autocomplete for school/club fields -->
  <!--<script src="https://cdn.jsdelivr.net/npm/bootstrap-autocomplete@1.0.7/dist/bootstrap-autocomplete.min.js"></script>-->

<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tarekraafat/autocomplete.js@10.2.7/dist/css/autoComplete.min.css">
<script src="https://cdn.jsdelivr.net/npm/@tarekraafat/autocomplete.js@10.2.7/dist/autoComplete.min.js"></script>

<script>

  </script>
  <%- include('partials/footer1') %>