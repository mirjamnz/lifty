<!--views/dashboard.ejs -->
<%- include('partials/header1') %>
<%- include('partials/navbar1') %>

<div class="container py-5">
  <div class="row">
    <div class="col-md-8">
      <h2>Welcome back, <%= session.userName %>! 👋</h2>
      
      <% if (success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- Group Invitations Section -->
      <% if (groupInvitations && groupInvitations.length > 0) { %>
        <div class="card mb-4 border-warning">
          <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
              <i class="fas fa-envelope me-2"></i>
              Group Invitations (<%= groupInvitations.length %>)
            </h5>
          </div>
          <div class="card-body">
            <% groupInvitations.forEach(invitation => { %>
              <div class="card mb-3 border-warning">
                <div class="card-body">
                  <h6 class="card-title">
                    <i class="fas fa-users me-2"></i>
                    <%= invitation.event_name %>
                  </h6>
                  <p class="card-text">
                    <small class="text-muted">
                      <i class="fas fa-calendar me-1"></i>
                      <%= invitation.day_of_week %>s, <%= invitation.start_time %> - <%= invitation.end_time %>
                    </small>
                    <br>
                    <small class="text-muted">
                      <i class="fas fa-map-marker-alt me-1"></i>
                      <%= invitation.location %>
                    </small>
                    <br>
                    <small class="text-muted">
                      <i class="fas fa-user me-1"></i>
                      Invited by <%= invitation.inviter_name %>
                    </small>
                    <br>
                    <small class="text-muted">
                      <i class="fas fa-clock me-1"></i>
                      Invited <%= new Date(invitation.invited_at).toLocaleDateString() %>
                    </small>
                  </p>
                  <div class="d-flex gap-2">
                    <form method="POST" action="/recurring-events/<%= invitation.event_id %>/join" style="display: inline;">
                      <button type="submit" class="btn btn-success btn-sm">
                        <i class="fas fa-check me-1"></i>Accept Invitation
                      </button>
                    </form>
                    <form method="POST" action="/recurring-events/<%= invitation.event_id %>/decline-invitation" style="display: inline;">
                      <input type="hidden" name="invitation_id" value="<%= invitation.id %>">
                      <button type="submit" class="btn btn-outline-danger btn-sm" 
                              onclick="return confirm('Are you sure you want to decline this invitation?')">
                        <i class="fas fa-times me-1"></i>Decline
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Home Address Section -->
      <div class="card mb-4">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0">
            <i class="fas fa-home me-2"></i>
            Home Address
          </h5>
        </div>
        <div class="card-body">
          <% if (user && user.home_address) { %>
            <div class="row">
              <div class="col-md-8">
                <p class="mb-2">
                  <strong>Current Address:</strong> <%= user.home_address %>
                </p>
                <small class="text-muted">
                  <i class="fas fa-map-marker-alt me-1"></i>
                  Coordinates: <%= user.home_lat %>, <%= user.home_lng %>
                </small>
              </div>
              <div class="col-md-4 text-end">
                <button class="btn btn-outline-primary btn-sm" 
                        data-bs-toggle="collapse" 
                        data-bs-target="#addressForm">
                  <i class="fas fa-edit me-1"></i>Update Address
                </button>
              </div>
            </div>
          <% } else { %>
            <p class="text-muted mb-3">No home address set. Please add your address to help with ride coordination.</p>
          <% } %>
          
          <div class="collapse <%= !user || !user.home_address ? 'show' : '' %>" id="addressForm">
            <form action="/update-address" method="POST" class="mt-3">
              <div class="row g-2">
                <div class="col-md-8">
                  <input type="text" name="home_address" id="home_address" class="form-control" 
                         placeholder="Enter your home address" required
                         value="<%= user && user.home_address ? user.home_address : '' %>">
                </div>
                <div class="col-md-4">
                  <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-save me-1"></i>Save Address
                  </button>
                </div>
              </div>
              <input type="hidden" name="home_lat" id="home_lat" value="<%= user && user.home_lat ? user.home_lat : '' %>">
              <input type="hidden" name="home_lng" id="home_lng" value="<%= user && user.home_lng ? user.home_lng : '' %>">
            </form>
          </div>
        </div>
      </div>

      <!-- Your Children Section -->
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">
            <i class="fas fa-child me-2"></i>
            Your Children (<%= children.length %>)
          </h5>
        </div>
        <div class="card-body">
          <% if (children && children.length > 0) { %>
            <ul class="list-group list-group-flush">
              <% children.forEach(child => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                  <div class="flex-grow-1">
                    <h6 class="mb-1"><%= child.name %></h6>
                    <small class="text-muted">
                      <i class="fas fa-graduation-cap me-1"></i><%= child.school %>
                      <% if (child.club) { %>
                        <br><i class="fas fa-users me-1"></i><%= child.club %>
                      <% } %>
                      <% if (child.parents && child.parents.length > 1) { %>
                        <br><i class="fas fa-users me-1"></i>Linked parents: <%= child.parents.map(p => p.name).join(', ') %>
                      <% } %>
                    </small>
                  </div>
                  <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary btn-sm" 
                            data-bs-toggle="collapse" 
                            data-bs-target="#editForm<%= child.id %>">
                      <i class="fas fa-edit"></i>
                    </button>
                  </div>
                  <div class="collapse mt-2" id="editForm<%= child.id %>">
                    <form action="/edit-child/<%= child.id %>" method="POST" class="row g-2">
                      <div class="col-md-4">
                        <input type="text" name="name" value="<%= child.name %>" class="form-control rounded-pill" required autocomplete="name">
                      </div>
                      <div class="col-md-4">
                        <input name="school" type="text" class="form-control mb-2 autocomplete" data-type="school" placeholder="School Name" required autocomplete="off" value="<%= child.school %>">
                      </div>
                      <div class="col-md-3">
                        <input type="text" name="club" class="form-control autocomplete rounded-pill" data-type="club" placeholder="Club" autocomplete="off" value="<%= child.club %>">
                      </div>
                      <div class="col-md-1">
                        <button type="submit" class="btn btn-primary w-100">💾</button>
                      </div>
                    </form>
                  </div>
                  <% if (child.parents && child.parents.some(p => p.id === session.userId)) { %>
                    <form action="/children/<%= child.id %>/invite-parent" method="POST" class="row g-2 mt-2">
                      <div class="col">
                        <input type="text" name="invite_email_or_username" class="form-control" placeholder="Invite/link parent by email or username" required>
                      </div>
                      <div class="col-auto">
                        <button type="submit" class="btn btn-outline-primary btn-sm">Add Parent</button>
                      </div>
                    </form>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="text-muted">No children registered yet.</p>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <!-- Add Child Section -->
      <div class="card">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0">
            <i class="fas fa-plus me-2"></i>
            Add Child
          </h5>
        </div>
        <div class="card-body">
          <form action="/add-child" method="POST">
            <div class="row g-2">
              <div class="col-md-6">
                <input type="text" name="name" class="form-control" placeholder="Child's Name" required autocomplete="name">
              </div>
              <div class="col-md-6">
                <input name="school" type="text" class="form-control autocomplete" data-type="school" placeholder="School Name" required autocomplete="off">
              </div>
            </div>
            <div class="row g-2 mt-2">
              <div class="col-md-6">
                <input type="text" name="club" class="form-control autocomplete" data-type="club" placeholder="Club (Optional)" autocomplete="off">
              </div>
              <div class="col-md-6">
                <button type="submit" class="btn btn-success w-100">Add</button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Community Map Section -->
      <% if (neighbors && neighbors.length > 0) { %>
        <div class="card mt-3">
          <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
              <i class="fas fa-map me-2"></i>
              Community Map (<%= neighbors.length %> neighbors)
            </h5>
          </div>
          <div class="card-body">
            <div id="map" style="height: 300px; width: 100%; border-radius: 8px; border: 1px solid #ddd; background-color: #f8f9fa;"></div>
            <div class="mt-3">
              <small class="text-muted">
                <i class="fas fa-info-circle me-1"></i>
                Showing other registered users in your area
              </small>
              <div id="map-debug" class="mt-2 small text-muted"></div>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="card mt-3">
          <div class="card-header bg-light text-muted">
            <h5 class="mb-0">
              <i class="fas fa-map me-2"></i>
              Community Map
            </h5>
          </div>
          <div class="card-body text-center">
            <p class="text-muted mb-0">
              <i class="fas fa-info-circle me-1"></i>
              No other users with addresses found yet
            </p>
          </div>
        </div>
      <% } %>

      <!-- Quick Actions -->
      <div class="card mt-3">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0">
            <i class="fas fa-bolt me-2"></i>
            Quick Actions
          </h5>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            <a href="/rides" class="btn btn-outline-primary">
              <i class="fas fa-car me-2"></i>View Rides
            </a>
            <a href="/recurring-events" class="btn btn-outline-success">
              <i class="fas fa-calendar me-2"></i>Recurring Events
            </a>
            <a href="/messages/all" class="btn btn-outline-info">
              <i class="fas fa-envelope me-2"></i>Messages
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// School/club autocomplete (not Google Maps)
document.addEventListener('DOMContentLoaded', function() {
  const autocompleteInputs = document.querySelectorAll('.autocomplete');
  autocompleteInputs.forEach(input => {
    const type = input.dataset.type;
    new autoComplete({
      selector: () => input,
      threshold: 1,
      debounce: 200,
      searchEngine: "loose",
      data: {
        src: async (query) => {
          try {
            const res = await fetch(`/organizations/autocomplete?term=${encodeURIComponent(query)}&type=${encodeURIComponent(type)}`);
            return await res.json();
          } catch (err) {
            console.error("Autocomplete fetch error", err);
            return [];
          }
        },
        keys: ["label"]
      },
      resultsList: {
        noResults: true,
        maxResults: 10,
        render: true
      },
      resultItem: {
        highlight: true,
        content: (data) => data.label
      },
      onSelection: (feedback) => {
        const selected = feedback.selection.value;
        input.value = selected.value || selected.label || "";
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
    });
  });
});

// Google Maps/Places callback for address autocomplete and map
function initLiftyMaps() {
  // Home address autocomplete
  var homeAddressInput = document.getElementById('home_address');
  if (homeAddressInput && typeof google !== 'undefined' && google.maps) {
    var autocomplete = new google.maps.places.Autocomplete(homeAddressInput);
    autocomplete.addListener('place_changed', function() {
      var place = autocomplete.getPlace();
      if (place.geometry) {
        document.getElementById('home_lat').value = place.geometry.location.lat();
        document.getElementById('home_lng').value = place.geometry.location.lng();
      }
    });
  }

  // Community map
  var mapElement = document.getElementById('map');
  if (mapElement && typeof google !== 'undefined' && google.maps) {
    var userLat = <%- user && user.home_lat ? user.home_lat : 'null' %>;
    var userLng = <%- user && user.home_lng ? user.home_lng : 'null' %>;
    var neighbors = <%- JSON.stringify(neighbors || []) %>;
    var map = new google.maps.Map(mapElement, {
      zoom: 12,
      center: userLat && userLng ? { lat: parseFloat(userLat), lng: parseFloat(userLng) } : { lat: -36.8485, lng: 174.7633 }
    });
    if (userLat && userLng) {
      new google.maps.Marker({
        position: { lat: parseFloat(userLat), lng: parseFloat(userLng) },
        map: map,
        title: 'Your Location',
        icon: { url: 'http://maps.google.com/mapfiles/ms/icons/blue-dot.png' }
      });
    }
    neighbors.forEach(function(neighbor) {
      if (neighbor.home_lat && neighbor.home_lng) {
        var marker = new google.maps.Marker({
          position: { lat: parseFloat(neighbor.home_lat), lng: parseFloat(neighbor.home_lng) },
          map: map,
          title: neighbor.name,
          icon: { url: 'http://maps.google.com/mapfiles/ms/icons/red-dot.png' }
        });
        var infowindow = new google.maps.InfoWindow({
          content: '<div><strong>' + neighbor.name + '</strong><br>' + neighbor.home_address + '</div>'
        });
        marker.addListener('click', function() {
          infowindow.open(map, marker);
        });
      }
    });
  }
}
</script>

<!-- Google Maps API: only load ONCE, with callback -->
<script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= GMAPS_API_KEY %>&libraries=places&callback=initLiftyMaps"></script>

<%- include('partials/footer1') %>