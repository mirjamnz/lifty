<!--views/short-notice-detail.ejs -->
<%- include('partials/header1') %>
<%- include('partials/navbar1') %>

<div class="container mt-4">
  <!-- Back Button -->
  <div class="row mb-3">
    <div class="col">
      <a href="/short-notice" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Requests
      </a>
    </div>
  </div>

  <!-- Request Details -->
  <div class="row mb-4">
    <div class="col">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">
            <i class="fas fa-clock me-2"></i>Request Details
          </h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <h6><i class="fas fa-users me-1"></i>Group: <%= request.group_name %></h6>
              <p class="text-muted">From: <strong><%= request.requester_name %></strong></p>
            </div>
            <div class="col-md-6">
              <h6><i class="fas fa-calendar me-1"></i>Date: <%= new Date(request.pickup_time).toLocaleDateString() %></h6>
              <p class="text-muted">Status: <span class="badge bg-<%= request.status === 'pending' ? 'warning' : request.status === 'accepted' ? 'success' : 'danger' %>"><%= request.status.charAt(0).toUpperCase() + request.status.slice(1) %></span></p>
            </div>
          </div>
          
          <div class="row mt-3">
            <div class="col-md-6">
              <h6><i class="fas fa-map-marker-alt me-1"></i>Pickup</h6>
              <p class="text-muted">
                <strong>Time:</strong> <%= new Date(request.pickup_time).toLocaleTimeString() %><br>
                <strong>Location:</strong> <%= request.pickup_location %>
              </p>
            </div>
            <div class="col-md-6">
              <h6><i class="fas fa-map-marker-alt me-1"></i>Dropoff</h6>
              <p class="text-muted">
                <strong>Time:</strong> <%= new Date(request.dropoff_time).toLocaleTimeString() %><br>
                <strong>Location:</strong> <%= request.dropoff_location %>
              </p>
            </div>
          </div>
          
          <% if (request.message) { %>
            <div class="row mt-3">
              <div class="col">
                <h6><i class="fas fa-comment me-1"></i>Message</h6>
                <p class="text-muted"><%= request.message %></p>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Response Section -->
  <% if (!userResponse && request.status === 'pending') { %>
    <div class="row mb-4">
      <div class="col">
        <div class="card border-warning">
          <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
              <i class="fas fa-reply me-2"></i>Respond to Request
            </h5>
          </div>
          <div class="card-body">
            <form action="/short-notice/<%= request.id %>/respond" method="POST">
              <div class="row">
                <div class="col-md-4 mb-3">
                  <button type="submit" name="response_type" value="ok" class="btn btn-success btn-lg w-100">
                    <i class="fas fa-check me-2"></i>OK
                  </button>
                </div>
                <div class="col-md-4 mb-3">
                  <button type="submit" name="response_type" value="ok_with_message" class="btn btn-info btn-lg w-100" onclick="showMessageInput()">
                    <i class="fas fa-comment me-2"></i>OK + Message
                  </button>
                </div>
                <div class="col-md-4 mb-3">
                  <button type="submit" name="response_type" value="decline" class="btn btn-danger btn-lg w-100">
                    <i class="fas fa-times me-2"></i>Decline
                  </button>
                </div>
              </div>
              
              <div id="messageInput" class="mt-3" style="display: none;">
                <div class="mb-3">
                  <label for="responseMessage" class="form-label">Add a message (optional)</label>
                  <textarea class="form-control" id="responseMessage" name="message" rows="3" placeholder="Add any additional details..."></textarea>
                </div>
                <button type="submit" name="response_type" value="ok_with_message" class="btn btn-info">
                  <i class="fas fa-paper-plane me-1"></i>Send Response
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% } else if (userResponse) { %>
    <div class="row mb-4">
      <div class="col">
        <div class="card border-info">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0">
              <i class="fas fa-check-circle me-2"></i>Your Response
            </h5>
          </div>
          <div class="card-body">
            <div class="d-flex align-items-center">
              <span class="badge bg-<%= userResponse.response_type === 'ok' ? 'success' : userResponse.response_type === 'ok_with_message' ? 'info' : 'danger' %> me-3">
                <%= userResponse.response_type === 'ok' ? 'OK' : userResponse.response_type === 'ok_with_message' ? 'OK + Message' : 'Declined' %>
              </span>
              <span class="text-muted">
                Responded on <%= new Date(userResponse.responded_at).toLocaleString() %>
              </span>
            </div>
            <% if (userResponse.message) { %>
              <p class="mt-2 mb-0"><%= userResponse.message %></p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Responses from Others -->
  <div class="row mb-4">
    <div class="col">
      <div class="card">
        <div class="card-header bg-secondary text-white">
          <h5 class="mb-0">
            <i class="fas fa-users me-2"></i>Responses from Group Members (<%= responses.length %>)
          </h5>
        </div>
        <div class="card-body">
          <% if (responses.length === 0) { %>
            <div class="text-center py-4">
              <i class="fas fa-users fa-3x text-muted mb-3"></i>
              <p class="text-muted">No responses yet.</p>
            </div>
          <% } else { %>
            <div class="row">
              <% responses.forEach(response => { %>
                <div class="col-md-6 col-lg-4 mb-3">
                  <div class="card h-100">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="card-title mb-0"><%= response.responder_name %></h6>
                        <span class="badge bg-<%= response.response_type === 'ok' ? 'success' : response.response_type === 'ok_with_message' ? 'info' : 'danger' %>">
                          <%= response.response_type === 'ok' ? 'OK' : response.response_type === 'ok_with_message' ? 'OK + Message' : 'Declined' %>
                        </span>
                      </div>
                      <small class="text-muted">
                        <%= new Date(response.responded_at).toLocaleString() %>
                      </small>
                      <% if (response.message) { %>
                        <p class="card-text mt-2 mb-0"><%= response.message %></p>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function showMessageInput() {
  event.preventDefault();
  document.getElementById('messageInput').style.display = 'block';
}
</script>

<%- include('partials/footer1') %> 