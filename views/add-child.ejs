<!--views/add-child.ejs -->
<%- include('partials/header1') %>
<%- include('partials/navbar1') %>

<!-- Main Content -->
<div class="container py-5">
  <h2 class="mb-4">👧 Add a Child or 🏫 Organizations</h2>
 
<% if (session.success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= session.success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <% session.success = null; %>
<% } %>

<h5>👶 Add a New Child</h5>
<form action="/dashboard/add-child" method="POST">
  <div class="mb-2">
    <input type="text" name="child_name" class="form-control" placeholder="Child's name" required>
  </div>
  <div class="mb-2">
    <input type="text" name="child_email" class="form-control" placeholder="Login email for child" required>
  </div>
  <div class="mb-2">
    <input type="password" name="child_password" class="form-control" placeholder="Password for child" required>
  </div>
  <div class="mb-2">
    <input type="text" name="school" class="form-control" placeholder="School">
  </div>
  <div class="mb-2">
    <input type="text" name="club" class="form-control" placeholder="Club">
  </div>
  <button class="btn btn-primary">Add Child</button>
</form>


    <!-- Add Organizations via Button -->
    <p class="mt-2">
  Can't find your school/club/event?
  <a href="/organizations/add" class="btn btn-sm btn-outline-primary">Add New</a>
</p>
    <!-- Hidden User ID Field -->
    <input type="hidden" name="user_id" value="<%= session.userId %>">

    <div class="mb-3">
      <label for="name" class="form-label">Child Name</label>
      <input type="text" name="name" id="name" class="form-control" required>
    </div>
    <div class="mb-3">
      <label for="schoolInput" class="form-label">School</label>
      <div class="input-group">
        <span class="input-group-text"><i class="fas fa-school"></i></span>
        <input type="text" class="form-control autocomplete" name="school" data-type="school" id="schoolInput" placeholder="Start typing school name..." required>
      </div>
    </div>
    <div class="mb-3">
      <label for="club" class="form-label">Club (optional)</label>
      <input type="text" name="club" id="club" class="form-control">
    </div>
    <button type="submit" class="btn btn-primary">Add Child</button>
  </form>
</div>
<form action="/add-child" method="POST" class="row g-3">
  <div class="col-md-6">
    <label for="childName">Child Name</label>
    <input type="text" name="name" id="childName" class="form-control" required>
  </div>

  <div class="col-md-6">
    <label for="school">School</label>
    <input type="text" class="form-control autocomplete" name="school" data-type="school" id="schoolInput" required>
  </div>

  <div class="col-md-6">
    <label for="club">Club (optional)</label>
    <input type="text" class="form-control autocomplete" name="club" data-type="club" id="clubInput">
  </div>

  <div class="col-md-12">
    <button type="submit" class="btn btn-primary">➕ Add Child</button>
  </div>
</form>


<script src="https://cdn.jsdelivr.net/npm/@tarekraafat/autocomplete.js@10.2.7/dist/autoComplete.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const input = document.getElementById('schoolInput');
    if (input) {
      new autoComplete({
        selector: () => input,
        threshold: 1,
        debounce: 200,
        searchEngine: "loose",
        data: {
          src: async (query) => {
            try {
              const res = await fetch(`/organizations/autocomplete?term=${encodeURIComponent(query)}&type=school`);
              return await res.json();
            } catch (err) {
              console.error("Autocomplete fetch error", err);
              return [];
            }
          },
          keys: ["label"]
        },
        resultsList: {
          noResults: true,
          maxResults: 10,
          render: true
        },
        resultItem: {
          highlight: true,
          content: (data) => data.label
        },
        onSelection: (feedback) => {
          const selected = feedback.selection.value;
          input.value = selected.value || selected.label || "";
          input.dispatchEvent(new Event('input', { bubbles: true }));
        },
        events: {
          input: {
            selection: (event) => {
              const feedback = event.detail;
              const selected = feedback.selection.value;
              event.target.value = selected.value || selected.label || "";
              event.target.dispatchEvent(new Event('input', { bubbles: true }));
            }
          }
        }
      });
    }
  });
</script>


<%- include('partials/footer1') %>
